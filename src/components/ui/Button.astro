---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  [key: string]: unknown;
}

const { variant = 'primary', size = 'md', href, class: className = '', ...rest } = Astro.props;

const baseClasses = 'inline-flex items-center justify-center font-heading font-semibold rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2';

const variants = {
  primary: 'bg-wrc-green-700 text-white hover:bg-wrc-green-800 focus:ring-wrc-green-500',
  secondary: 'bg-wrc-earth-500 text-white hover:bg-wrc-earth-600 focus:ring-wrc-earth-400',
  outline: 'border-2 border-wrc-green-700 text-wrc-green-700 hover:bg-wrc-green-50 focus:ring-wrc-green-500',
};

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};

const classes = `${baseClasses} ${variants[variant]} ${sizes[size]} ${className}`;
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button class={classes} {...rest}>
    <slot />
  </button>
)}
