---
import { getLocaleFromUrl, t } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);

const activities = [
  { titleKey: 'about.activities.plenary', descKey: 'about.activities.plenaryDesc', icon: '🎤', hex: '#15803d', image: 'Plenary Talks.jpg' },
  { titleKey: 'about.activities.workshops', descKey: 'about.activities.workshopsDesc', icon: '🔬', hex: '#1d4ed8', image: 'Concurrent Workshops.jpg' },
  { titleKey: 'about.activities.discussions', descKey: 'about.activities.discussionsDesc', icon: '💬', hex: '#92400e', image: 'Open Discussions.jpg' },
  { titleKey: 'about.activities.cultural', descKey: 'about.activities.culturalDesc', icon: '🎭', hex: '#047857', image: 'Cultural Nights.jpg' },
  { titleKey: 'about.activities.fieldTrips', descKey: 'about.activities.fieldTripsDesc', icon: '🌿', hex: '#166534', image: 'Field Trips.jpg' },
];
---

<!-- Congress Activities: Easter eggs left column + Zigzag cards right -->
<section class="py-16 md:py-20 bg-white relative overflow-hidden">
  <!-- Decorative map image on left edge -->
  <img src="/images/home/8-iguazu-map.png" alt="" class="absolute left-0 top-0 h-full w-auto object-cover object-left opacity-20 pointer-events-none" aria-hidden="true" />


  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-wrc-green-900 mb-16">
      {t('about.activities.title', locale)}
    </h2>

    <div>
      <!-- Zigzag activity cards -->
      <div class="max-w-3xl mx-auto">
        <!-- Vertical timeline line (visible on md+) -->
        <div class="relative">
          <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-wrc-green-200 via-wrc-green-300 to-wrc-green-200" aria-hidden="true"></div>

          <div class="space-y-8 md:space-y-12">
            {activities.map((activity, index) => (
              <div class:list={[
                'relative flex flex-col md:flex-row items-center gap-4 md:gap-8',
                index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'
              ]}>
                <!-- Timeline dot -->
                <div class="hidden md:flex absolute left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-white border-4 border-wrc-green-500 items-center justify-center z-10 shadow-md">
                  <span class="text-lg" aria-hidden="true">{activity.icon}</span>
                </div>

                <!-- Spacer for timeline alignment -->
                <div class="hidden md:block w-[calc(50%-2rem)]"></div>

                <!-- Card: image background + blurred overlay for title/description -->
                <div class:list={[
                  'w-full md:w-[calc(50%-2rem)] group',
                  index % 2 === 0 ? 'md:text-left' : 'md:text-right'
                ]}>
                  <div class="rounded-xl shadow-lg overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative min-h-[180px] aspect-[4/3] sm:aspect-auto sm:min-h-[220px]">
                    <img src={`/images/congress-introduction/${encodeURIComponent(activity.image)}`} alt="" class="absolute inset-0 w-full h-full object-cover" />
                    <!-- Gradient from bottom for text visibility -->
                    <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/85 via-black/50 to-transparent text-white">
                      <h3 class="font-heading font-bold text-base text-white mb-1.5">
                        {t(activity.titleKey, locale)}
                      </h3>
                      <p class="text-xs text-white/90 leading-relaxed">
                        {t(activity.descKey, locale)}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
