---
import SectionDivider from '../global/SectionDivider.astro';
import { ORGANIZERS } from '../../utils/constants';
import { getLocaleFromUrl, t } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);

const activities = [
  { titleKey: 'about.activities.plenary', descKey: 'about.activities.plenaryDesc', icon: '🎤' },
  { titleKey: 'about.activities.workshops', descKey: 'about.activities.workshopsDesc', icon: '🔬' },
  { titleKey: 'about.activities.discussions', descKey: 'about.activities.discussionsDesc', icon: '💬' },
  { titleKey: 'about.activities.cultural', descKey: 'about.activities.culturalDesc', icon: '🎭' },
  { titleKey: 'about.activities.fieldTrips', descKey: 'about.activities.fieldTripsDesc', icon: '🌿' },
];
---

<!-- Scroll 3: Organizers, Activities & Theme -->
<section class="py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Organizers -->
    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-16">
      {Object.values(ORGANIZERS).map((org) => (
        <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100">
          <div class="w-14 h-14 rounded-lg bg-wrc-green-100 flex items-center justify-center mb-4">
            <span class="text-wrc-green-700 font-heading font-bold text-sm">{org.shortName}</span>
          </div>
          <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">{org.name}</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-3">{org.description}</p>
          <a href={org.website} class="text-sm text-wrc-green-700 font-semibold hover:underline" target="_blank" rel="noopener">
            {t('common.visitWebsite', locale)} &rarr;
          </a>
        </div>
      ))}
    </div>


    <!-- Congress Activities -->
    <div class="mt-16">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        {t('about.activities.title', locale)}
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {activities.map((activity) => (
          <div class="group bg-white rounded-xl shadow-md p-6 border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <span class="text-3xl mb-3 block" aria-hidden="true">{activity.icon}</span>
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">{t(activity.titleKey, locale)}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{t(activity.descKey, locale)}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Theme Summary -->
    <div class="mt-16 bg-wrc-green-50 rounded-2xl p-8 md:p-10 max-w-3xl mx-auto text-center">
      <h3 class="text-xl font-heading font-bold text-wrc-green-900 mb-3">{t('about.theme.title', locale)}</h3>
      <p class="text-lg text-wrc-green-800 font-heading italic">
        "{t('about.theme.quote', locale)}"
      </p>
      <p class="mt-4 text-gray-600 text-sm leading-relaxed">
        {t('about.theme.description', locale)}
      </p>
    </div>
  </div>
</section>
