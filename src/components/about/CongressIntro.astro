---
import Button from '../ui/Button.astro';
import { getLocaleFromUrl, t } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;
---

<!-- Scroll 1: Congress Introduction -->
<section class="relative">
  <!-- Hero -->
  <div class="relative h-[350px] sm:h-[400px] bg-gradient-to-r from-wrc-green-900/90 to-wrc-green-800/70">
    <div class="absolute inset-0 opacity-10">
      <div class="w-full h-full bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2040%2040%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M20%2020.5V18H0v-2h20v-2l-3-3%203-3v-2H0V4h20V1.5L23.5%205%2020%208.5z%22%20fill%3D%22%23fff%22%20fill-opacity%3D%220.2%22%20fill-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E')]"></div>
    </div>
    <div class="relative h-full flex items-center">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white">
          {t('about.hero.title', locale)}
        </h1>
        <p class="mt-4 text-xl text-white/80 max-w-2xl">
          {t('about.hero.subtitle', locale)}
        </p>
      </div>
    </div>
  </div>

  <!-- Content -->
  <div class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <h2 class="text-2xl sm:text-3xl font-heading font-bold text-wrc-green-900 mb-6">
            {t('about.intro.title', locale)}
          </h2>
          <div class="space-y-4 text-gray-600 leading-relaxed">
            <p>{t('about.intro.p1', locale)}</p>
            <p>{t('about.intro.p2', locale)}</p>
          </div>
          <div class="mt-6">
            <Button href="#" variant="primary">
              {t('common.downloadAgenda', locale)}
            </Button>
          </div>
        </div>
        <!-- Photo placeholder -->
        <div class="aspect-[4/3] rounded-xl bg-gradient-to-br from-wrc-green-100 to-wrc-green-200 flex items-center justify-center">
          <span class="text-wrc-green-400 font-heading font-bold">Ranger Photo</span>
        </div>
      </div>
    </div>
  </div>
</section>
