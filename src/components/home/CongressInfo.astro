---
import { getLocaleFromUrl, t } from '../../i18n/utils';
import { VENUE } from '../../utils/constants';
import MapEmbed from '../ui/MapEmbed.astro';
import SketchDecorations from '../easter-eggs/SketchDecorations.astro';

const locale = getLocaleFromUrl(Astro.url);
---

<section class="py-20 md:py-28 relative overflow-hidden bg-white">
  <!-- Soft natural gradient undertone -->
  <div class="absolute inset-0 bg-gradient-to-b from-wrc-green-50/40 via-white to-wrc-green-50/30" aria-hidden="true"></div>

  <!-- LEFT SIDE: Tall tropical trees & foliage -->
  <div class="absolute left-0 top-0 bottom-0 w-40 md:w-64 lg:w-80 pointer-events-none" aria-hidden="true">
    <!-- Tall tree trunk + canopy -->
    <svg class="absolute left-0 top-0 h-full w-full opacity-[0.06]" viewBox="0 0 200 600" preserveAspectRatio="xMinYMin slice" fill="#14532d">
      <!-- Tree trunk -->
      <rect x="30" y="120" width="18" height="480" rx="4"/>
      <!-- Canopy layers -->
      <ellipse cx="39" cy="130" rx="55" ry="40"/>
      <ellipse cx="45" cy="90" rx="42" ry="35"/>
      <ellipse cx="35" cy="55" rx="35" ry="30"/>
      <!-- Second tree -->
      <rect x="90" y="200" width="14" height="400" rx="3"/>
      <ellipse cx="97" cy="210" rx="45" ry="35"/>
      <ellipse cx="100" cy="175" rx="35" ry="28"/>
    </svg>
    <!-- Fern cluster bottom-left -->
    <svg class="absolute left-2 bottom-8 w-36 md:w-48 opacity-[0.08]" viewBox="0 0 120 100" fill="none" stroke="#14532d" stroke-width="1.2">
      <!-- Fern frond 1 -->
      <path d="M30 95 Q28 70 25 50 Q22 30 30 10"/>
      <path d="M26 80 Q18 76 12 80"/><path d="M25 65 Q15 60 10 64"/>
      <path d="M24 50 Q14 45 8 48"/><path d="M23 35 Q16 30 12 33"/>
      <path d="M27 80 Q35 76 40 80"/><path d="M26 65 Q34 60 40 64"/>
      <path d="M25 50 Q34 45 40 48"/><path d="M24 35 Q32 30 36 33"/>
      <!-- Fern frond 2 -->
      <path d="M60 95 Q62 65 65 45 Q68 25 60 8"/>
      <path d="M63 75 Q55 72 50 75"/><path d="M64 60 Q55 56 50 59"/>
      <path d="M65 45 Q57 41 52 44"/>
      <path d="M63 75 Q72 72 78 75"/><path d="M64 60 Q74 56 80 59"/>
      <path d="M65 45 Q74 41 80 44"/>
      <!-- Ground ferns -->
      <path d="M5 92 Q20 85 35 92" fill="#14532d" opacity="0.3"/>
      <path d="M45 95 Q65 86 85 95" fill="#14532d" opacity="0.2"/>
    </svg>
    <!-- Hanging vine -->
    <svg class="absolute left-16 md:left-28 top-0 w-8 h-48 opacity-[0.07]" viewBox="0 0 20 120" fill="none" stroke="#14532d" stroke-width="1.5">
      <path d="M10 0 Q6 20 12 40 Q18 60 8 80 Q4 95 10 120"/>
      <circle cx="10" cy="40" r="3" fill="#14532d" opacity="0.4"/>
      <circle cx="8" cy="80" r="2.5" fill="#14532d" opacity="0.3"/>
      <circle cx="10" cy="115" r="2" fill="#14532d" opacity="0.3"/>
    </svg>
    <!-- Large monstera leaf -->
    <svg class="absolute left-4 md:left-10 top-[30%] w-28 md:w-40 opacity-[0.06] -rotate-12" viewBox="0 0 100 100" fill="#14532d">
      <path d="M50 95 Q46 75 40 55 Q35 40 40 28 Q45 16 52 10 Q60 5 68 12 Q75 22 70 35 Q65 45 60 55 Q55 70 52 80 Q50 88 50 95Z"/>
      <!-- Leaf holes -->
      <ellipse cx="48" cy="55" rx="5" ry="7" fill="white"/>
      <ellipse cx="58" cy="40" rx="4" ry="6" fill="white"/>
      <ellipse cx="45" cy="38" rx="3" ry="5" fill="white"/>
    </svg>
  </div>

  <!-- RIGHT SIDE: Trees, waterfall hint & foliage -->
  <div class="absolute right-0 top-0 bottom-0 w-40 md:w-64 lg:w-80 pointer-events-none" aria-hidden="true">
    <!-- Tall tree canopy right -->
    <svg class="absolute right-0 top-0 h-full w-full opacity-[0.06]" viewBox="0 0 200 600" preserveAspectRatio="xMaxYMin slice" fill="#14532d">
      <rect x="150" y="100" width="16" height="500" rx="4"/>
      <ellipse cx="158" cy="110" rx="50" ry="38"/>
      <ellipse cx="155" cy="72" rx="38" ry="30"/>
      <rect x="80" y="180" width="14" height="420" rx="3"/>
      <ellipse cx="87" cy="190" rx="42" ry="32"/>
      <ellipse cx="90" cy="158" rx="32" ry="26"/>
    </svg>
    <!-- Waterfall cascade hint -->
    <svg class="absolute right-8 md:right-16 top-[15%] w-20 md:w-28 h-64 opacity-[0.05]" viewBox="0 0 50 150" fill="none" stroke="#14532d" stroke-width="1.5">
      <!-- Cliff edge -->
      <path d="M5 20 Q15 15 25 20 Q35 15 45 20" stroke-width="2"/>
      <!-- Water streams -->
      <path d="M15 20 Q14 50 16 80 Q18 110 15 140" stroke-dasharray="4 3"/>
      <path d="M25 20 Q26 55 24 90 Q22 120 25 145" stroke-dasharray="5 3"/>
      <path d="M35 20 Q34 45 36 75 Q38 105 35 135" stroke-dasharray="3 4"/>
      <!-- Mist at bottom -->
      <ellipse cx="25" cy="145" rx="22" ry="5" fill="#14532d" opacity="0.2"/>
    </svg>
    <!-- Tropical leaves right -->
    <svg class="absolute right-2 bottom-12 w-32 md:w-44 opacity-[0.07] scale-x-[-1]" viewBox="0 0 100 80" fill="none" stroke="#14532d" stroke-width="1.2">
      <path d="M20 75 Q22 55 25 40 Q28 25 22 12"/>
      <path d="M23 60 Q15 56 10 60"/><path d="M24 48 Q15 43 10 46"/>
      <path d="M25 36 Q17 31 12 34"/><path d="M24 24 Q18 20 14 22"/>
      <path d="M24 60 Q32 56 38 60"/><path d="M25 48 Q34 43 40 46"/>
      <path d="M26 36 Q34 31 40 34"/><path d="M25 24 Q32 20 36 22"/>
      <!-- Heliconia flower -->
      <path d="M65 70 Q63 55 65 40"/>
      <path d="M65 55 Q58 50 55 55 Q58 58 65 55" fill="#14532d" opacity="0.4"/>
      <path d="M65 45 Q72 40 75 45 Q72 48 65 45" fill="#14532d" opacity="0.3"/>
      <path d="M65 38 Q58 33 56 38 Q59 40 65 38" fill="#14532d" opacity="0.25"/>
    </svg>
    <!-- Hanging vine right -->
    <svg class="absolute right-20 md:right-32 top-0 w-6 h-40 opacity-[0.06]" viewBox="0 0 16 100" fill="none" stroke="#14532d" stroke-width="1.3">
      <path d="M8 0 Q12 18 6 36 Q2 54 10 72 Q14 85 8 100"/>
      <circle cx="6" cy="36" r="2.5" fill="#14532d" opacity="0.3"/>
      <circle cx="10" cy="72" r="2" fill="#14532d" opacity="0.3"/>
    </svg>
  </div>

  <!-- TOP: Canopy border -->
  <div class="absolute top-0 left-0 right-0 pointer-events-none" aria-hidden="true">
    <svg viewBox="0 0 1400 60" class="w-full" preserveAspectRatio="none" fill="#14532d" opacity="0.04">
      <path d="M0 60 Q35 15 70 35 Q105 5 140 25 Q175 0 210 20 Q245 5 280 30 Q315 8 350 28 Q385 2 420 22 Q455 8 490 32 Q525 5 560 25 Q595 0 630 22 Q665 8 700 30 Q735 3 770 24 Q805 7 840 28 Q875 2 910 22 Q945 10 980 30 Q1015 5 1050 25 Q1085 0 1120 22 Q1155 8 1190 30 Q1225 5 1260 25 Q1295 10 1330 32 Q1365 8 1400 28 L1400 0 L0 0Z"/>
    </svg>
  </div>

  <!-- BOTTOM: Ground / undergrowth border -->
  <div class="absolute bottom-0 left-0 right-0 pointer-events-none" aria-hidden="true">
    <svg viewBox="0 0 1400 50" class="w-full" preserveAspectRatio="none" fill="#14532d" opacity="0.04">
      <path d="M0 0 Q40 30 80 15 Q120 40 160 12 Q200 35 240 10 Q280 38 320 14 Q360 32 400 8 Q440 36 480 12 Q520 30 560 6 Q600 34 640 10 Q680 32 720 8 Q760 36 800 14 Q840 30 880 10 Q920 35 960 12 Q1000 32 1040 8 Q1080 36 1120 14 Q1160 30 1200 10 Q1240 35 1280 12 Q1320 30 1360 8 Q1380 20 1400 15 L1400 50 L0 50Z"/>
    </svg>
  </div>

  <!-- Butterfly floating top-right area -->
  <svg class="absolute top-16 right-[18%] w-10 h-10 md:w-14 md:h-14 opacity-[0.07] sketch-float" viewBox="0 0 40 40" fill="none" stroke="#14532d" stroke-width="1" aria-hidden="true">
    <path d="M20 12 Q14 4 7 12 Q3 20 12 24 Q16 25 20 22"/>
    <path d="M20 12 Q26 4 33 12 Q37 20 28 24 Q24 25 20 22"/>
    <path d="M20 22 Q18 30 16 34"/><path d="M20 22 Q22 30 24 34"/>
    <line x1="20" y1="10" x2="16" y2="4"/><line x1="20" y1="10" x2="24" y2="4"/>
  </svg>

  <!-- Toucan silhouette left area -->
  <svg class="absolute top-[22%] left-[8%] w-14 h-14 md:w-20 md:h-20 opacity-[0.05] hidden md:block" viewBox="0 0 60 60" fill="none" stroke="#14532d" stroke-width="1.3" aria-hidden="true">
    <path d="M35 20 Q30 15 25 18 Q20 22 22 28 Q24 32 30 30 Q35 28 35 20Z"/>
    <path d="M25 18 L10 15 Q8 18 12 20 Q16 22 22 22"/>
    <circle cx="30" cy="22" r="1.5" fill="#14532d"/>
    <path d="M30 30 Q28 38 25 42 Q22 45 28 44 Q32 42 30 38"/>
    <path d="M35 24 Q40 22 44 26 Q42 30 38 28"/>
    <path d="M25 42 Q22 48 25 50"/><path d="M30 40 Q32 46 30 48"/>
  </svg>

  <SketchDecorations variant="forest" color="#14532d" />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section header -->
    <div class="text-center mb-12">
      <p class="text-wrc-green-600 text-sm font-semibold tracking-widest uppercase mb-3">
        {t('home.congress.location', locale)}
      </p>
      <h2 class="text-3xl md:text-5xl font-heading font-bold text-wrc-green-900 mb-4">
        {t('home.congress.title', locale)}
      </h2>

      <!-- Leaf vine divider -->
      <div class="flex items-center justify-center gap-3 mt-6" aria-hidden="true">
        <div class="h-px w-16 bg-gradient-to-r from-transparent to-wrc-green-300"></div>
        <svg class="w-6 h-6 text-wrc-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <path d="M12 22 Q9 16 6 12 Q3 8 6 5 Q9 3 12 7 Q15 3 18 5 Q21 8 18 12 Q15 16 12 22Z" fill="currentColor" opacity="0.1"/>
          <path d="M12 22 Q9 16 6 12 Q3 8 6 5 Q9 3 12 7 Q15 3 18 5 Q21 8 18 12 Q15 16 12 22Z"/>
          <path d="M12 22 L12 7" stroke-dasharray="2 2" opacity="0.4"/>
        </svg>
        <div class="h-px w-16 bg-gradient-to-l from-transparent to-wrc-green-300"></div>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 lg:gap-12 items-start">
      <!-- Info cards -->
      <div class="space-y-5">
        <!-- Venue card -->
        <div class="group bg-white rounded-2xl p-6 shadow-md border border-wrc-green-100 hover:shadow-lg hover:border-wrc-green-200 transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-wrc-green-50 flex items-center justify-center shrink-0 group-hover:bg-wrc-green-100 transition-colors" aria-hidden="true">
              <svg class="w-6 h-6 text-wrc-green-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 2 L12 7 M12 7 Q7 7 4 10 Q2 12 2 16 Q2 20 6 21 L18 21 Q22 20 22 16 Q22 12 20 10 Q17 7 12 7Z" />
                <path d="M8 14 Q10 10 12 14 Q14 10 16 14" opacity="0.5"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-bold text-lg text-wrc-green-800 mb-1">{t('home.congress.venue', locale)}</h3>
              <p class="text-gray-700 font-semibold">{VENUE.name}</p>
              <p class="text-gray-500 text-sm mt-1">{VENUE.city}, {VENUE.state}, {VENUE.country}</p>
            </div>
          </div>
        </div>

        <!-- Natural Setting card -->
        <div class="group bg-white rounded-2xl p-6 shadow-md border border-wrc-green-100 hover:shadow-lg hover:border-wrc-blue-200 transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-wrc-blue-50 flex items-center justify-center shrink-0 group-hover:bg-wrc-blue-100 transition-colors" aria-hidden="true">
              <svg class="w-6 h-6 text-wrc-blue-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 6 Q8 4 12 6 Q16 4 20 6"/>
                <path d="M8 6 Q8 12 7 18" stroke-dasharray="2 2"/>
                <path d="M12 6 Q12 14 12 20" stroke-dasharray="3 2"/>
                <path d="M16 6 Q16 11 15 16" stroke-dasharray="2 2"/>
                <path d="M3 20 Q8 17 12 20 Q16 23 21 20"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-bold text-lg text-wrc-green-800 mb-1">{t('home.congress.setting', locale)}</h3>
              <p class="text-gray-700 font-semibold">{t('home.congress.settingValue', locale)}</p>
              <p class="text-gray-500 text-sm mt-1">{t('home.congress.settingDesc', locale)}</p>
            </div>
          </div>
        </div>

        <!-- Date card -->
        <div class="group bg-white rounded-2xl p-6 shadow-md border border-wrc-green-100 hover:shadow-lg hover:border-wrc-earth-200 transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-wrc-earth-50 flex items-center justify-center shrink-0 group-hover:bg-wrc-earth-100 transition-colors" aria-hidden="true">
              <svg class="w-6 h-6 text-wrc-earth-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="4" width="18" height="17" rx="3" />
                <line x1="3" y1="9" x2="21" y2="9" />
                <line x1="8" y1="2" x2="8" y2="6" /><line x1="16" y1="2" x2="16" y2="6" />
                <circle cx="12" cy="15" r="2" fill="currentColor" opacity="0.3"/>
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-bold text-lg text-wrc-green-800 mb-1">{t('home.congress.date', locale)}</h3>
              <p class="text-gray-700 font-semibold">{t('home.congress.dateValue', locale)}</p>
              <p class="text-gray-500 text-sm mt-1">{t('home.congress.checkin', locale)}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Map -->
      <div class="rounded-2xl overflow-hidden shadow-lg border border-wrc-green-100">
        <MapEmbed
          src={VENUE.mapEmbed}
          title="Centro de Eventos y Convenciones del Iguazu"
          height="420"
        />
      </div>
    </div>
  </div>
</section>
