---
import { getLocaleFromUrl, t } from '../../i18n/utils';
import { ORGANIZERS } from '../../utils/constants';
import Button from '../ui/Button.astro';

const locale = getLocaleFromUrl(Astro.url);
---

<section class="py-16 relative overflow-hidden bg-gradient-to-b from-gray-50 to-wrc-green-50/30">
  <div class="absolute inset-0 nature-texture" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-wrc-green-900 mb-4">
      {t('home.organizers.title', locale)}
    </h2>

    <!-- Decorative divider -->
    <div class="flex items-center justify-center gap-2 mb-10" aria-hidden="true">
      <div class="h-px w-12 bg-wrc-green-300"></div>
      <svg class="w-5 h-5 text-wrc-green-500" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M10 18 Q7 12 5 8 Q3 4 6 2 Q8 1 10 4 Q12 1 14 2 Q17 4 15 8 Q13 12 10 18Z" />
      </svg>
      <div class="h-px w-12 bg-wrc-green-300"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {Object.values(ORGANIZERS).map((org) => (
        <div class="bg-white/80 backdrop-blur-sm rounded-xl shadow-md p-6 md:p-8 border border-wrc-green-100 flex flex-col hover:shadow-lg transition-shadow">
          <!-- Logo placeholder -->
          <div class="w-16 h-16 rounded-lg bg-wrc-green-100 border border-wrc-green-200 flex items-center justify-center mb-4">
            <span class="text-wrc-green-700 font-heading font-bold text-sm">{org.shortName}</span>
          </div>
          <h3 class="font-heading font-bold text-xl text-gray-900 mb-2">{org.name}</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-4 flex-1">{org.description}</p>
          <p class="text-gray-400 text-xs mb-4">Founded {org.founded}</p>
          <Button href={org.website} variant="outline" size="sm">
            {t('common.visitWebsite', locale)}
          </Button>
        </div>
      ))}
    </div>
  </div>
</section>
