---
import { getLocaleFromUrl, t } from '../../i18n/utils';
import { EXTERNAL_LINKS } from '../../utils/constants';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const sponsorRangerLink = locale === 'es'
  ? EXTERNAL_LINKS.sponsorRangerES
  : locale === 'fr'
    ? EXTERNAL_LINKS.sponsorRangerFR
    : EXTERNAL_LINKS.sponsorRangerEN;

const sponsorRangerLabel = locale === 'es'
  ? 'Patrocinar a un Guardaparque'
  : locale === 'fr'
    ? 'Parrainer un Garde Forestier'
    : 'Sponsor a Ranger';

const categories = [
  { title: t('home.sponsors.funders', locale), count: 4 },
  { title: t('home.sponsors.institutional', locale), count: 6 },
  { title: t('home.sponsors.ranger', locale), count: 5 },
];
---

<section class="py-16 relative overflow-hidden bg-gradient-to-b from-white to-wrc-green-50/30">
  <div class="absolute inset-0 nature-texture" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Decorative background image on left edge -->
    <img src="/images/home/12.png" alt="" class="absolute -left-[10%] -top-[15%] h-[40%] w-auto object-contain object-left opacity-30 pointer-events-none" aria-hidden="true" />

    <!-- Decorative background image on right edge -->
    <img src="/images/home/14.png" alt="" class="absolute -right-[5%] -top-[5%] h-[140%] w-auto object-contain object-right opacity-30 pointer-events-none" aria-hidden="true" />

    <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-wrc-green-900 mb-4">
      {t('home.sponsors.title', locale)}
    </h2>

    <!-- Decorative divider -->
    <div class="flex items-center justify-center gap-2 mb-10" aria-hidden="true">
      <div class="h-px w-12 bg-wrc-green-300"></div>
      <svg class="w-5 h-5 text-wrc-green-500" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M10 2 Q15 8 15 13 Q14 17 10 19 Q6 17 5 13 Q5 8 10 2Z" />
      </svg>
      <div class="h-px w-12 bg-wrc-green-300"></div>
    </div>

    {categories.map((category) => (
      <div class="mb-10">
        <h3 class="text-lg font-heading font-semibold text-gray-600 text-center mb-6">{category.title}</h3>
        <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-8">
          {Array.from({ length: category.count }).map((_, i) => (
            <div class="w-24 h-16 sm:w-32 sm:h-20 rounded-lg bg-white/80 backdrop-blur-sm shadow-sm border border-wrc-green-100 flex items-center justify-center hover:shadow-md transition-shadow">
              <span class="text-gray-300 text-xs font-heading">Logo</span>
            </div>
          ))}
        </div>
      </div>
    ))}

    <!-- Sponsor a Ranger CTA -->
    <div class="mt-10 text-center">
      <a
        href={sponsorRangerLink}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-wrc-green-700 text-white font-heading font-bold text-sm hover:bg-wrc-green-800 transition-colors shadow-md"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        {sponsorRangerLabel}
      </a>
    </div>
  </div>
</section>
