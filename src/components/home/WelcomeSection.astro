---
import { getLocaleFromUrl, t } from '../../i18n/utils';
import SketchDecorations from '../easter-eggs/SketchDecorations.astro';

const locale = getLocaleFromUrl(Astro.url);
---

<div class="py-16 md:py-24 relative overflow-hidden">
  <SketchDecorations variant="tropical" color="#14532d" />

  <!-- Iguazu terrain cutout wave decoration -->
  <div class="absolute top-0 left-0 right-0 w-full h-full pointer-events-none select-none overflow-hidden" aria-hidden="true" style="z-index: 0;">
    <div class="w-full h-full opacity-[0.08]" style="
      background: linear-gradient(135deg, #14532d 0%, #166534 20%, transparent 45%),
                  linear-gradient(to right, #14532d 0%, #15803d 15%, #22c55e 25%, transparent 50%);
      mask-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1600 800%22%3E%3Cpath d=%22M0 0 L1200 0 Q1150 50 1100 30 Q1050 10 1000 40 Q950 70 900 50 Q850 30 800 60 Q750 90 700 65 Q650 40 600 70 Q550 100 500 80 Q450 55 400 85 Q350 110 300 90 Q250 70 200 100 Q150 130 100 110 Q50 90 0 120Z%22 fill=%22white%22/%3E%3Cpath d=%22M0 120 Q50 150 100 130 Q200 180 300 160 Q400 200 500 170 Q600 220 700 190 Q800 250 900 210 Q950 270 1000 240 Q1050 300 1100 260 Q1150 320 1200 280 L1200 800 L0 800Z%22 fill=%22white%22/%3E%3C/svg%3E'), linear-gradient(to bottom, white 60%, transparent 100%);
      -webkit-mask-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1600 800%22%3E%3Cpath d=%22M0 0 L1200 0 Q1150 50 1100 30 Q1050 10 1000 40 Q950 70 900 50 Q850 30 800 60 Q750 90 700 65 Q650 40 600 70 Q550 100 500 80 Q450 55 400 85 Q350 110 300 90 Q250 70 200 100 Q150 130 100 110 Q50 90 0 120Z%22 fill=%22white%22/%3E%3Cpath d=%22M0 120 Q50 150 100 130 Q200 180 300 160 Q400 200 500 170 Q600 220 700 190 Q800 250 900 210 Q950 270 1000 240 Q1050 300 1100 260 Q1150 320 1200 280 L1200 800 L0 800Z%22 fill=%22white%22/%3E%3C/svg%3E'), linear-gradient(to bottom, white 60%, transparent 100%);
      mask-size: cover, 100% 100%;
      -webkit-mask-size: cover, 100% 100%;
      mask-repeat: no-repeat;
      -webkit-mask-repeat: no-repeat;
      mask-composite: intersect;
      -webkit-mask-composite: source-in;
    "></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto">
      <!-- Organisation logos -->
      <div class="flex items-center justify-center gap-6 sm:gap-10 mb-10">
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-white border-2 border-wrc-green-200 flex items-center justify-center shadow-md overflow-hidden p-2">
          <img src="/images/logos/irf.png" alt="IRF" class="w-full h-full object-contain" />
        </div>
        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-white border-2 border-wrc-green-200 flex items-center justify-center shadow-md overflow-hidden p-2">
          <img src="/images/logos/wrc.png" alt="WRC" class="w-full h-full object-contain" />
        </div>
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-white border-2 border-wrc-green-200 flex items-center justify-center shadow-md overflow-hidden p-2">
          <img src="/images/logos/sigunara.png" alt="SIGUNARA" class="w-full h-full object-contain" />
        </div>
      </div>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-wrc-green-900 leading-tight">
        {t('home.welcome.title', locale)}
      </h2>

      <!-- Decorative divider -->
      <div class="flex items-center justify-center gap-3 my-6" aria-hidden="true">
        <svg class="w-8 h-4 text-wrc-green-400" viewBox="0 0 30 15" fill="none" stroke="currentColor" stroke-width="1.2">
          <path d="M2 8 Q8 2 15 8 Q22 2 28 8" />
        </svg>
        <svg class="w-5 h-5 text-wrc-earth-500" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M10 2 Q15 8 15 13 Q14 17 10 19 Q6 17 5 13 Q5 8 10 2Z" />
        </svg>
        <svg class="w-8 h-4 text-wrc-green-400" viewBox="0 0 30 15" fill="none" stroke="currentColor" stroke-width="1.2">
          <path d="M2 8 Q8 2 15 8 Q22 2 28 8" />
        </svg>
      </div>

      <p class="text-lg sm:text-xl text-wrc-earth-600 font-heading font-semibold italic">
        "{t('home.welcome.theme', locale)}"
      </p>
      <p class="mt-6 text-gray-600 leading-relaxed max-w-2xl mx-auto text-lg">
        {t('home.welcome.description', locale)}
      </p>
    </div>
  </div>
</div>
