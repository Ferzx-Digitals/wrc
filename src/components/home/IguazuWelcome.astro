---
import { getLocaleFromUrl, t } from '../../i18n/utils';
import Button from '../ui/Button.astro';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;
---

<!-- Puerto Iguazu Welcomes You section -->
<section class="relative overflow-hidden bg-gradient-to-b from-wrc-green-50 to-wrc-green-100/50">
  <!-- Background image starting from left edge -->
  <img src="/images/home/8-iguazu-map.png" alt="Iguazu region" class="absolute inset-0 w-full h-full object-contain object-left opacity-30" />
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24 relative z-10">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-stretch">

      <!-- Left: Text content on top of image -->
      <div class="relative min-h-[400px] md:min-h-[480px] flex items-end">
        <div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold leading-tight mb-2 text-wrc-green-900">
            {t('home.iguazu.title', locale)}
          </h2>
          <p class="text-xl sm:text-2xl font-heading font-bold text-wrc-green-700 mb-5">
            {t('home.iguazu.subtitle', locale)}
          </p>
          <p class="text-gray-700 font-semibold leading-relaxed mb-3 text-sm md:text-base max-w-lg">
            {t('home.iguazu.p1', locale)}
          </p>
          <p class="text-gray-700 font-semibold leading-relaxed mb-6 text-sm md:text-base max-w-lg">
            {t('home.iguazu.p2', locale)}
          </p>
          <a href={`${prefix}/about`} class="inline-flex items-center justify-center px-6 py-3 font-heading font-semibold rounded-lg text-base bg-wrc-green-800 text-white hover:bg-wrc-green-900 transition-colors duration-200 shadow-lg">
            {t('common.learnMore', locale)}
          </a>
        </div>
      </div>

      <!-- Right: Animated illustrated map of Iguazu region -->
      <div class="relative min-h-[400px] md:min-h-[480px] flex items-center justify-center">
        <img src="/images/home/9-iguazu-map.png" alt="Illustrated map of the Iguazu Triple Frontier region" class="w-full h-full object-contain opacity-90 iguazu-map-fade" />
      </div>

    </div>
  </div>
</section>

<style>
  .iguazu-map-fade {
    mask-image: radial-gradient(ellipse 50% 50% at center, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at center, black 40%, transparent 100%);
  }
</style>
