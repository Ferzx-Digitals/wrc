---
import { getLocaleFromUrl, t } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);

const teamMembers: { name: string; role: string; org: string; image?: string; imagePos?: string }[] = [
  { name: 'Chris Galliers', role: 'President', org: 'IRF', image: '/images/team/irf/Chris Galliers - Presidnet.jpg' },
  { name: 'Rohit Singh', role: 'Vice President', org: 'IRF', image: '/images/team/irf/Rohit Singh - Vice president.jpg' },
  { name: 'Andy Davies', role: 'Secretary', org: 'IRF', image: '/images/team/irf/Andy Davies.png' },
  { name: 'Carlien Roodt', role: 'Executive Officer', org: 'IRF', image: '/images/team/irf/Carlien Roodt.jpg', imagePos: 'center 15%' },
  { name: 'Mike Lynch', role: 'Treasurer', org: 'IRF', image: '/images/team/irf/Mike Lynch - Treasurer.jpg', imagePos: '35% 45%' },
  { name: 'Monica Alvarez', role: 'Federation Development Officer', org: 'IRF', image: '/images/team/irf/Mónica Álvarez Malvido.jpg' },
  { name: 'Jonathan Churcher', role: 'General Manager', org: 'IRF', image: '/images/team/irf/Jonathan Churcher.png' },
  { name: 'Antuel Sánchez', role: 'General Secretary', org: 'SIGUNARA', image: '/images/team/sigunara/Antuel Sánchez, general secretary, SIGUNARA.jpeg' },
  { name: 'Leonardo Juber', role: 'Member', org: 'SIGUNARA', image: '/images/team/sigunara/Leo Juber.jpeg' },
  { name: 'Sofia Nazar', role: 'Member', org: 'SIGUNARA', image: '/images/team/sigunara/Sofia Nazar - Sigunara.jpeg', imagePos: 'center 30%' },
  { name: 'Federico Rodríguez Mira', role: 'Member', org: 'SIGUNARA', image: '/images/team/sigunara/Federico Rodríguez Mira, SIGUNARA.jpeg' },
  { name: 'Oscar Carvajal Mora', role: 'President FLG', org: 'FLG', image: '/images/team/sigunara/Óscar Carvajal Mora, FLG president.jpeg', imagePos: '15% center' },
  { name: 'Laura Pastorino Ladereche', role: 'Vice President FLG', org: 'FLG', image: '/images/team/sigunara/Laura P FLG.jpeg' },
  { name: 'Andrea Juncos', role: 'Executive Director', org: 'Plan A', image: '/images/team/plana/Andrea Juncos - Executive Director.jpg' },
  { name: 'Ana Lacuadra', role: 'Project Manager', org: 'Plan A', image: '/images/team/plana/2 - Ana Lacuadra. Project Manager.jpg' },
  { name: 'Malvina Solis', role: 'Local Coordinator', org: 'Plan A', image: '/images/team/plana/Malvina Solis - Local coordinator.jpg', imagePos: 'center 30%' },
  { name: 'Martina Alvarez', role: 'Registration', org: 'Plan A', image: '/images/team/plana/Martina Alvarez - Registrations.png' },
  { name: 'Natalia Benejam', role: 'Commercial Coordinator', org: 'Plan A', image: '/images/team/plana/Natalia Benejam - Comercial Coordinator.jpeg' },
  { name: 'Renata Bollini', role: 'Coordinator Assistant', org: 'Plan A', image: '/images/team/plana/Renata Bollini - Coordinator Assitant.jpeg' },
  { name: 'Celeste Dichico', role: 'Academic Coordinator', org: 'Plan A', image: '/images/team/plana/Celeste Dichico - Academic coordinator.jpg' },
];

const orgColors: Record<string, string> = {
  IRF: 'bg-wrc-green-100 text-wrc-green-700 border-wrc-green-200',
  SIGUNARA: 'bg-wrc-blue-100 text-wrc-blue-700 border-wrc-blue-200',
  FLG: 'bg-wrc-earth-100 text-wrc-earth-600 border-wrc-earth-200',
  'Plan A': 'bg-purple-100 text-purple-700 border-purple-200',
};

const avatarBgs: Record<string, string> = {
  IRF: 'bg-wrc-green-200 text-wrc-green-700',
  SIGUNARA: 'bg-wrc-blue-200 text-wrc-blue-700',
  FLG: 'bg-wrc-earth-200 text-wrc-earth-700',
  'Plan A': 'bg-purple-200 text-purple-700',
};
---

<section class="pt-0 pb-24 relative overflow-hidden">
  <div class="absolute inset-0 nature-texture" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-wrc-green-900 mb-4">
      {t('home.team.title', locale)}
    </h2>

    <!-- Decorative divider -->
    <div class="flex items-center justify-center gap-2 mb-10" aria-hidden="true">
      <div class="h-px w-12 bg-wrc-green-300"></div>
      <svg class="w-5 h-5 text-wrc-green-500" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M10 2 Q15 8 15 13 Q14 17 10 19 Q6 17 5 13 Q5 8 10 2Z" />
      </svg>
      <div class="h-px w-12 bg-wrc-green-300"></div>
    </div>

    <div class="swiper team-carousel">
      <div class="swiper-wrapper">
        {teamMembers.map((member) => (
          <div class="swiper-slide">
            <div class="text-center px-2">
              <!-- Team member photo -->
              <div class={`w-24 h-24 sm:w-28 sm:h-28 mx-auto rounded-full flex items-center justify-center mb-3 shadow-md ring-2 ring-wrc-green-200/50 overflow-hidden ${avatarBgs[member.org] || 'bg-gray-200 text-gray-500'}`}>
                {member.image ? (
                  <img src={member.image} alt={member.name} class="w-full h-full object-cover" style={member.imagePos ? `object-position: ${member.imagePos}` : undefined} />
                ) : (
                  <span class="text-2xl font-heading font-bold">{member.name.charAt(0)}</span>
                )}
              </div>
              <h3 class="font-heading font-bold text-sm text-gray-900">{member.name}</h3>
              <p class="text-[11px] text-gray-500 mt-1 whitespace-nowrap">{member.role}</p>
              <span class={`inline-block mt-2 px-2 py-0.5 rounded-full text-xs font-medium border ${orgColors[member.org] || 'bg-gray-100 text-gray-600 border-gray-200'}`}>
                {member.org}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Autoplay } from 'swiper/modules';

  new Swiper('.team-carousel', {
    modules: [Autoplay],
    slidesPerView: 2,
    spaceBetween: 16,
    autoplay: { delay: 3000, disableOnInteraction: false },
    breakpoints: {
      480: { slidesPerView: 3 },
      768: { slidesPerView: 4 },
      1024: { slidesPerView: 5 },
      1280: { slidesPerView: 6 },
    },
    a11y: { enabled: true },
  });
</script>
