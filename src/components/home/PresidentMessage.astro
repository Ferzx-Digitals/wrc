---
import { getLocaleFromUrl, t } from '../../i18n/utils';
import SketchDecorations from '../easter-eggs/SketchDecorations.astro';

const locale = getLocaleFromUrl(Astro.url);
---

<section class="py-16 md:py-20 bg-wrc-green-900 text-white relative overflow-hidden">
  <!-- Subtle forest texture overlay -->
  <div class="absolute inset-0 mist-overlay opacity-30" aria-hidden="true"></div>

  <!-- Nature background pattern -->
  <div class="absolute inset-0 opacity-[0.05] pointer-events-none" aria-hidden="true">
    <svg viewBox="0 0 1440 400" class="w-full h-full" preserveAspectRatio="xMidYMid slice" fill="none" stroke="white" stroke-width="0.8">
      <!-- Scattered leaf outlines -->
      <path d="M100 50 Q90 30 95 15 Q105 5 115 15 Q120 30 110 50Z" />
      <path d="M300 350 Q290 330 295 315 Q305 305 315 315 Q320 330 310 350Z" />
      <path d="M700 80 Q690 60 695 45 Q705 35 715 45 Q720 60 710 80Z" />
      <path d="M1100 300 Q1090 280 1095 265 Q1105 255 1115 265 Q1120 280 1110 300Z" />
      <path d="M1300 100 Q1290 80 1295 65 Q1305 55 1315 65 Q1320 80 1310 100Z" />
      <!-- Fern curves -->
      <path d="M200 200 Q220 180 240 190 Q260 200 250 220" />
      <path d="M900 150 Q920 130 940 140 Q960 150 950 170" />
    </svg>
  </div>

  <SketchDecorations variant="forest" color="white" />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <h2 class="text-3xl md:text-4xl font-heading font-bold text-center mb-10">
      {t('home.president.title', locale)}
    </h2>
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row gap-8 items-center">
      <!-- Photo placeholder with nature border -->
      <div class="relative shrink-0">
        <div class="w-32 h-32 md:w-40 md:h-40 rounded-full bg-wrc-green-700 flex items-center justify-center shadow-xl ring-4 ring-wrc-green-600/50">
          <span class="text-wrc-green-300 text-sm font-heading">Photo</span>
        </div>
        <!-- Decorative leaf accent -->
        <svg class="absolute -bottom-2 -right-2 w-10 h-10 text-wrc-green-500 opacity-40" viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
          <path d="M15 28 Q10 20 7 14 Q4 8 8 4 Q12 2 15 6 Q18 2 22 4 Q26 8 23 14 Q20 20 15 28Z" />
        </svg>
      </div>
      <div>
        <blockquote class="text-lg md:text-xl leading-relaxed text-wrc-green-100 italic">
          "{t('home.president.quote', locale)}"
        </blockquote>
        <div class="mt-4">
          <p class="font-heading font-bold text-white">{t('home.president.name', locale)}</p>
          <p class="text-wrc-green-300 text-sm">{t('home.president.role', locale)}</p>
        </div>
      </div>
    </div>
  </div>
</section>
