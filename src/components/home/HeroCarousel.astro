---
import { getLocaleFromUrl, t } from '../../i18n/utils';
import Button from '../ui/Button.astro';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const bannerImages = ['banner-1.jpg', 'banner-2.png', 'banner-3.jpg'];

const slides = [
  {
    title: t('home.hero.slide1.title', locale),
    subtitle: t('home.hero.slide1.subtitle', locale),
    description: t('home.hero.slide1.description', locale),
    bg: 'from-wrc-green-900 via-wrc-green-800 to-wrc-green-900',
    banner: bannerImages[0],
  },
  {
    title: t('home.hero.slide2.title', locale),
    subtitle: t('home.hero.slide2.subtitle', locale),
    description: t('home.hero.slide2.description', locale),
    bg: 'from-wrc-green-900 via-wrc-blue-900 to-wrc-green-800',
    banner: bannerImages[1],
    bgPos: 'center 70%',
    bgTop: '4rem',
  },
  {
    title: t('home.hero.slide3.title', locale),
    subtitle: t('home.hero.slide3.subtitle', locale),
    description: t('home.hero.slide3.description', locale),
    bg: 'from-wrc-earth-800 via-wrc-green-900 to-wrc-earth-700',
    banner: bannerImages[2],
  },
];
---

<section id="hero-section" class="fixed top-0 left-0 w-full h-[100dvh] z-[1]">
  <h1 class="sr-only">{t('home.hero.slide1.title', locale)}</h1>

  <!-- Full-page Fade Carousel -->
  <div class="swiper hero-carousel w-full h-full">
    <div class="swiper-wrapper">
      {slides.map((slide) => (
        <div class="swiper-slide">
          <div class={`relative w-full h-full bg-gradient-to-br ${slide.bg}`}>
            <!-- Banner image (fallback: gradient above shows if image missing) -->
            <div
              class="absolute inset-x-0 bottom-0 bg-cover bg-no-repeat"
              style={`top: ${slide.bgTop || '0'}; background-image: url('/images/home/${slide.banner}'); background-position: ${slide.bgPos || 'center'};`}
              role="img"
              aria-hidden="true"
            />

            <!-- Slightly dark overlay over image for text readability -->
            <div class="absolute inset-0 bg-black/40"></div>

            <!-- Slide content -->
            <div class="absolute inset-0 flex items-center z-10">
              <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-16 w-full">
                <h2 class="hero-title text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-extrabold text-white leading-tight max-w-4xl">
                  {slide.title}
                </h2>
                <p class="hero-subtitle mt-3 text-lg sm:text-xl md:text-2xl text-white font-heading font-semibold">
                  {slide.subtitle}
                </p>
                <p class="hero-description mt-2 text-sm sm:text-base md:text-lg text-white/95 max-w-2xl">
                  {slide.description}
                </p>
                <div class="mt-8 flex flex-col sm:flex-row gap-4">
                  <Button href={`${prefix}/register`} variant="primary" size="lg">
                    {t('common.registerNow', locale)}
                  </Button>
                  <Button href={`${prefix}/about`} variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">
                    {t('common.learnMore', locale)}
                  </Button>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Pagination -->
    <div class="swiper-pagination hero-pagination"></div>
  </div>

  <!-- Bottom wave SVG — small on left, gradually bigger on right -->
  <div class="absolute bottom-0 left-0 right-0 z-20 leading-[0]">
    <svg viewBox="0 0 1440 180" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 150 C120 143 240 155 360 140 C480 128 600 145 720 125 C840 105 960 128 1080 98 C1200 72 1320 100 1440 60 V180 H0Z" fill="white" opacity="0.15"/>
      <path d="M0 156 C120 150 240 160 360 148 C480 138 600 152 720 135 C840 120 960 140 1080 114 C1200 92 1320 118 1440 80 V180 H0Z" fill="white" opacity="0.3"/>
      <path d="M0 163 C120 158 240 166 360 158 C480 150 600 162 720 148 C840 136 960 152 1080 132 C1200 114 1320 136 1440 100 V180 H0Z" fill="white" opacity="0.6"/>
      <path d="M0 170 C120 166 240 172 360 167 C480 162 600 170 720 160 C840 152 960 164 1080 150 C1200 138 1320 154 1440 125 V180 H0Z" fill="white"/>
    </svg>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 z-30 animate-bounce opacity-50" aria-hidden="true">
    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Pagination, Autoplay, EffectFade } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/effect-fade';
  import 'swiper/css/pagination';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  new Swiper('.hero-carousel', {
    modules: [Pagination, Autoplay, EffectFade],
    effect: 'fade',
    fadeEffect: { crossFade: true },
    autoplay: prefersReducedMotion ? false : { delay: 5000, disableOnInteraction: false },
    pagination: { el: '.hero-pagination', clickable: true },
    loop: true,
    a11y: { enabled: true },
  });

  // GSAP parallax on scroll
  if (!prefersReducedMotion) {
    import('gsap').then(({ gsap }) => {
      import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
        gsap.registerPlugin(ScrollTrigger);
        gsap.to('#hero-section', {
          scale: 0.92,
          opacity: 0.4,
          ease: 'none',
          scrollTrigger: {
            trigger: '#hero-section',
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
        });
      });
    });
  }
</script>

<style>
  /* Text shadows for readability on any banner */
  :global(.hero-title) {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8), 0 2px 8px rgba(0, 0, 0, 0.6), 0 4px 16px rgba(0, 0, 0, 0.4);
  }
  :global(.hero-subtitle) {
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8), 0 2px 6px rgba(0, 0, 0, 0.5);
  }
  :global(.hero-description) {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7), 0 2px 6px rgba(0, 0, 0, 0.5);
  }

  /* Pagination dots */
  .hero-pagination {
    position: absolute !important;
    bottom: 8rem !important;
    z-index: 25;
  }
  :global(.hero-pagination .swiper-pagination-bullet) {
    background: white !important;
    opacity: 0.4;
    width: 10px;
    height: 10px;
    transition: opacity 0.3s, transform 0.3s;
  }
  :global(.hero-pagination .swiper-pagination-bullet-active) {
    opacity: 1;
    transform: scale(1.3);
  }
</style>
