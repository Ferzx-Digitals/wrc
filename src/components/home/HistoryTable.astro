---
import { getLocaleFromUrl, t } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);

const congresses = [
  { edition: '1st', year: 1995, location: 'Zakopane', country: 'Poland', emoji: '🏔️', flag: '🇵🇱', color: '#2563eb' },
  { edition: '2nd', year: 1997, location: 'San José', country: 'Costa Rica', emoji: '🌋', flag: '🇨🇷', color: '#16a34a' },
  { edition: '3rd', year: 2000, location: 'Kruger', country: 'South Africa', emoji: '🦁', flag: '🇿🇦', color: '#d97706' },
  { edition: '4th', year: 2003, location: 'Melbourne', country: 'Australia', emoji: '🦘', flag: '🇦🇺', color: '#0284c7' },
  { edition: '5th', year: 2006, location: 'Stirling', country: 'Scotland', emoji: '🏰', flag: '🏴󠁧󠁢󠁳󠁣󠁴󠁿', color: '#4f46e5' },
  { edition: '6th', year: 2009, location: 'Santa Cruz', country: 'Bolivia', emoji: '🦙', flag: '🇧🇴', color: '#dc2626' },
  { edition: '7th', year: 2012, location: 'Arusha', country: 'Tanzania', emoji: '🐘', flag: '🇹🇿', color: '#ca8a04' },
  { edition: '8th', year: 2016, location: 'Estes Park', country: 'USA', emoji: '🦅', flag: '🇺🇸', color: '#475569' },
  { edition: '9th', year: 2019, location: 'Chitwan', country: 'Nepal', emoji: '🐅', flag: '🇳🇵', color: '#ea580c' },
  { edition: '10th', year: 2024, location: 'Aix-les-Bains', country: 'France', emoji: '🏞️', flag: '🇫🇷', color: '#e11d48' },
];
---

<section class="py-16 md:py-20 relative overflow-hidden bg-gradient-to-b from-wrc-green-50/50 to-gray-50">
  <div class="absolute inset-0 nature-texture" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-wrc-green-900 mb-4">
      {t('home.history.title', locale)}
    </h2>

    <!-- Decorative divider -->
    <div class="flex items-center justify-center gap-2 mb-10" aria-hidden="true">
      <div class="h-px w-12 bg-wrc-green-300"></div>
      <svg class="w-5 h-5 text-wrc-green-500" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M10 2 Q15 8 15 13 Q14 17 10 19 Q6 17 5 13 Q5 8 10 2Z" />
      </svg>
      <div class="h-px w-12 bg-wrc-green-300"></div>
    </div>

    <!-- Horizontal scrollable timeline -->
    <div class="relative">
      <!-- Scroll arrows -->
      <div class="hidden md:flex absolute -left-2 top-1/2 -translate-y-1/2 z-10">
        <button class="timeline-scroll-left w-8 h-8 rounded-full bg-white/90 shadow-md flex items-center justify-center text-wrc-green-700 hover:bg-wrc-green-50 transition-colors" aria-label="Scroll left">
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
        </button>
      </div>
      <div class="hidden md:flex absolute -right-2 top-1/2 -translate-y-1/2 z-10">
        <button class="timeline-scroll-right w-8 h-8 rounded-full bg-white/90 shadow-md flex items-center justify-center text-wrc-green-700 hover:bg-wrc-green-50 transition-colors" aria-label="Scroll right">
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
        </button>
      </div>

      <div class="timeline-container overflow-x-auto pb-6 -mx-4 px-4">
        <div class="flex items-start gap-0 min-w-max pt-4">
          {congresses.map((c, i) => (
            <div
              class="timeline-item relative flex flex-col items-center cursor-pointer"
              data-index={i}
              data-emoji={c.emoji}
              data-edition={c.edition}
              data-location={c.location}
              data-country={c.country}
              data-year={c.year}
              data-color={c.color}
            >
              <!-- Emoji circle -->
              <div class="timeline-emoji w-14 h-14 md:w-16 md:h-16 rounded-full bg-white shadow-md border-2 border-wrc-green-200 flex items-center justify-center text-2xl md:text-3xl hover:shadow-lg hover:scale-110 hover:border-wrc-green-400 transition-all duration-200 z-10">
                {c.emoji}
              </div>

              <!-- Connector line -->
              <div class="w-px h-6 bg-wrc-green-300"></div>

              <!-- Timeline dot -->
              <div class="w-4 h-4 rounded-full bg-wrc-green-500 border-2 border-white shadow-sm z-10"></div>

              <!-- Year & location label -->
              <div class="mt-3 text-center w-28 md:w-32">
                <p class="font-heading font-bold text-sm text-wrc-green-800">{c.year}</p>
                <p class="text-xs text-gray-500 mt-0.5 leading-tight">{c.location}</p>
                <p class="text-xs text-gray-400">{c.flag} {c.country}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-container {
    scrollbar-width: thin;
    scrollbar-color: #86efac transparent;
  }
  .timeline-container::-webkit-scrollbar {
    height: 4px;
  }
  .timeline-container::-webkit-scrollbar-track {
    background: transparent;
  }
  .timeline-container::-webkit-scrollbar-thumb {
    background: #86efac;
    border-radius: 4px;
  }
  .timeline-item {
    padding: 0 1rem;
    min-width: 8rem;
  }
  @media (min-width: 768px) {
    .timeline-item {
      padding: 0 1.25rem;
      min-width: 9rem;
    }
  }

  @keyframes tooltip-drop {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .timeline-tooltip-visible {
    animation: tooltip-drop 0.2s ease-out forwards;
  }
</style>

<script>
  // Create tooltip on document.body so it's never clipped by overflow
  const tooltip = document.createElement('div');
  tooltip.id = 'tl-tip';
  tooltip.style.cssText = 'position:fixed;z-index:9999;pointer-events:none;opacity:0;';
  tooltip.innerHTML = `
    <div style="width:224px;border-radius:12px;overflow:hidden;box-shadow:0 20px 40px rgba(0,0,0,0.25);" id="tl-card">
      <div style="height:128px;display:flex;align-items:center;justify-content:center;" id="tl-img">
        <span style="font-size:3.5rem;" id="tl-emoji"></span>
      </div>
      <div style="padding:12px;color:white;">
        <p style="font-family:Montserrat,sans-serif;font-weight:700;font-size:14px;" id="tl-title"></p>
        <p style="font-size:12px;opacity:0.8;" id="tl-loc"></p>
        <p style="font-size:12px;opacity:0.6;margin-top:4px;" id="tl-year"></p>
      </div>
    </div>
    <div style="display:flex;justify-content:center;">
      <div style="width:12px;height:12px;transform:rotate(45deg);margin-top:-6px;" id="tl-arrow"></div>
    </div>
  `;
  document.body.appendChild(tooltip);

  const card = document.getElementById('tl-card')!;
  const img = document.getElementById('tl-img')!;
  const emoji = document.getElementById('tl-emoji')!;
  const title = document.getElementById('tl-title')!;
  const loc = document.getElementById('tl-loc')!;
  const year = document.getElementById('tl-year')!;
  const arrow = document.getElementById('tl-arrow')!;

  const items = document.querySelectorAll('.timeline-item');

  items.forEach((item) => {
    const el = item as HTMLElement;

    el.addEventListener('mouseenter', () => {
      const color = el.dataset.color || '#166534';

      emoji.textContent = el.dataset.emoji || '';
      title.textContent = `${el.dataset.edition} WRC`;
      loc.textContent = `${el.dataset.location}, ${el.dataset.country}`;
      year.textContent = el.dataset.year || '';
      card.style.background = color;
      img.style.background = `linear-gradient(135deg, ${color}, ${color}cc)`;
      arrow.style.background = color;

      // Position: anchor to top-center of emoji circle
      const circle = el.querySelector('.timeline-emoji') as HTMLElement;
      const rect = circle.getBoundingClientRect();
      const tipW = 224;
      const tipH = tooltip.offsetHeight || 210;

      const left = Math.max(8, Math.min(
        rect.left + rect.width / 2 - tipW / 2,
        window.innerWidth - tipW - 8
      ));
      const top = rect.top - tipH - 8;

      tooltip.style.left = left + 'px';
      tooltip.style.top = top + 'px';
      tooltip.style.opacity = '1';
      tooltip.style.transform = 'translateY(0)';
      tooltip.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
    });

    el.addEventListener('mouseleave', () => {
      tooltip.style.opacity = '0';
      tooltip.style.transform = 'translateY(-8px)';
    });
  });

  // Scroll buttons
  const container = document.querySelector('.timeline-container') as HTMLElement;
  const scrollLeftBtn = document.querySelector('.timeline-scroll-left');
  const scrollRightBtn = document.querySelector('.timeline-scroll-right');

  if (container && scrollLeftBtn && scrollRightBtn) {
    scrollLeftBtn.addEventListener('click', () => {
      container.scrollBy({ left: -280, behavior: 'smooth' });
    });
    scrollRightBtn.addEventListener('click', () => {
      container.scrollBy({ left: 280, behavior: 'smooth' });
    });
  }

  // Hide on scroll
  container?.addEventListener('scroll', () => {
    tooltip.style.opacity = '0';
  });
</script>
