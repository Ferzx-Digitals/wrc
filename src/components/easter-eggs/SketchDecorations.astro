---
/**
 * Pencil-sketch style decorative SVG elements (butterflies, leaves, birds, ferns)
 * positioned absolutely around sections. Use inside a relative-positioned parent.
 *
 * Props:
 *  - variant: which set of decorations to show
 *  - color: stroke/fill color (default: currentColor)
 */
interface Props {
  variant?: 'tropical' | 'waterfall' | 'forest' | 'minimal';
  color?: string;
  class?: string;
}

const { variant = 'tropical', color = 'currentColor', class: className = '' } = Astro.props;
---

<div class:list={['absolute inset-0 overflow-hidden pointer-events-none', className]} aria-hidden="true">
  <!-- SVG filter for pencil-sketch effect -->
  <svg class="absolute w-0 h-0">
    <defs>
      <filter id="sketch-filter">
        <feTurbulence type="turbulence" baseFrequency="0.03" numOctaves="4" result="noise"/>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.5" xChannelSelector="R" yChannelSelector="G"/>
      </filter>
    </defs>
  </svg>

  {variant === 'tropical' && (
    <>
      <!-- Butterfly top-right -->
      <svg class="absolute top-[8%] right-[8%] w-16 h-16 md:w-20 md:h-20 sketch-float opacity-[0.10]" viewBox="0 0 60 60" fill="none" stroke={color} stroke-width="1.2">
        <path d="M30 15 Q20 5 10 15 Q5 25 15 30 Q20 32 30 30" />
        <path d="M30 15 Q40 5 50 15 Q55 25 45 30 Q40 32 30 30" />
        <path d="M30 30 Q25 40 20 48 Q18 52 22 50 Q26 48 30 42" />
        <path d="M30 30 Q35 40 40 48 Q42 52 38 50 Q34 48 30 42" />
        <line x1="30" y1="12" x2="25" y2="5" />
        <line x1="30" y1="12" x2="35" y2="5" />
      </svg>

      <!-- Monstera leaf left -->
      <svg class="absolute top-[25%] left-[3%] w-20 h-20 md:w-28 md:h-28 sketch-float-delayed opacity-[0.08] -rotate-12" viewBox="0 0 80 80" fill="none" stroke={color} stroke-width="1.3">
        <path d="M40 75 Q38 60 35 45 Q32 35 35 25 Q38 15 42 10 Q48 5 52 10 Q58 18 55 28 Q52 35 50 40 Q48 50 42 60 Q40 68 40 75Z" />
        <path d="M38 50 Q32 48 28 52" />
        <path d="M36 38 Q28 35 24 38" />
        <path d="M37 28 Q32 24 28 26" />
        <path d="M44 40 Q50 38 54 42" />
        <path d="M46 30 Q52 28 56 32" />
        <line x1="40" y1="75" x2="40" y2="10" stroke-dasharray="2 3" opacity="0.5" />
      </svg>

      <!-- Hummingbird right-mid -->
      <svg class="absolute top-[55%] right-[5%] w-14 h-14 md:w-18 md:h-18 sketch-float opacity-[0.10]" viewBox="0 0 50 50" fill="none" stroke={color} stroke-width="1.2">
        <path d="M15 25 Q10 20 12 15 Q15 10 20 12 Q25 14 22 20 Q20 24 15 25" />
        <path d="M22 20 L38 18" />
        <path d="M15 25 Q12 30 15 35 Q18 32 20 28 Q18 26 15 25" />
        <path d="M20 28 Q25 35 22 40" />
        <circle cx="17" cy="16" r="1" fill={color} />
      </svg>

      <!-- Fern frond bottom-left -->
      <svg class="absolute bottom-[15%] left-[6%] w-16 h-24 md:w-20 md:h-32 opacity-[0.08] rotate-6" viewBox="0 0 40 70" fill="none" stroke={color} stroke-width="1">
        <path d="M20 65 Q19 50 18 35 Q17 20 20 8" />
        <path d="M18 55 Q12 52 8 55" /><path d="M18 48 Q10 44 6 47" />
        <path d="M18 40 Q11 36 7 38" /><path d="M17 32 Q12 28 8 30" />
        <path d="M18 24 Q13 20 10 22" /><path d="M19 16 Q15 12 12 14" />
        <path d="M19 55 Q25 52 28 55" /><path d="M19 48 Q26 44 30 47" />
        <path d="M19 40 Q26 36 30 38" /><path d="M19 32 Q25 28 28 30" />
        <path d="M19 24 Q24 20 27 22" /><path d="M20 16 Q24 12 27 14" />
      </svg>

      <!-- Small butterfly bottom-right -->
      <svg class="absolute bottom-[20%] right-[12%] w-10 h-10 md:w-14 md:h-14 sketch-float-delayed opacity-[0.08] rotate-12" viewBox="0 0 40 40" fill="none" stroke={color} stroke-width="1">
        <path d="M20 12 Q14 6 8 12 Q5 18 12 22 Q16 23 20 20" />
        <path d="M20 12 Q26 6 32 12 Q35 18 28 22 Q24 23 20 20" />
        <path d="M20 20 Q18 28 16 32" /><path d="M20 20 Q22 28 24 32" />
      </svg>
    </>
  )}

  {variant === 'waterfall' && (
    <>
      <!-- Water droplets scattered -->
      <svg class="absolute top-[10%] right-[15%] w-8 h-12 opacity-[0.10] sketch-float" viewBox="0 0 20 30" fill="none" stroke={color} stroke-width="1">
        <path d="M10 5 Q6 12 6 18 Q6 24 10 26 Q14 24 14 18 Q14 12 10 5Z" />
      </svg>
      <svg class="absolute top-[30%] left-[10%] w-6 h-10 opacity-[0.08] sketch-float-delayed" viewBox="0 0 20 30" fill="none" stroke={color} stroke-width="1">
        <path d="M10 5 Q6 12 6 18 Q6 24 10 26 Q14 24 14 18 Q14 12 10 5Z" />
      </svg>

      <!-- Orchid -->
      <svg class="absolute bottom-[25%] right-[6%] w-16 h-16 md:w-20 md:h-20 opacity-[0.10]" viewBox="0 0 50 50" fill="none" stroke={color} stroke-width="1.2">
        <path d="M25 20 Q20 10 15 15 Q12 20 18 24 Q22 26 25 20" />
        <path d="M25 20 Q30 10 35 15 Q38 20 32 24 Q28 26 25 20" />
        <path d="M25 20 Q20 25 18 32 Q17 36 22 34 Q25 32 25 28" />
        <path d="M25 20 Q30 25 32 32 Q33 36 28 34 Q25 32 25 28" />
        <path d="M25 28 L25 45" />
        <circle cx="25" cy="20" r="2" fill={color} opacity="0.3" />
      </svg>

      <!-- Toucan silhouette left -->
      <svg class="absolute top-[15%] left-[5%] w-18 h-18 md:w-24 md:h-24 opacity-[0.07] -scale-x-100" viewBox="0 0 60 60" fill="none" stroke={color} stroke-width="1.3">
        <path d="M35 20 Q30 15 25 18 Q20 22 22 28 Q24 32 30 30 Q35 28 35 20Z" />
        <path d="M25 18 L10 15 Q8 18 12 20 Q16 22 22 22" />
        <circle cx="30" cy="22" r="1.5" fill={color} />
        <path d="M30 30 Q28 38 25 42 Q22 45 28 44 Q32 42 30 38" />
        <path d="M35 24 Q40 22 44 26 Q42 30 38 28" />
        <path d="M25 42 Q22 48 25 50" /><path d="M30 40 Q32 46 30 48" />
      </svg>
    </>
  )}

  {variant === 'forest' && (
    <>
      <!-- Pine/fir branch top-right -->
      <svg class="absolute top-[5%] right-[4%] w-20 h-28 md:w-24 md:h-32 opacity-[0.08] rotate-12" viewBox="0 0 50 70" fill="none" stroke={color} stroke-width="1.2">
        <path d="M25 5 L25 65" />
        <path d="M25 12 Q18 15 12 12" /><path d="M25 12 Q32 15 38 12" />
        <path d="M25 20 Q16 24 8 20" /><path d="M25 20 Q34 24 42 20" />
        <path d="M25 28 Q14 33 6 28" /><path d="M25 28 Q36 33 44 28" />
        <path d="M25 36 Q15 42 8 36" /><path d="M25 36 Q35 42 42 36" />
        <path d="M25 44 Q16 50 10 44" /><path d="M25 44 Q34 50 40 44" />
        <path d="M25 52 Q18 57 12 52" /><path d="M25 52 Q32 57 38 52" />
      </svg>

      <!-- Small bird -->
      <svg class="absolute top-[40%] left-[4%] w-12 h-10 opacity-[0.10] sketch-float" viewBox="0 0 40 30" fill="none" stroke={color} stroke-width="1.2">
        <path d="M5 15 Q10 8 18 12 Q22 14 25 12 Q30 8 35 12 Q32 18 28 16 Q24 18 20 16 Q15 18 10 16 Q6 18 5 15Z" />
        <circle cx="12" cy="13" r="1" fill={color} />
        <path d="M5 15 L2 14" />
      </svg>

      <!-- Leaf cluster bottom-right -->
      <svg class="absolute bottom-[10%] right-[8%] w-16 h-16 md:w-22 md:h-22 opacity-[0.08] -rotate-6" viewBox="0 0 50 50" fill="none" stroke={color} stroke-width="1">
        <path d="M25 10 Q33 18 35 28 Q33 35 25 40 Q17 35 15 28 Q17 18 25 10Z" />
        <path d="M25 40 Q25 30 25 18" stroke-dasharray="2 2" opacity="0.5" />
        <path d="M20 30 Q15 28 12 30" /><path d="M30 30 Q35 28 38 30" />
      </svg>
    </>
  )}

  {variant === 'minimal' && (
    <>
      <!-- Single leaf top-right -->
      <svg class="absolute top-[10%] right-[6%] w-14 h-14 md:w-18 md:h-18 opacity-[0.08] rotate-45" viewBox="0 0 40 40" fill="none" stroke={color} stroke-width="1">
        <path d="M20 5 Q28 13 30 22 Q28 30 20 35 Q12 30 10 22 Q12 13 20 5Z" />
        <path d="M20 35 L20 12" stroke-dasharray="2 2" opacity="0.5" />
      </svg>

      <!-- Small butterfly bottom-left -->
      <svg class="absolute bottom-[15%] left-[8%] w-10 h-10 opacity-[0.07] sketch-float" viewBox="0 0 40 40" fill="none" stroke={color} stroke-width="1">
        <path d="M20 12 Q14 6 8 12 Q5 18 12 22 Q16 23 20 20" />
        <path d="M20 12 Q26 6 32 12 Q35 18 28 22 Q24 23 20 20" />
        <path d="M20 20 Q18 28 16 32" /><path d="M20 20 Q22 28 24 32" />
      </svg>
    </>
  )}
</div>
