---
interface Props {
  variant?: 'jungle' | 'wave' | 'waterfall';
  flip?: boolean;
  class?: string;
}

const { variant = 'jungle', flip = false, class: className = '' } = Astro.props;
---

{variant === 'jungle' ? (
  <div class:list={['w-full overflow-hidden text-wrc-green-900 leading-[0]', flip && 'rotate-180', className]}>
    <svg viewBox="0 0 1440 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto" preserveAspectRatio="none" aria-hidden="true">
      <!-- Layer 1: Distant treeline (lightest) -->
      <g opacity="0.3">
        <path d="M0 160 Q30 120 60 140 Q90 100 120 130 Q150 80 180 120 Q210 70 240 110 Q270 60 300 100 Q330 70 360 95 Q390 55 420 90 Q450 65 480 100 Q510 50 540 85 Q570 60 600 95 Q630 55 660 80 Q690 50 720 85 Q750 60 780 90 Q810 50 840 80 Q870 55 900 85 Q930 45 960 75 Q990 55 1020 85 Q1050 60 1080 90 Q1110 55 1140 80 Q1170 50 1200 75 Q1230 55 1260 85 Q1290 60 1320 90 Q1350 70 1380 95 Q1410 80 1440 100 V200 H0Z" fill="currentColor"/>
      </g>

      <!-- Layer 2: Mid-distance trees -->
      <g opacity="0.5">
        <!-- Ground line -->
        <path d="M0 175 Q60 155 120 165 Q180 145 240 155 Q300 135 360 150 Q420 130 480 145 Q540 125 600 140 Q660 130 720 142 Q780 125 840 138 Q900 120 960 135 Q1020 125 1080 140 Q1140 130 1200 142 Q1260 128 1320 140 Q1380 135 1440 145 V200 H0Z" fill="currentColor"/>
        <!-- Palm tree 1 -->
        <path d="M160 155 Q162 130 158 105 Q156 90 160 80" stroke="currentColor" stroke-width="4" fill="none"/>
        <path d="M160 80 Q140 70 120 78 M160 80 Q145 65 130 60 M160 80 Q170 62 185 58 M160 80 Q180 70 195 75 M160 80 Q155 60 150 50 M160 80 Q168 58 175 48" stroke="currentColor" stroke-width="2.5" fill="none"/>
        <!-- Broad tree 1 -->
        <ellipse cx="380" cy="120" rx="35" ry="30" fill="currentColor"/>
        <rect x="377" y="140" width="6" height="18" fill="currentColor"/>
        <!-- Palm tree 2 -->
        <path d="M600 140 Q602 115 598 90 Q596 75 600 65" stroke="currentColor" stroke-width="4" fill="none"/>
        <path d="M600 65 Q580 55 560 63 M600 65 Q585 50 570 45 M600 65 Q610 47 625 43 M600 65 Q620 55 635 60 M600 65 Q595 45 590 35 M600 65 Q608 43 615 33" stroke="currentColor" stroke-width="2.5" fill="none"/>
        <!-- Broad tree 2 -->
        <ellipse cx="850" cy="108" rx="40" ry="32" fill="currentColor"/>
        <rect x="847" y="130" width="6" height="14" fill="currentColor"/>
        <!-- Small tree -->
        <ellipse cx="1100" cy="118" rx="25" ry="22" fill="currentColor"/>
        <rect x="1098" y="135" width="5" height="12" fill="currentColor"/>
        <!-- Palm tree 3 -->
        <path d="M1300 140 Q1302 115 1298 90 Q1296 78 1300 68" stroke="currentColor" stroke-width="3.5" fill="none"/>
        <path d="M1300 68 Q1280 58 1265 65 M1300 68 Q1288 52 1275 48 M1300 68 Q1312 50 1325 46 M1300 68 Q1318 58 1330 62 M1300 68 Q1296 48 1292 40" stroke="currentColor" stroke-width="2" fill="none"/>
      </g>

      <!-- Layer 3: Foreground (darkest, most detailed) -->
      <g opacity="0.85">
        <!-- Ground with bushes -->
        <path d="M0 185 Q15 178 30 182 Q45 170 60 178 Q80 165 100 175 Q115 168 130 178 Q145 172 160 180 Q175 170 190 176 Q210 165 230 175 Q250 168 270 176 Q290 162 310 172 Q330 165 350 175 Q370 168 390 176 Q410 162 430 172 Q450 166 470 174 Q490 160 510 170 Q530 164 550 174 Q570 160 590 170 Q610 163 630 172 Q650 158 670 168 Q690 162 710 172 Q730 158 750 168 Q770 162 790 170 Q810 156 830 166 Q850 160 870 170 Q890 158 910 168 Q930 155 950 165 Q970 160 990 170 Q1010 158 1030 168 Q1050 160 1070 170 Q1090 162 1110 172 Q1130 160 1150 168 Q1170 158 1190 166 Q1210 155 1230 165 Q1250 160 1270 170 Q1290 162 1310 172 Q1330 165 1350 175 Q1370 170 1390 178 Q1410 172 1440 180 V200 H0Z" fill="currentColor"/>

        <!-- Large palm tree left -->
        <path d="M80 175 Q84 145 78 110 Q75 90 82 70 Q84 60 80 50" stroke="currentColor" stroke-width="5" fill="none"/>
        <path d="M80 50 Q55 38 30 48 M80 50 Q60 30 42 22 M80 50 Q75 25 68 12 M80 50 Q90 22 105 15 M80 50 Q100 35 118 40 M80 50 Q105 48 125 55" stroke="currentColor" stroke-width="3" fill="none"/>
        <!-- Hanging frond details -->
        <path d="M42 22 Q38 30 32 35 M68 12 Q62 22 55 28 M105 15 Q110 25 118 30 M118 40 Q125 46 132 48" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.7"/>

        <!-- Broad canopy tree -->
        <ellipse cx="280" cy="140" rx="50" ry="38" fill="currentColor"/>
        <ellipse cx="260" cy="148" rx="30" ry="25" fill="currentColor"/>
        <ellipse cx="305" cy="145" rx="28" ry="22" fill="currentColor"/>
        <rect x="276" y="168" width="8" height="20" fill="currentColor"/>

        <!-- Fern cluster -->
        <path d="M440 176 Q435 160 430 150 M430 150 Q425 148 420 152 M430 150 Q428 145 432 142 M430 150 Q435 148 438 152" stroke="currentColor" stroke-width="2" fill="none"/>
        <path d="M460 176 Q462 158 458 145 M458 145 Q453 143 448 147 M458 145 Q456 140 460 137 M458 145 Q463 143 466 147" stroke="currentColor" stroke-width="2" fill="none"/>

        <!-- Large tree with visible trunk -->
        <path d="M700 170 L700 100 Q700 95 698 92" stroke="currentColor" stroke-width="7" fill="none"/>
        <ellipse cx="700" cy="92" rx="45" ry="35" fill="currentColor"/>
        <ellipse cx="680" cy="98" rx="25" ry="20" fill="currentColor"/>
        <ellipse cx="725" cy="95" rx="22" ry="18" fill="currentColor"/>

        <!-- Bush cluster -->
        <ellipse cx="550" cy="170" rx="25" ry="14" fill="currentColor"/>
        <ellipse cx="570" cy="172" rx="20" ry="12" fill="currentColor"/>

        <!-- Palm tree right -->
        <path d="M950 168 Q954 135 948 100 Q946 82 952 65 Q953 55 950 45" stroke="currentColor" stroke-width="5" fill="none"/>
        <path d="M950 45 Q925 33 900 42 M950 45 Q932 25 915 18 M950 45 Q945 20 938 8 M950 45 Q960 18 975 10 M950 45 Q970 30 988 35 M950 45 Q975 43 995 50" stroke="currentColor" stroke-width="3" fill="none"/>
        <path d="M915 18 Q910 28 904 32 M938 8 Q932 18 925 24 M975 10 Q980 20 988 25 M988 35 Q995 42 1002 44" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.7"/>

        <!-- Bush -->
        <ellipse cx="1050" cy="168" rx="30" ry="16" fill="currentColor"/>
        <ellipse cx="1075" cy="170" rx="22" ry="13" fill="currentColor"/>

        <!-- Canopy tree right -->
        <ellipse cx="1200" cy="138" rx="42" ry="32" fill="currentColor"/>
        <ellipse cx="1180" cy="145" rx="28" ry="22" fill="currentColor"/>
        <ellipse cx="1225" cy="142" rx="25" ry="20" fill="currentColor"/>
        <rect x="1196" y="162" width="8" height="16" fill="currentColor"/>

        <!-- Fern right -->
        <path d="M1380 178 Q1375 162 1370 152 M1370 152 Q1365 150 1360 154 M1370 152 Q1368 147 1372 144 M1370 152 Q1375 150 1378 154" stroke="currentColor" stroke-width="2" fill="none"/>
      </g>

      <!-- Bird silhouettes -->
      <g opacity="0.4">
        <path d="M200 40 Q205 35 210 38 Q215 35 220 40" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <path d="M350 25 Q356 19 362 22 Q368 19 374 25" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <path d="M800 30 Q806 24 812 27 Q818 24 824 30" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <path d="M1050 18 Q1056 12 1062 15 Q1068 12 1074 18" stroke="currentColor" stroke-width="1.5" fill="none"/>
      </g>
    </svg>
  </div>
) : variant === 'wave' ? (
  <div class:list={['w-full overflow-hidden text-wrc-blue-500 leading-[0]', flip && 'rotate-180', className]}>
    <svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto" preserveAspectRatio="none" aria-hidden="true">
      <!-- Mist/spray layer -->
      <g opacity="0.15">
        <circle cx="300" cy="30" r="20" fill="currentColor"/>
        <circle cx="320" cy="25" r="15" fill="currentColor"/>
        <circle cx="700" cy="20" r="18" fill="currentColor"/>
        <circle cx="720" cy="28" r="12" fill="currentColor"/>
        <circle cx="1100" cy="25" r="16" fill="currentColor"/>
      </g>
      <!-- Water waves - 3 layers for depth -->
      <path d="M0 40 C120 20 240 55 360 35 C480 15 600 50 720 30 C840 10 960 45 1080 25 C1200 5 1320 40 1440 20 V100 H0Z" fill="currentColor" opacity="0.2"/>
      <path d="M0 55 C120 40 240 65 360 45 C480 30 600 60 720 40 C840 25 960 55 1080 35 C1200 20 1320 50 1440 35 V100 H0Z" fill="currentColor" opacity="0.4"/>
      <path d="M0 65 C120 55 240 75 360 58 C480 42 600 68 720 52 C840 38 960 62 1080 48 C1200 35 1320 58 1440 48 V100 H0Z" fill="currentColor" opacity="0.6"/>
      <path d="M0 78 C120 70 240 82 360 72 C480 62 600 78 720 68 C840 58 960 75 1080 65 C1200 55 1320 72 1440 62 V100 H0Z" fill="currentColor" opacity="0.85"/>
    </svg>
  </div>
) : (
  <!-- Waterfall variant - vertical water flow with mist -->
  <div class:list={['w-full overflow-hidden leading-[0]', flip && 'rotate-180', className]}>
    <svg viewBox="0 0 1440 150" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto" preserveAspectRatio="none" aria-hidden="true">
      <!-- Rock/cliff edge -->
      <path d="M0 30 Q60 25 120 35 Q180 15 240 28 Q300 10 360 22 Q420 8 480 20 Q540 5 600 18 Q660 8 720 15 Q780 5 840 18 Q900 10 960 22 Q1020 8 1080 20 Q1140 12 1200 25 Q1260 15 1320 28 Q1380 20 1440 30 V0 H0Z" fill="#14532d"/>
      <!-- Water cascading -->
      <g opacity="0.3">
        <path d="M200 30 Q202 60 198 90 Q196 110 200 130" stroke="#3b82f6" stroke-width="3" fill="none"/>
        <path d="M210 28 Q212 55 208 85 Q206 105 210 125" stroke="#3b82f6" stroke-width="2" fill="none"/>
        <path d="M500 20 Q502 50 498 80 Q496 100 500 120" stroke="#3b82f6" stroke-width="3" fill="none"/>
        <path d="M510 18 Q512 48 508 78 Q506 98 510 118" stroke="#3b82f6" stroke-width="2" fill="none"/>
        <path d="M800 15 Q802 45 798 75 Q796 95 800 115" stroke="#3b82f6" stroke-width="3" fill="none"/>
        <path d="M810 12 Q812 42 808 72 Q806 92 810 112" stroke="#3b82f6" stroke-width="2" fill="none"/>
        <path d="M1100 20 Q1102 50 1098 80 Q1096 100 1100 120" stroke="#3b82f6" stroke-width="3" fill="none"/>
        <path d="M1110 18 Q1112 48 1108 78 Q1106 98 1110 118" stroke="#3b82f6" stroke-width="2" fill="none"/>
      </g>
      <!-- Mist at base -->
      <g opacity="0.2">
        <ellipse cx="200" cy="130" rx="40" ry="15" fill="#93c5fd"/>
        <ellipse cx="500" cy="125" rx="50" ry="18" fill="#93c5fd"/>
        <ellipse cx="800" cy="120" rx="45" ry="16" fill="#93c5fd"/>
        <ellipse cx="1100" cy="125" rx="40" ry="15" fill="#93c5fd"/>
      </g>
      <!-- Pool at bottom -->
      <path d="M0 130 C120 120 240 135 360 125 C480 115 600 130 720 120 C840 112 960 128 1080 118 C1200 110 1320 125 1440 115 V150 H0Z" fill="#3b82f6" opacity="0.25"/>
      <path d="M0 140 C120 133 240 142 360 135 C480 128 600 138 720 132 C840 126 960 136 1080 130 C1200 124 1320 134 1440 128 V150 H0Z" fill="#3b82f6" opacity="0.4"/>
    </svg>
  </div>
)}
