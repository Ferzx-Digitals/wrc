---
import { getLocaleFromUrl, t, getLocalizedPath } from '../../i18n/utils';
import { NAV_ITEMS } from '../../utils/constants';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = getLocaleFromUrl(Astro.url);

function localizeHref(href: string): string {
  return `/${locale}${href}`;
}
---

<header id="main-header" class="header sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100 shadow-sm overflow-visible">
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
    <div id="header-nav-inner" class="header__nav-inner flex h-16 items-start justify-between overflow-visible">
      <!-- Logo: large at top of page, shrinks on scroll -->
      <a href={localizeHref('/')} class="header__logo-link flex shrink-0 items-start pb-3 transition-[padding] duration-300" aria-label={t('nav.home', locale)}>
        <img src="/images/logos/wrc.png" alt="11th IRF World Ranger Congress" class="header__logo h-[140px] w-auto object-contain object-left-top rounded-b-xl transition-[height,border-radius] duration-300 ease-out" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex h-16 lg:items-center lg:gap-1">
        {NAV_ITEMS.map((item) => (
          item.children ? (
            <div class="relative group">
              <button
                class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 hover:text-wrc-green-700 transition-colors rounded-md"
                aria-expanded="false"
                aria-haspopup="true"
              >
                {t(item.key, locale)}
                <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="bg-white rounded-lg shadow-lg ring-1 ring-black/5 py-1 min-w-[200px]">
                  {item.children.map((child) => (
                    <a
                      href={localizeHref(child.href)}
                      class="block px-4 py-2 text-sm text-gray-700 hover:bg-wrc-green-50 hover:text-wrc-green-700 transition-colors"
                    >
                      {t(child.key, locale)}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={localizeHref(item.href)}
              class:list={[
                'px-3 py-2 text-sm font-medium rounded-md transition-colors',
                item.highlight
                  ? 'bg-wrc-green-700 text-white hover:bg-wrc-green-800'
                  : 'text-gray-700 hover:text-wrc-green-700',
              ]}
            >
              {t(item.key, locale)}
            </a>
          )
        ))}
        <LanguageSwitcher />
      </div>

      <!-- Mobile menu button -->
      <div class="flex h-16 items-center lg:hidden">
        <button
          id="mobile-menu-toggle"
          class="p-2 rounded-md text-gray-700 hover:bg-gray-100"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" id="menu-open-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 hidden" id="menu-close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden lg:hidden pb-4">
      <div class="space-y-1 pt-2">
        {NAV_ITEMS.map((item) => (
          item.children ? (
            <div class="mobile-dropdown">
              <button
                class="flex w-full items-center justify-between px-3 py-2 text-base font-medium text-gray-700 hover:bg-wrc-green-50 rounded-md"
                data-dropdown-toggle
              >
                {t(item.key, locale)}
                <svg class="w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="hidden pl-4 space-y-1" data-dropdown-content>
                {item.children.map((child) => (
                  <a href={localizeHref(child.href)} class="block px-3 py-2 text-sm text-gray-600 hover:text-wrc-green-700">
                    {t(child.key, locale)}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={localizeHref(item.href)}
              class:list={[
                'block px-3 py-2 text-base font-medium rounded-md',
                item.highlight
                  ? 'bg-wrc-green-700 text-white text-center mt-2'
                  : 'text-gray-700 hover:bg-wrc-green-50',
              ]}
            >
              {t(item.key, locale)}
            </a>
          )
        ))}
      </div>
      <div class="mt-3 px-3">
        <LanguageSwitcher />
      </div>
    </div>
  </nav>
</header>

<style is:global>
  .header--scrolled .header__logo {
    height: 2.5rem; /* h-10 */
    border-radius: 0;
  }
  .header--scrolled .header__logo-link {
    padding-bottom: 0;
  }
  .header--scrolled .header__nav-inner {
    align-items: center;
    padding-top: 0;
  }
</style>

<script>
  const header = document.getElementById('main-header');
  const scrollThreshold = 40;

  function updateHeaderScroll() {
    if (window.scrollY > scrollThreshold) {
      header?.classList.add('header--scrolled');
    } else {
      header?.classList.remove('header--scrolled');
    }
  }

  updateHeaderScroll();
  window.addEventListener('scroll', updateHeaderScroll, { passive: true });

  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    openIcon?.classList.toggle('hidden', isOpen);
    closeIcon?.classList.toggle('hidden', !isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  document.querySelectorAll('[data-dropdown-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling;
      content?.classList.toggle('hidden');
      const svg = btn.querySelector('svg');
      svg?.classList.toggle('rotate-180');
    });
  });
</script>
