---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import { CONTACT_EMAIL } from '../../utils/constants';
import { getLocaleFromUrl } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const faqData = await import('../../content/faq/es.json');
const faqItems = faqData.items;

const categories = [
  { id: 'all', label: 'Todas las Preguntas' },
  { id: 'registration', label: 'Inscripción' },
  { id: 'accommodation', label: 'Alojamiento' },
  { id: 'general', label: 'General' },
  { id: 'payment', label: 'Pagos' },
  { id: 'sponsorship', label: 'Patrocinio' },
];
---

<PageLayout title="Preguntas Frecuentes" description="Encuentre respuestas a las preguntas más comunes sobre el 11° Congreso Mundial de Guardaparques de la IRF — inscripción, alojamiento, viaje, pagos y más.">
  <!-- Hero -->
  <section class="relative py-16 sm:py-20 bg-gradient-to-r from-wrc-green-900/90 to-wrc-green-800/70">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-white mb-4">
        ¿Cómo Podemos Ayudarle?
      </h1>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
        Encuentre respuestas a las preguntas más comunes sobre el Congreso
      </p>
      <!-- Search Bar -->
      <div class="max-w-xl mx-auto">
        <div class="relative">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="faq-search"
            placeholder="Buscar preguntas..."
            class="w-full pl-12 pr-4 py-4 rounded-xl text-gray-900 bg-white shadow-lg focus:outline-none focus:ring-2 focus:ring-wrc-green-500"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Content -->
  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Category Filters -->
      <div class="flex flex-wrap gap-2 mb-8" id="faq-categories">
        {categories.map((cat) => (
          <button
            data-category={cat.id}
            class:list={[
              'px-4 py-2 rounded-full text-sm font-heading font-semibold transition-colors',
              cat.id === 'all'
                ? 'bg-wrc-green-700 text-white'
                : 'bg-gray-100 text-gray-600 hover:bg-gray-200',
            ]}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- FAQ Items -->
      <div id="faq-list" class="space-y-2" role="list">
        {faqItems.map((item) => (
          <details class="group border border-gray-200 rounded-lg overflow-hidden faq-item" data-category={item.category} role="listitem">
            <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-heading font-semibold text-gray-800 hover:bg-gray-50 transition-colors list-none">
              <span class="pr-4">{item.question}</span>
              <svg
                class="w-5 h-5 shrink-0 text-gray-400 transition-transform duration-200 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-5 pb-4 text-gray-600 leading-relaxed text-sm">
              {item.answer}
            </div>
          </details>
        ))}
      </div>

      <!-- No Results -->
      <div id="faq-no-results" class="hidden text-center py-12">
        <p class="text-gray-500 text-lg">No se encontraron preguntas que coincidan con su búsqueda.</p>
        <p class="text-gray-400 text-sm mt-2">Intente con otras palabras clave o navegue por categoría.</p>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-16 bg-gray-50 text-center">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-4">
        ¿Aún tiene preguntas?
      </h2>
      <p class="text-gray-600 mb-6">
        ¿No encuentra lo que busca? Contacte directamente a nuestro equipo.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href={`${prefix}/contact`} variant="primary">
          Contáctenos
        </Button>
        <Button href={`mailto:${CONTACT_EMAIL}`} variant="outline">
          Envíenos un Email
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  const searchInput = document.getElementById('faq-search') as HTMLInputElement;
  const faqItems = document.querySelectorAll('.faq-item');
  const categoryButtons = document.querySelectorAll('#faq-categories button');
  const noResults = document.getElementById('faq-no-results');
  let activeCategory = 'all';

  function filterFAQs() {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;

    faqItems.forEach((item) => {
      const el = item as HTMLElement;
      const category = el.dataset.category || '';
      const text = el.textContent?.toLowerCase() || '';
      const matchesCategory = activeCategory === 'all' || category === activeCategory;
      const matchesSearch = !query || text.includes(query);
      const show = matchesCategory && matchesSearch;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (noResults) {
      noResults.classList.toggle('hidden', visible > 0);
    }
  }

  searchInput?.addEventListener('input', filterFAQs);

  categoryButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = (btn as HTMLElement).dataset.category || 'all';
      categoryButtons.forEach((b) => {
        const isActive = (b as HTMLElement).dataset.category === activeCategory;
        b.classList.toggle('bg-wrc-green-700', isActive);
        b.classList.toggle('text-white', isActive);
        b.classList.toggle('bg-gray-100', !isActive);
        b.classList.toggle('text-gray-600', !isActive);
      });
      filterFAQs();
    });
  });
</script>
