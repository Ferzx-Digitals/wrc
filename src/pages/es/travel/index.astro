---
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import SectionDivider from '../../../components/global/SectionDivider.astro';
import { EXTERNAL_LINKS } from '../../../utils/constants';
import { getLocaleFromUrl } from '../../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const transportOptions = [
  {
    title: 'Por Avión — Aeropuerto Cataratas del Iguazú (IGR)',
    description: 'El aeropuerto más cercano es el Aeropuerto Internacional Cataratas del Iguazú (IGR), ubicado a aproximadamente 20 km del centro de Puerto Iguazú. Múltiples vuelos diarios desde Buenos Aires (1h 50min).',
    icon: '✈️',
    details: 'Aerolíneas: Aerolíneas Argentinas, Flybondi, JetSMART',
  },
  {
    title: 'Vía Brasil — Aeropuerto Foz do Iguaçu (IGU)',
    description: 'El Aeropuerto Internacional de Foz do Iguaçu (IGU) del lado brasileño es otra opción. Ubicado a 30-45 minutos en taxi desde Puerto Iguazú cruzando el puente internacional.',
    icon: '🛫',
    details: 'Conexiones internacionales vía São Paulo y Río de Janeiro',
  },
  {
    title: 'En Autobús',
    description: 'Servicios de autobús de larga distancia desde Buenos Aires a Puerto Iguazú. El viaje toma aproximadamente 18-20 horas. Múltiples compañías operan esta ruta con diferentes niveles de confort.',
    icon: '🚌',
    details: 'Compañías: Vía Bariloche, Crucero del Norte, Río Uruguay',
  },
  {
    title: 'En Auto',
    description: 'Conducir desde Buenos Aires por la Ruta Nacional 12. Distancia total aproximada de 1.300 km (16-18 horas). Autopista bien mantenida a través de la provincia de Misiones.',
    icon: '🚗',
    details: 'Ruta: Buenos Aires → Zárate → Paraná → Posadas → Puerto Iguazú',
  },
  {
    title: 'Vía Paraguay',
    description: 'Cruzar desde Ciudad del Este (Paraguay) por el Puente de la Amistad hacia Foz do Iguaçu (Brasil), luego cruzar a Puerto Iguazú (Argentina). Cruce de la Triple Frontera.',
    icon: '🌉',
    details: 'Pasos fronterizos abiertos las 24 horas, traiga su pasaporte vigente',
  },
];
---

<PageLayout title="Planifique Su Viaje" description="Todo lo que necesita saber sobre cómo viajar a Puerto Iguazú, Argentina para el 11° Congreso Mundial de Guardaparques de la IRF.">
  <!-- Hero -->
  <section class="relative h-[350px] sm:h-[400px]">
    <img src="/images/titles/travel.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative h-full flex items-center">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white">
          Planifique Su Viaje
        </h1>
        <p class="mt-4 text-xl text-white/80 max-w-2xl">
          Cómo llegar a Puerto Iguazú, Argentina — su puerta a la Triple Frontera
        </p>
      </div>
    </div>
  </section>

  <!-- Navigation Tabs -->
  <nav class="bg-white border-b border-gray-200 sticky top-16 z-30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex justify-center gap-1 overflow-x-auto">
        <a href={`${prefix}/travel`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-wrc-green-700 text-wrc-green-700 whitespace-nowrap">
          Logística
        </a>
        <a href={`${prefix}/travel/venue`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          Sede y Alojamiento
        </a>
        <a href={`${prefix}/travel/faqs`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          Preguntas de Viaje
        </a>
      </div>
    </div>
  </nav>

  <!-- Visa Information -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/18.png" alt="" aria-hidden="true" class="absolute right-10 -top-10 h-80 w-auto opacity-50 pointer-events-none rotate-45" />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-heading font-bold text-wrc-green-900 mb-6">
          Información de Visas
        </h2>
        <div class="bg-wrc-blue-50 rounded-xl p-6 border border-wrc-blue-200">
          <div class="flex items-start gap-4">
            <span class="text-3xl" aria-hidden="true">🛂</span>
            <div>
              <h3 class="font-heading font-bold text-wrc-blue-900 mb-2">Verifique Sus Requisitos de Visa</h3>
              <p class="text-gray-600 leading-relaxed mb-4">
                Muchas nacionalidades pueden ingresar a Argentina sin visa u obtener una autorización electrónica
                de viaje (AVE) en línea. Consulte el portal de visas argentino para confirmar los requisitos
                para su nacionalidad. Recomendamos iniciar el proceso de visa con suficiente anticipación.
              </p>
              <Button href={EXTERNAL_LINKS.visaPortal} variant="primary" size="sm">
                Portal de Visas Argentino &rarr;
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 19.png divider -->
  <div class="relative h-48 overflow-hidden">
    <img src="/images/home/19.png" alt="" aria-hidden="true" class="absolute left-0 top-0 h-full w-auto object-cover object-left opacity-50 pointer-events-none" />
  </div>

  <!-- Transport Options -->
  <section class="relative -mt-32 py-16 overflow-visible">
    <img src="/images/home/21.png" alt="" aria-hidden="true" class="absolute -right-20 -bottom-20 h-48 w-auto opacity-50 pointer-events-none z-10" />
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-right text-wrc-green-900 mb-8 max-w-4xl mx-auto">
        Cómo Llegar a Puerto Iguazú
      </h2>
      <div class="max-w-4xl mx-auto">
        <!-- Tabs -->
        <div class="flex justify-end gap-2 mb-6 overflow-x-auto pb-2">
          {transportOptions.map((option, i) => (
            <button
              data-tab={i}
              class:list={[
                'transport-tab flex items-center gap-2 px-4 py-2 rounded-full font-heading font-semibold text-sm whitespace-nowrap transition-all cursor-pointer',
                i === 0 ? 'bg-wrc-green-700 text-white shadow-md' : 'bg-white text-gray-600 hover:bg-gray-100 border border-gray-200'
              ]}
            >
              <span aria-hidden="true">{option.icon}</span>
              <span class="hidden sm:inline">{option.title.split('—')[0].split('—')[0].trim()}</span>
            </button>
          ))}
        </div>
        <!-- Content -->
        <div class="relative min-h-[280px]">
          {transportOptions.map((option, i) => (
            <div data-panel={i} class:list={['transport-panel absolute inset-0 bg-white rounded-xl shadow-md p-8 border border-gray-100 text-center transition-opacity duration-200', i !== 0 && 'opacity-0 pointer-events-none']}>
              <span class="text-4xl block mb-3" aria-hidden="true">{option.icon}</span>
              <h3 class="font-heading font-bold text-xl text-gray-900 mb-3">{option.title}</h3>
              <p class="text-gray-600 leading-relaxed mb-3 max-w-2xl mx-auto">{option.description}</p>
              <p class="text-sm text-wrc-green-700 font-medium">{option.details}</p>
            </div>
          ))}
        </div>
      </div>
      <script>
        document.querySelectorAll('.transport-tab').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = btn.dataset.tab;
            document.querySelectorAll('.transport-tab').forEach(t => {
              t.className = t.className.replace(/bg-wrc-green-700 text-white shadow-md|bg-white text-gray-600 hover:bg-gray-100 border border-gray-200/g, '');
              t.classList.add(...(t.dataset.tab === idx ? ['bg-wrc-green-700','text-white','shadow-md'] : ['bg-white','text-gray-600','hover:bg-gray-100','border','border-gray-200']));
            });
            document.querySelectorAll('.transport-panel').forEach(p => {
              const isActive = p.dataset.panel === idx;
              p.classList.toggle('opacity-0', !isActive);
              p.classList.toggle('pointer-events-none', !isActive);
            });
          });
        });
      </script>
    </div>
  </section>

  <!-- Airlines -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/20.png" alt="" aria-hidden="true" class="absolute -left-64 bottom-8 h-64 w-auto opacity-50 pointer-events-none" />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Aerolíneas que Sirven Iguazú
      </h2>
      <div class="grid sm:grid-cols-3 gap-6 max-w-3xl mx-auto">
        {[
          { name: 'Aerolíneas Argentinas', logo: '/images/airlines/aerolineas-argentinas.png', url: 'https://www.aerolineas.com.ar' },
          { name: 'Flybondi', logo: '/images/airlines/flybondi.png', url: 'https://www.flybondi.com' },
          { name: 'JetSMART', logo: '/images/airlines/jetsmart.png', url: 'https://www.jetsmart.com' },
        ].map((airline) => (
          <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100 text-center flex flex-col items-center">
            <img src={airline.logo} alt={`${airline.name} logo`} class="w-16 h-16 object-contain mb-3" />
            <p class="font-heading font-bold text-gray-900 mb-3">{airline.name}</p>
            <Button href={airline.url} variant="outline" size="sm">
              Visitar Sitio Web &rarr;
            </Button>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
