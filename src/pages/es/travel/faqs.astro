---
import PageLayout from '../../../layouts/PageLayout.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import SectionDivider from '../../../components/global/SectionDivider.astro';
import { getLocaleFromUrl } from '../../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const weatherInfo = [
  { label: 'Temperatura (Máximas)', value: '26-28°C (79-82°F)', icon: '🌡️' },
  { label: 'Temperatura (Mínimas)', value: '17-19°C (63-66°F)', icon: '🌙' },
  { label: 'Precipitaciones', value: '150-200mm / 10-12 días lluviosos', icon: '🌧️' },
  { label: 'Nubosidad', value: '40-50%', icon: '☁️' },
  { label: 'Amanecer / Atardecer', value: '~6:00-6:20 / ~6:00-6:10', icon: '🌅' },
  { label: 'Humedad', value: '70-75%', icon: '💧' },
  { label: 'Viento', value: '10-15 km/h', icon: '💨' },
];

const practicalInfo = [
  {
    question: '¿Qué moneda se usa en Argentina?',
    answer: 'La moneda oficial es el Peso Argentino (ARS). Los dólares estadounidenses y los reales brasileños son comúnmente aceptados en zonas turísticas de Puerto Iguazú. Hay cajeros automáticos disponibles pero pueden tener límites de extracción. Recomendamos traer dólares en efectivo como respaldo.',
  },
  {
    question: '¿Cómo puedo obtener una tarjeta SIM o datos móviles?',
    answer: 'Las operadoras móviles argentinas incluyen Claro, Movistar y Personal. Las tarjetas SIM prepagadas se pueden comprar en el aeropuerto o en tiendas locales. Hay WiFi disponible en la mayoría de los hoteles y en la sede del congreso.',
  },
  {
    question: '¿Qué debo empacar?',
    answer: 'Ropa ligera y transpirable para clima cálido. Una chaqueta impermeable o paraguas (abril puede ser lluvioso). Zapatos cómodos para caminar en las excursiones. Repelente de insectos. Protector solar y sombrero. Un suéter ligero para espacios con aire acondicionado.',
  },
  {
    question: '¿Es seguro beber agua del grifo?',
    answer: 'El agua del grifo en Puerto Iguazú es generalmente segura, pero el agua embotellada está fácilmente disponible y se recomienda para visitantes. El hotel y la sede proporcionarán estaciones de agua.',
  },
  {
    question: '¿Qué tipo de enchufes eléctricos se usan?',
    answer: 'Argentina usa enchufes tipo C y tipo I con 220V / 50Hz. Traiga un adaptador universal. La mayoría de los hoteles proporcionan adaptadores a solicitud.',
  },
  {
    question: '¿Qué idioma se habla?',
    answer: 'El español es el idioma principal. Se habla inglés en lugares turísticos, hoteles y en el congreso. El congreso proporcionará traducción simultánea en inglés, español y francés durante las sesiones plenarias.',
  },
];

const emergencyNumbers = [
  { service: 'Emergencias (Policía/Bomberos/Ambulancia)', number: '911' },
  { service: 'Policía del Turista', number: '+54 3757 420016' },
  { service: 'Hospital SAMIC Iguazú', number: '+54 3757 420288' },
  { service: 'Taxi Puerto Iguazú', number: '+54 3757 422008' },
  { service: 'Info Turística Argentina', number: '0800-555-0016' },
  { service: 'Terminal de Ómnibus', number: '+54 3757 423006' },
];
---

<PageLayout title="Preguntas de Viaje" description="Información práctica para viajar a Puerto Iguazú — clima, moneda, WiFi, números de emergencia y qué empacar.">
  <!-- Hero -->
  <section class="relative h-[350px] sm:h-[400px] bg-gradient-to-r from-wrc-blue-700/90 to-wrc-green-800/70">
    <div class="absolute inset-0 opacity-10">
      <div class="w-full h-full bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2040%2040%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M20%2020.5V18H0v-2h20v-2l-3-3%203-3v-2H0V4h20V1.5L23.5%205%2020%208.5z%22%20fill%3D%22%23fff%22%20fill-opacity%3D%220.2%22%20fill-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E')]"></div>
    </div>
    <div class="relative h-full flex items-center">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white">
          Preguntas de Viaje
        </h1>
        <p class="mt-4 text-xl text-white/80 max-w-2xl">
          Información práctica para preparar su viaje a Puerto Iguazú
        </p>
      </div>
    </div>
  </section>

  <!-- Navigation Tabs -->
  <nav class="bg-white border-b border-gray-200 sticky top-16 z-30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex gap-1 overflow-x-auto">
        <a href={`${prefix}/travel`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          Logística
        </a>
        <a href={`${prefix}/travel/venue`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          Sede y Alojamiento
        </a>
        <a href={`${prefix}/travel/faqs`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-wrc-green-700 text-wrc-green-700 whitespace-nowrap">
          Preguntas de Viaje
        </a>
      </div>
    </div>
  </nav>

  <!-- Weather Section -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-4">
        Clima en Abril
      </h2>
      <p class="text-center text-gray-600 mb-10 max-w-2xl mx-auto">
        Puerto Iguazú en abril es cálido y subtropical con lluvias ocasionales
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
        {weatherInfo.map((info) => (
          <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100 text-center">
            <span class="text-2xl block mb-2" aria-hidden="true">{info.icon}</span>
            <p class="text-xs text-gray-500 uppercase tracking-wide font-semibold mb-1">{info.label}</p>
            <p class="text-gray-900 font-heading font-bold text-sm">{info.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Practical Info Accordion -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Información Práctica
      </h2>
      <Accordion items={practicalInfo} />
    </div>
  </section>

  <SectionDivider variant="jungle" />

  <!-- Emergency Numbers -->
  <section class="py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Números Telefónicos Útiles
      </h2>
      <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
        <table class="w-full">
          <thead>
            <tr class="bg-wrc-green-50">
              <th class="px-6 py-3 text-left text-sm font-heading font-bold text-wrc-green-900">Servicio</th>
              <th class="px-6 py-3 text-left text-sm font-heading font-bold text-wrc-green-900">Número</th>
            </tr>
          </thead>
          <tbody>
            {emergencyNumbers.map((item, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-6 py-3 text-sm text-gray-700">{item.service}</td>
                <td class="px-6 py-3 text-sm font-mono text-wrc-green-700 font-semibold">{item.number}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</PageLayout>
