---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-b from-wrc-green-900 to-wrc-green-800">
    <div class="text-center px-4 py-16">
      <!-- Jungle Scene -->
      <div class="relative max-w-md mx-auto mb-8">
        <svg viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" aria-hidden="true">
          <!-- Sky -->
          <rect width="400" height="200" fill="transparent"/>
          <!-- Moon -->
          <circle cx="320" cy="40" r="25" fill="#fef9c3" opacity="0.3"/>
          <!-- Trees -->
          <path d="M0 200 L20 80 L40 200Z" fill="#14532d" opacity="0.6"/>
          <path d="M30 200 L55 60 L80 200Z" fill="#166534" opacity="0.7"/>
          <path d="M320 200 L345 70 L370 200Z" fill="#14532d" opacity="0.6"/>
          <path d="M350 200 L380 90 L400 200Z" fill="#166534" opacity="0.7"/>
          <!-- Ground -->
          <ellipse cx="200" cy="200" rx="200" ry="30" fill="#14532d" opacity="0.4"/>
          <!-- Lost ranger -->
          <g transform="translate(180, 120)">
            <!-- Body -->
            <rect x="8" y="20" width="24" height="35" rx="4" fill="#8B6F47"/>
            <!-- Head -->
            <circle cx="20" cy="14" r="10" fill="#D4A575"/>
            <!-- Hat -->
            <path d="M8 10 L32 10 L28 4 L12 4Z" fill="#5C4033"/>
            <rect x="6" y="10" width="28" height="3" rx="1" fill="#5C4033"/>
            <!-- Legs -->
            <rect x="12" y="55" width="6" height="15" rx="2" fill="#5C4033"/>
            <rect x="22" y="55" width="6" height="15" rx="2" fill="#5C4033"/>
            <!-- Question mark -->
            <text x="36" y="10" fill="#fef9c3" font-size="20" font-weight="bold" opacity="0.8">?</text>
          </g>
          <!-- Fireflies -->
          <circle cx="100" cy="80" r="2" fill="#fef9c3" opacity="0.6">
            <animate attributeName="opacity" values="0.3;0.8;0.3" dur="2s" repeatCount="indefinite"/>
          </circle>
          <circle cx="280" cy="100" r="2" fill="#fef9c3" opacity="0.6">
            <animate attributeName="opacity" values="0.5;1;0.5" dur="1.5s" repeatCount="indefinite"/>
          </circle>
          <circle cx="150" cy="130" r="1.5" fill="#fef9c3" opacity="0.6">
            <animate attributeName="opacity" values="0.2;0.7;0.2" dur="2.5s" repeatCount="indefinite"/>
          </circle>
        </svg>
      </div>

      <h1 class="text-6xl font-heading font-extrabold text-white mb-4">404</h1>
      <h2 class="text-2xl font-heading font-bold text-wrc-green-200 mb-4">
        You've wandered off the trail!
      </h2>
      <p class="text-wrc-green-300 mb-8 max-w-md mx-auto">
        This page doesn't exist in our protected area. Let's get you back on the right path.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/en/" variant="primary" size="lg">
          Back to Home
        </Button>
        <Button href="/en/faq" variant="outline" size="lg" class="border-white text-white hover:bg-white/10">
          Visit FAQ
        </Button>
      </div>
    </div>
  </main>
</BaseLayout>
