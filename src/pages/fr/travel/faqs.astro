---
import PageLayout from '../../../layouts/PageLayout.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import SectionDivider from '../../../components/global/SectionDivider.astro';
import { getLocaleFromUrl } from '../../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const weatherInfo = [
  { label: 'Température', value: '17-28°C (63-82°F)', icon: '🌡️' },
  { label: 'Précipitations', value: '150-200mm / 10-12 jours de pluie', icon: '🌧️' },
  { label: 'Nébulosité', value: '40-50%', icon: '☁️' },
  { label: 'Lever / Coucher du soleil', value: '~6:00-6:20 / ~6:00-6:10', icon: '🌅' },
  { label: 'Humidité', value: '70-75%', icon: '💧' },
  { label: 'Vent', value: '10-15 km/h', icon: '💨' },
];

const practicalInfo = [
  {
    question: 'Quelle monnaie est utilisée en Argentine ?',
    answer: 'La monnaie officielle est le Peso Argentin (ARS). Les dollars américains et les réaux brésiliens sont couramment acceptés dans les zones touristiques de Puerto Iguazú. Des distributeurs automatiques sont disponibles mais peuvent avoir des limites de retrait. Nous recommandons d\'apporter des dollars en espèces en complément.',
  },
  {
    question: 'Comment obtenir une carte SIM ou des données mobiles ?',
    answer: 'Les opérateurs mobiles argentins comprennent Claro, Movistar et Personal. Les cartes SIM prépayées peuvent être achetées à l\'aéroport ou dans les boutiques locales. Le WiFi est disponible dans la plupart des hôtels et au lieu du congrès.',
  },
  {
    question: 'Que dois-je emporter ?',
    answer: 'Des vêtements légers et respirants pour le temps chaud. Un imperméable ou un parapluie (avril peut être pluvieux). Des chaussures de marche confortables pour les excursions. Du répulsif anti-insectes. De la crème solaire et un chapeau. Un pull léger pour les espaces climatisés.',
  },
  {
    question: 'L\'eau du robinet est-elle potable ?',
    answer: 'L\'eau du robinet à Puerto Iguazú est généralement sûre, mais l\'eau en bouteille est facilement disponible et recommandée pour les visiteurs. L\'hôtel et le lieu du congrès mettront à disposition des fontaines à eau.',
  },
  {
    question: 'Quels types de prises électriques sont utilisés ?',
    answer: 'L\'Argentine utilise des prises de type C et de type I avec 220V / 50Hz. Apportez un adaptateur universel. La plupart des hôtels fournissent des adaptateurs sur demande.',
  },
  {
    question: 'Quelle langue est parlée ?',
    answer: 'L\'espagnol est la langue principale. L\'anglais est parlé dans les lieux touristiques, les hôtels et au congrès. Le congrès proposera une traduction simultanée en anglais, espagnol et français lors des séances plénières.',
  },
];

const emergencyNumbers = [
  { service: 'Urgences (Police/Pompiers/Ambulance)', number: '911' },
  { service: 'Police du Tourisme', number: '+54 3757 420016' },
  { service: 'Hôpital SAMIC Iguazú', number: '+54 3757 420288' },
  { service: 'Taxi Puerto Iguazú', number: '+54 3757 422008' },
  { service: 'Info Touristique Argentine', number: '0800-555-0016' },
  { service: 'Gare Routière', number: '+54 3757 423006' },
];
---

<PageLayout title="FAQ Voyage" description="Informations pratiques pour voyager à Puerto Iguazú — météo, monnaie, WiFi, numéros d'urgence et quoi emporter.">
  <!-- Hero -->
  <section class="relative h-[350px] sm:h-[400px]">
    <img src="/images/titles/travel-faq.jpg" alt="" class="absolute inset-0 w-full h-full object-cover -scale-x-100" style="object-position: 30% 70%;" />
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative h-full flex items-center">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full text-right">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white">
          FAQ Voyage
        </h1>
        <p class="mt-4 text-xl text-white/80 max-w-2xl ml-auto">
          Informations pratiques pour préparer votre voyage à Puerto Iguazú
        </p>
      </div>
    </div>
  </section>

  <!-- Navigation Tabs -->
  <nav class="bg-white border-b border-gray-200 sticky top-16 z-30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex justify-center gap-1 overflow-x-auto">
        <a href={`${prefix}/travel`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          Logistique
        </a>
        <a href={`${prefix}/travel/venue`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          Lieu et Hébergement
        </a>
        <a href={`${prefix}/travel/faqs`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-wrc-green-700 text-wrc-green-700 whitespace-nowrap">
          FAQ Voyage
        </a>
      </div>
    </div>
  </nav>

  <!-- Weather Section -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/16.png" alt="" aria-hidden="true" class="absolute left-0 top-0 h-full w-auto object-cover object-left opacity-50 pointer-events-none" />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-4">
        Météo en Avril
      </h2>
      <p class="text-center text-gray-600 mb-10 max-w-2xl mx-auto">
        Puerto Iguazú en avril est chaud et subtropical avec des averses occasionnelles
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        {weatherInfo.map((info) => (
          <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100 text-center">
            <span class="text-2xl block mb-2" aria-hidden="true">{info.icon}</span>
            <p class="text-xs text-gray-500 uppercase tracking-wide font-semibold mb-1">{info.label}</p>
            <p class="text-gray-900 font-heading font-bold text-sm">{info.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Practical Info Accordion -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Informations Pratiques
      </h2>
      <div class="grid md:grid-cols-2 gap-4">
        <Accordion items={practicalInfo.slice(0, 3)} />
        <Accordion items={practicalInfo.slice(3)} />
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" class="bg-gray-50" />

  <!-- Emergency Numbers -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/17.png" alt="" aria-hidden="true" class="absolute right-0 bottom-0 h-full w-auto object-cover object-right-bottom opacity-30 pointer-events-none" />
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Numéros de Téléphone Utiles
      </h2>
      <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
        <table class="w-full">
          <thead>
            <tr class="bg-wrc-green-50">
              <th class="px-6 py-3 text-left text-sm font-heading font-bold text-wrc-green-900">Service</th>
              <th class="px-6 py-3 text-left text-sm font-heading font-bold text-wrc-green-900">Numéro</th>
            </tr>
          </thead>
          <tbody>
            {emergencyNumbers.map((item, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-6 py-3 text-sm text-gray-700">{item.service}</td>
                <td class="px-6 py-3 text-sm font-mono text-wrc-green-700 font-semibold">{item.number}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</PageLayout>
