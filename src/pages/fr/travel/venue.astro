---
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import MapEmbed from '../../../components/ui/MapEmbed.astro';
import SectionDivider from '../../../components/global/SectionDivider.astro';
import { VENUE } from '../../../utils/constants';
import { getLocaleFromUrl } from '../../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const featuredHotels = [
  {
    name: 'Hotel Amerian Portal del Iguazu',
    stars: 5,
    rooms: 117,
    address: 'Av. Tres Fronteras 780, Puerto Iguazu',
    features: ['2 Restaurants', '2 Bars', 'Spa et Bien-être', 'Vues sur la Triple Frontière', 'Hôtel du Lieu du Congrès'],
    mapUrl: 'https://maps.app.goo.gl/6RD7UotVJshHRrfr8',

    rate: 'USD 130 + TVA',
    rateNotes: [
      'Les tarifs sont exprimés en dollars américains.',
      'Les tarifs sont par chambre, par nuit.',
      'Arrivée : 14h00 – Départ : 11h00.',
      'Tarifs nets.',
    ],
    services: [
      'Petit-déjeuner buffet',
      'Accès Internet Wi-Fi',
      'Accès à la piscine extérieure avec cascade, bars, solarium et jacuzzi',
      'Accès à la piscine intérieure chauffée avec jacuzzi',
      'Accès au sauna du Spa Yvy Maraý',
      'Courts de tennis et de football',
      'Espace de loisirs',
      'Centre d\'affaires',
    ],
  },
  {
    name: 'Iguazu Grand Resort Spa & Casino',
    stars: 5,
    rooms: 122,
    address: 'Ruta 12 Km 1640, Puerto Iguazu',
    features: ['Casino', 'Spa Complet', 'Piscine et Jardins', 'Terrain de Golf', 'Vues sur le Fleuve'],
    mapUrl: 'https://maps.app.goo.gl/iguazugrand',
  },
  {
    name: 'Loi Suites Iguazu Hotel',
    stars: 5,
    rooms: 162,
    address: 'Selva Iryapu S/N, Puerto Iguazu',
    features: ['Cadre de Forêt Tropicale', 'Piscine à Débordement', 'Spa', 'Sentiers Nature', 'Éco-Luxe'],
    mapUrl: 'https://maps.app.goo.gl/loisuites',
  },
];

const additionalHotels = [
  { name: 'Mercure Iguazu Hotel Iru', stars: 5, rooms: 134, location: 'Ruta 12, Puerto Iguazu' },
  { name: 'Panoramic Grand Iguazu', stars: 4, rooms: 97, location: 'Paraguay 372, Puerto Iguazu' },
  { name: 'Saint George Hotel', stars: 3, rooms: 60, location: 'Av. Córdoba 148, Puerto Iguazu' },
  { name: 'Hotel Jardín de Iguazu', stars: 3, rooms: 60, location: 'Av. Córdoba 441, Puerto Iguazu' },
  { name: 'Jasy Hotel', stars: 2, rooms: 39, location: 'San Lorenzo 154, Puerto Iguazu' },
];

const basicPackageItems = [
  'Chutes d\'Iguazú — Côté Argentin',
  'Hito Tres Fronteras (Monument de la Triple Frontière)',
  'Visite de la Ville de Puerto Iguazú',
  'Visite du Parc Aripuca',
];

const paidTours = [
  { name: 'Chutes d\'Iguazú — Côté Brésilien', price: 45, description: 'Excursion d\'une journée complète côté brésilien des chutes avec vues panoramiques.' },
  { name: 'Parc des Oiseaux (Parque das Aves)', price: 20, description: 'Volière interactive avec plus de 1 400 oiseaux de 150 espèces.' },
  { name: 'Chutes d\'Iguazú + Parc des Oiseaux Combo', price: 55, description: 'Visite combinée des chutes brésiliennes et du Parc des Oiseaux en une journée.' },
  { name: 'Barrage d\'Itaipu', price: 45, description: 'Visitez le plus grand barrage hydroélectrique du monde à la frontière Brésil-Paraguay.' },
  { name: 'Promenade au Clair de Lune — Chutes', price: 50, description: 'Promenade nocturne guidée pour voir les chutes illuminées par la lumière de la lune.' },
  { name: 'Mines de Wanda', price: 35, description: 'Mines de pierres semi-précieuses avec visites guidées souterraines.' },
];

const taxInfo = [
  {
    title: 'Remboursement de TVA pour les Touristes',
    description: 'Les touristes étrangers séjournant dans des hôtels enregistrés en Argentine peuvent demander un remboursement de la TVA (IVA) de 21% sur l\'hébergement. Demandez le formulaire de remboursement au check-out de l\'hôtel et traitez-le à l\'aéroport avant le départ.',
    icon: '🧾',
  },
  {
    title: 'Taxe de Réciprocité',
    description: 'Les citoyens de certains pays (ex. Australie, Canada) peuvent devoir payer une taxe de réciprocité avant de voyager en Argentine. Consultez le site web de l\'immigration argentine pour les exigences actuelles applicables à votre nationalité.',
    icon: '📋',
  },
];

const bookingContacts = [
  {
    name: 'Full Service EVT (Agence de Voyage Officielle)',
    email: 'fullserviceevt@gmail.com',
    phone: '+54 3757 423721',
    description: 'Agence de voyage officielle du congrès pour les réservations d\'hôtel, forfaits touristiques et transferts.',
  },
  {
    name: 'Bureau du Congrès IRF',
    email: 'wrc@internationalrangers.org',
    phone: '',
    description: 'Questions générales sur le congrès et support d\'inscription.',
  },
];
---

<PageLayout title="Lieu et Hébergement" description="Lieu du congrès, options d'hôtel, forfaits touristiques et informations pratiques de voyage pour le 11e Congrès Mondial des Gardes Forestiers à Puerto Iguazú.">
  <!-- Hero -->
  <section class="relative h-[350px] sm:h-[400px]">
    <img src="/images/titles/venue.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative h-full flex items-center">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white">
          Lieu et Hébergement
        </h1>
        <p class="mt-4 text-xl text-white/80 max-w-2xl">
          Des installations de premier plan au cœur de la Triple Frontière
        </p>
      </div>
    </div>
  </section>

  <!-- Navigation Tabs -->
  <nav class="bg-white border-b border-gray-200 sticky top-16 z-30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex justify-center gap-1 overflow-x-auto">
        <a href={`${prefix}/travel`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          Logistique
        </a>
        <a href={`${prefix}/travel/venue`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-wrc-green-700 text-wrc-green-700 whitespace-nowrap">
          Lieu et Hébergement
        </a>
        <a href={`${prefix}/travel/faqs`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          FAQ Voyage
        </a>
      </div>
    </div>
  </nav>

  <!-- Venue Section -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 items-start">
        <div>
          <h2 class="text-3xl font-heading font-bold text-wrc-green-900 mb-4">
            Lieu du Congrès
          </h2>
          <h3 class="text-xl font-heading font-semibold text-wrc-green-700 mb-4">
            {VENUE.name}
          </h3>
          <div class="space-y-4 text-gray-600 leading-relaxed">
            <p>
              Le congrès se tiendra au Centro de Eventos y Convenciones del Iguazú,
              un centre de conventions moderne situé à Puerto Iguazú, Misiones, Argentine.
              Le lieu offre des installations de pointe pour les séances plénières, les ateliers
              et les événements culturels.
            </p>
            <p>
              Situé à proximité des impressionnantes chutes d'Iguazú et de la forêt atlantique, le lieu
              offre un cadre unique qui relie les délégués au monde naturel qu'ils
              s'efforcent de protéger.
            </p>
          </div>
        </div>
        <MapEmbed
          src={VENUE.mapEmbed}
          title="Lieu du Congrès - Centro de Eventos y Convenciones del Iguazú"
          height="350"
        />
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" />

  <!-- Team Accommodation Note -->
  <section class="py-12 relative overflow-hidden">
    <img src="/images/home/14.png" alt="" aria-hidden="true" class="absolute right-0 top-8 h-full w-auto opacity-40 pointer-events-none object-contain object-right" />
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="relative bg-gradient-to-br from-wrc-green-50 to-white rounded-2xl shadow-lg border border-wrc-green-200 overflow-hidden">
        <!-- Decorative accent bar -->
        <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-b from-wrc-green-500 to-wrc-green-700"></div>

        <div class="pl-8 pr-6 py-8 sm:pl-10 sm:pr-8 sm:py-10">
          <!-- Badge -->
          <div class="flex items-center gap-3 mb-5">
            <span class="bg-wrc-green-700 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">
              Mise &agrave; Jour H&eacute;bergement
            </span>
          </div>

          <!-- Welcome & Explanation -->
          <div class="space-y-4 text-gray-700 leading-relaxed">
            <p class="text-lg font-semibold text-wrc-green-900">
              Nous sommes ravis de vous accueillir au 11e Congr&egrave;s Mondial des Rangers de l'IRF dans la magnifique Iguaz&uacute;, en Argentine !
            </p>
            <p>
              En ce qui concerne l'h&eacute;bergement, nous avons d'excellentes nouvelles &agrave; partager.
            </p>
            <p>
              Nous avons conclu un partenariat avec l'<strong>H&Ocirc;TEL AMERIAN PORTAL DEL IGUAZ&Uacute;</strong>, situ&eacute; juste &agrave; c&ocirc;t&eacute; du Centre de Conventions d'Iguaz&uacute; o&ugrave; se tiendra le congr&egrave;s.
            </p>
          </div>

          <!-- Amerian Hotel Details -->
          <div class="mt-6 bg-wrc-green-50 border border-wrc-green-200 rounded-xl p-5">
            <ul class="space-y-3 text-sm text-wrc-green-900">
              <li class="flex items-start gap-2">
                <span class="shrink-0 mt-0.5">&#x1F3E8;</span>
                <span>L'H&ocirc;tel Amerian Portal del Iguaz&uacute; a accord&eacute; &agrave; tous les participants du congr&egrave;s une <strong>r&eacute;duction de 13%</strong> sur le tarif journalier de la chambre.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="shrink-0 mt-0.5">&#x1F4B0;</span>
                <span>Le tarif standard est de <strong>USD 130 + TVA</strong> par chambre, par nuit, et s'applique aux chambres simples ou doubles.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="shrink-0 mt-0.5">&#x1F6CF;&#xFE0F;</span>
                <span>Les chambres triples ne sont pas disponibles. Un lit suppl&eacute;mentaire peut &ecirc;tre ajout&eacute; &agrave; la chambre pour un co&ucirc;t additionnel de <strong>USD 60 + TVA</strong> par nuit.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="shrink-0 mt-0.5">&#x2709;&#xFE0F;</span>
                <span>Vous pouvez effectuer votre r&eacute;servation directement aupr&egrave;s d'eux &agrave; <a href="mailto:reservasiguazu@amerian.com" class="text-wrc-green-700 font-semibold underline underline-offset-2 hover:text-wrc-green-900">reservasiguazu@amerian.com</a>.</span>
              </li>
            </ul>
          </div>

          <!-- Suggested hotels -->
          <p class="mt-6 text-gray-700 leading-relaxed">
            Nous avons &eacute;galement une excellente s&eacute;lection d'h&ocirc;tels sugg&eacute;r&eacute;s ci-dessous parmi lesquels choisir.
          </p>

          <!-- Important Notes Callout -->
          <div class="mt-6 bg-amber-50 border border-amber-200 rounded-xl p-5">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
              <h3 class="font-heading font-bold text-amber-900 text-sm uppercase tracking-wide">&#x1F514; &Agrave; Noter</h3>
            </div>
            <ul class="space-y-2 text-sm text-amber-900">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span>L'inscription au Congr&egrave;s doit &ecirc;tre compl&eacute;t&eacute;e et pay&eacute;e via le site officiel du WRC.</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span>L'h&eacute;bergement doit &ecirc;tre r&eacute;serv&eacute; directement par chaque participant aupr&egrave;s de l'&eacute;tablissement de son choix.</span>
              </li>
            </ul>
          </div>

          <!-- Closing -->
          <p class="mt-6 text-gray-600 leading-relaxed">
            Cette approche vous permet de planifier votre s&eacute;jour de la mani&egrave;re qui convient le mieux &agrave; votre budget, votre calendrier de voyage et votre niveau de confort, tout en profitant de la proximit&eacute; avec les activit&eacute;s du Congr&egrave;s.
          </p>
          <p class="mt-4 font-semibold text-wrc-green-800">
            Nous avons h&acirc;te d'accueillir des rangers du monde entier pour un Congr&egrave;s inoubliable &agrave; Iguaz&uacute; ! &#x1F30E;
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Hotels -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-4">
        Hôtels en Vedette
      </h2>
      <p class="text-center text-gray-600 mb-10 max-w-2xl mx-auto">
        Options d'hébergement premium à proximité du lieu du congrès
      </p>
      <div class="grid md:grid-cols-3 gap-6">
        {featuredHotels.map((hotel, idx) => (
          <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6 flex flex-col">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-heading font-bold text-lg text-gray-900">{hotel.name}</h3>
            </div>
            <p class="text-wrc-green-700 font-semibold text-sm mb-1">
              {'⭐'.repeat(hotel.stars)} {hotel.stars} Étoiles
            </p>
            <p class="text-sm text-gray-500 mb-3">{hotel.rooms} chambres · {hotel.address}</p>

            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Tarif :</span>
              {hotel.rate ? (
                <span class="font-heading font-bold text-wrc-green-800 text-sm">{hotel.rate}</span>
              ) : (
                <span class="text-sm text-gray-400 italic">N/A</span>
              )}
              {hotel.rateNotes && (
                <div class="relative group">
                  <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-gray-200 text-gray-600 text-[10px] font-bold cursor-help">i</span>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-56 bg-gray-900 text-white text-xs rounded-lg p-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-20 pointer-events-none shadow-lg">
                    <ul class="space-y-1">
                      {hotel.rateNotes.map((note) => (
                        <li class="flex items-start gap-1.5">
                          <span class="text-wrc-green-400 mt-px">•</span>
                          <span>{note}</span>
                        </li>
                      ))}
                    </ul>
                    <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-900"></div>
                  </div>
                </div>
              )}
            </div>

            <ul class="space-y-1.5 mb-4 flex-1">
              {hotel.features.map((f) => (
                <li class="flex items-center gap-2 text-sm text-gray-600">
                  <svg class="w-4 h-4 text-wrc-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            {hotel.services && (
              <button
                class="services-modal-trigger text-xs font-semibold text-wrc-green-700 hover:text-wrc-green-900 transition-colors mb-4 self-start underline underline-offset-2"
                type="button"
                data-modal={`services-modal-${idx}`}
              >
                Services Inclus
              </button>
            )}

            <div class="mt-auto">
              <Button href={hotel.mapUrl} variant="outline" size="sm">
                Voir sur la Carte &rarr;
              </Button>
            </div>
          </div>
        ))}
      </div>

      {featuredHotels.map((hotel, idx) => (
        hotel.services && (
          <div id={`services-modal-${idx}`} class="services-modal fixed inset-0 z-50 hidden">
            <div class="services-modal-backdrop absolute inset-0 bg-black/50"></div>
            <div class="relative flex items-center justify-center min-h-full p-4">
              <div class="services-modal-content relative bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 sm:p-8">
                <button class="services-modal-close absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors" type="button">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
                <h3 class="font-heading font-bold text-lg text-wrc-green-900 mb-1">{hotel.name}</h3>
                <p class="text-xs uppercase tracking-wide text-wrc-green-700 font-semibold mb-4">Services Inclus</p>
                <ul class="space-y-2">
                  {hotel.services.map((s) => (
                    <li class="flex items-start gap-2 text-sm text-gray-700">
                      <svg class="w-4 h-4 text-wrc-green-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        )
      ))}
    </div>
  </section>

  <!-- Additional Hotels -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/10.png" alt="" aria-hidden="true" class="absolute right-0 top-0 h-60 w-auto opacity-50 pointer-events-none" />
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Options d'Hôtel Supplémentaires
      </h2>
      <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
        <table class="w-full">
          <thead>
            <tr class="bg-wrc-green-50">
              <th class="px-6 py-3 text-left text-sm font-heading font-bold text-wrc-green-900">Hôtel</th>
              <th class="px-4 py-3 text-center text-sm font-heading font-bold text-wrc-green-900">Étoiles</th>
              <th class="px-4 py-3 text-center text-sm font-heading font-bold text-wrc-green-900">Chambres</th>
              <th class="px-6 py-3 text-left text-sm font-heading font-bold text-wrc-green-900 hidden sm:table-cell">Emplacement</th>
            </tr>
          </thead>
          <tbody>
            {additionalHotels.map((hotel, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-6 py-3 text-sm font-semibold text-gray-700">{hotel.name}</td>
                <td class="px-4 py-3 text-sm text-center text-gray-600">{'⭐'.repeat(hotel.stars)}</td>
                <td class="px-4 py-3 text-sm text-center text-gray-600">{hotel.rooms}</td>
                <td class="px-6 py-3 text-sm text-gray-500 hidden sm:table-cell">{hotel.location}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" />

  <!-- Tour Packages -->
  <section class="relative py-16 bg-gray-50 overflow-hidden">
    <img src="/images/home/25.png" alt="" aria-hidden="true" class="absolute left-0 top-1/3 -translate-y-1/2 h-64 w-auto opacity-30 pointer-events-none" />
    <img src="/images/home/14.png" alt="" aria-hidden="true" class="absolute right-0 bottom-0 h-96 w-auto opacity-50 pointer-events-none" style="transform: scaleY(1.3) scale(1.1);" />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-4">
        Forfaits Touristiques
      </h2>
      <p class="text-center text-gray-600 mb-10 max-w-2xl mx-auto">
        Explorez Iguazú et ses environs avec des excursions organisées
      </p>

      <!-- Basic Package (Included) -->
      <div class="bg-wrc-green-50 rounded-2xl p-8 border border-wrc-green-200 max-w-3xl mx-auto mb-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="bg-wrc-green-700 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">Inclus</span>
          <h3 class="font-heading font-bold text-xl text-wrc-green-900">Forfait Touristique de Base</h3>
        </div>
        <p class="text-gray-600 text-sm mb-4">Les excursions suivantes sont incluses dans votre inscription au congrès :</p>
        <ul class="grid sm:grid-cols-2 gap-3">
          {basicPackageItems.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-wrc-green-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Paid Tours -->
      <h3 class="font-heading font-bold text-xl text-center text-wrc-green-900 mb-6">
        Tours Optionnels (Coût Supplémentaire)
      </h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
        {paidTours.map((tour) => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 relative">
            <span class="absolute top-4 right-4 bg-wrc-earth-100 text-wrc-earth-800 text-xs font-bold px-2 py-1 rounded-full">
              USD ${tour.price}
            </span>
            <h4 class="font-heading font-bold text-gray-900 mb-2 pr-16">{tour.name}</h4>
            <p class="text-sm text-gray-600 leading-relaxed">{tour.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Transfers -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/23.png" alt="" aria-hidden="true" class="absolute -right-20 bottom-4 h-48 w-auto opacity-30 pointer-events-none" />
    <img src="/images/home/24.png" alt="" aria-hidden="true" class="absolute top-4 h-72 w-auto opacity-30 pointer-events-none -scale-x-100" style="left: 3.75rem;" />
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Transferts
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="bg-wrc-green-50 rounded-xl p-6 border border-wrc-green-200 text-center">
          <span class="text-2xl block mb-2" aria-hidden="true">✈️</span>
          <h3 class="font-heading font-bold text-wrc-green-900 mb-2">Transferts Aéroport</h3>
          <p class="text-sm text-gray-600">Inclus dans votre inscription au congrès. Service de navette entre l'Aéroport Cataratas del Iguazú (IGR) et les hôtels du congrès.</p>
        </div>
        <div class="bg-wrc-blue-50 rounded-xl p-6 border border-wrc-blue-200 text-center">
          <span class="text-2xl block mb-2" aria-hidden="true">🚐</span>
          <h3 class="font-heading font-bold text-wrc-blue-900 mb-2">Transferts Côté Brésilien</h3>
          <p class="text-sm text-gray-600">Transfert vers le côté brésilien des chutes : <strong>USD $25/personne</strong> (minimum 10 passagers).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tax Information -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Informations Fiscales
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {taxInfo.map((info) => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <span class="text-2xl block mb-2" aria-hidden="true">{info.icon}</span>
            <h3 class="font-heading font-bold text-gray-900 mb-2">{info.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{info.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Booking Contacts -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/27.png" alt="" aria-hidden="true" class="absolute left-0 top-0 h-72 w-auto opacity-70 pointer-events-none" />
    <img src="/images/home/26.png" alt="" aria-hidden="true" class="absolute right-0 bottom-0 h-72 w-auto opacity-70 pointer-events-none" />
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Réservations et Contact
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {bookingContacts.map((contact) => (
          <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6 text-center">
            <h3 class="font-heading font-bold text-gray-900 mb-2">{contact.name}</h3>
            <p class="text-sm text-gray-600 mb-4">{contact.description}</p>
            <div class="space-y-1">
              <a href={`mailto:${contact.email}`} class="block text-sm text-wrc-green-700 font-semibold hover:underline">
                {contact.email}
              </a>
              {contact.phone && (
                <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="block text-sm text-gray-600 font-mono">
                  {contact.phone}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<script>
  document.querySelectorAll('.services-modal-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const modalId = (btn as HTMLElement).dataset.modal;
      const modal = document.getElementById(modalId!);
      if (modal) {
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  document.querySelectorAll('.services-modal').forEach((modal) => {
    const close = () => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    };
    modal.querySelector('.services-modal-close')?.addEventListener('click', close);
    modal.querySelector('.services-modal-backdrop')?.addEventListener('click', close);
  });
</script>
