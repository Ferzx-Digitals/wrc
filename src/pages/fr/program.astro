---
import PageLayout from '../../layouts/PageLayout.astro';
import Tabs from '../../components/ui/Tabs.astro';
import Button from '../../components/ui/Button.astro';
import SectionDivider from '../../components/global/SectionDivider.astro';
import { getLocaleFromUrl } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const fieldTripsData = await import('../../content/field-trips/fr.json');
const fieldTrips = fieldTripsData.trips;

const programTabs = [
  { id: 'overview', label: 'Aperçu' },
  { id: 'schedule', label: 'Programme Détaillé' },
  { id: 'activities', label: 'Activités' },
  { id: 'field-trips', label: 'Excursions' },
];

const overviewSchedule = [
  { day: 'Vendredi 18 Avril', events: 'Arrivée et Accréditation, Réception de Bienvenue' },
  { day: 'Samedi 19 Avril', events: 'Cérémonie d\'Ouverture, Sessions Plénières, Soirée Culturelle' },
  { day: 'Dimanche 20 Avril', events: 'Sessions Plénières, Ateliers Simultanés, Conférence de Presse' },
  { day: 'Lundi 21 Avril', events: 'Excursions (Journée Complète)' },
  { day: 'Mardi 22 Avril', events: 'Sessions Plénières, Discussions Ouvertes, Soirée Culturelle' },
  { day: 'Mercredi 23 Avril', events: 'Cérémonie de Clôture, Déclaration d\'Iguazú, Adieux' },
];

const activities = [
  {
    title: 'Conférences Plénières',
    description: 'Sessions principales par d\'éminents experts en conservation sur la main-d\'œuvre inclusive, le bien-être des gardes forestiers, la conduite professionnelle et le renforcement des capacités.',
    icon: '\uD83C\uDFA4',
    count: '8-10 sessions',
  },
  {
    title: 'Ateliers Simultanés',
    description: 'Ateliers thématiques sur l\'équité et l\'égalité, les peuples autochtones, l\'approche Une seule santé, la participation des jeunes, la technologie et la participation communautaire.',
    icon: '\uD83D\uDD2C',
    count: '12-15 ateliers',
  },
  {
    title: 'Discussions Ouvertes',
    description: 'Plateformes informelles pour les peuples autochtones, les femmes gardes forestières, les jeunes leaders, les bénévoles et les gardes forestiers retraités pour partager leurs expériences.',
    icon: '\uD83D\uDCAC',
    count: '6-8 sessions',
  },
  {
    title: 'Soirées Culturelles',
    description: 'Divertissements en soirée avec musique, art et expressions culturelles des communautés de gardes forestiers du monde entier. Deux événements culturels prévus.',
    icon: '\uD83C\uDFAD',
    count: '2 soirées',
  },
  {
    title: 'Excursions',
    description: 'Excursions d\'une journée complète au Parc National d\'Iguazú, centres de faune sauvage, mines de pierres précieuses, missions jésuites et côté brésilien des chutes.',
    icon: '\uD83C\uDF3F',
    count: '6 options',
  },
];
---

<PageLayout title="Programme du Congrès" description="Explorez le programme complet du 11e Congrès Mondial des Gardes Forestiers de l'IRF — conférences plénières, ateliers, excursions et événements culturels.">
  <!-- Hero -->
  <section class="relative h-[350px] sm:h-[400px] bg-gradient-to-r from-wrc-green-900/90 to-wrc-green-800/70">
    <div class="absolute inset-0 opacity-10">
      <div class="w-full h-full bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2040%2040%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M20%2020.5V18H0v-2h20v-2l-3-3%203-3v-2H0V4h20V1.5L23.5%205%2020%208.5z%22%20fill%3D%22%23fff%22%20fill-opacity%3D%220.2%22%20fill-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E')]"></div>
    </div>
    <div class="relative h-full flex items-center">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white">
          Programme du Congrès
        </h1>
        <p class="mt-4 text-xl text-white/80 max-w-2xl">
          Six jours d'apprentissage, de collaboration et de célébration
        </p>
      </div>
    </div>
  </section>

  <!-- Program Tabs -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Tabs tabs={programTabs} defaultTab="overview">
        <!-- Overview Tab -->
        <div id="panel-overview" role="tabpanel">
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Aperçu du Programme
          </h2>
          <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
            <div class="grid grid-cols-[1fr_2fr]">
              <div class="px-6 py-3 bg-wrc-green-50 text-sm font-heading font-bold text-wrc-green-900">Jour</div>
              <div class="px-6 py-3 bg-wrc-green-50 text-sm font-heading font-bold text-wrc-green-900">Événements</div>
              {overviewSchedule.map((row, i) => (
                <>
                  <div class={`px-6 py-4 text-sm font-semibold text-gray-900 ${i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}`} style="border-left: 4px solid #22c55e;">{row.day}</div>
                  <div class={`px-6 py-4 text-sm text-gray-600 ${i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}`}>{row.events}</div>
                </>
              ))}
            </div>
          </div>
          <div class="mt-6 text-center">
            <Button href="#" variant="outline" size="sm">
              Télécharger le Programme Complet (PDF)
            </Button>
          </div>
        </div>

        <!-- Detailed Schedule Tab -->
        <div id="panel-schedule" role="tabpanel" hidden>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Programme Détaillé
          </h2>
          <div class="space-y-6">
            {overviewSchedule.map((day) => (
              <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
                <h3 class="font-heading font-bold text-lg text-wrc-green-900 mb-3">{day.day}</h3>
                <div class="space-y-3">
                  {day.events.split(', ').map((event) => (
                    <div class="flex items-center gap-3 text-gray-600">
                      <div class="w-2 h-2 rounded-full bg-wrc-green-500 shrink-0"></div>
                      <span class="text-sm">{event}</span>
                    </div>
                  ))}
                </div>
                <p class="text-xs text-gray-400 mt-3 italic">Horaires détaillés à annoncer</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Activities Tab -->
        <div id="panel-activities" role="tabpanel" hidden>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Activités du Congrès
          </h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {activities.map((activity) => (
              <div class="group bg-white rounded-xl shadow-md p-6 border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                <span class="text-3xl mb-3 block" aria-hidden="true">{activity.icon}</span>
                <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">{activity.title}</h3>
                <p class="text-sm text-gray-600 leading-relaxed mb-3">{activity.description}</p>
                <p class="text-xs text-wrc-green-700 font-semibold">{activity.count}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Field Trips Tab -->
        <div id="panel-field-trips" role="tabpanel" hidden>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Excursions
          </h2>
          <p class="text-gray-600 mb-8">
            Choisissez parmi six options d'excursion le lundi 21 avril. Les excursions sont incluses dans l'inscription.
            Les coûts supplémentaires indiqués sont pour les droits d'entrée.
          </p>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {fieldTrips.map((trip) => (
              <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
                <div class="aspect-[16/10] bg-gradient-to-br from-wrc-green-100 to-wrc-blue-100 flex items-center justify-center">
                  <span class="text-wrc-green-400 font-heading font-bold text-sm">{trip.name}</span>
                </div>
                <div class="p-5">
                  <div class="flex items-center gap-2 mb-2">
                    <span class={`text-xs px-2 py-0.5 rounded-full font-semibold ${trip.country === 'Argentina' ? 'bg-wrc-blue-100 text-wrc-blue-700' : 'bg-wrc-green-100 text-wrc-green-700'}`}>
                      {trip.country}
                    </span>
                    <span class="text-xs text-gray-500">{trip.duration}</span>
                  </div>
                  <h3 class="font-heading font-bold text-gray-900 mb-2">{trip.name}</h3>
                  <p class="text-sm text-gray-600 leading-relaxed mb-3">{trip.description}</p>
                  <p class="text-sm font-semibold text-wrc-green-700">Droit d'entrée : USD ${trip.price}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </Tabs>
    </div>
  </section>
</PageLayout>
