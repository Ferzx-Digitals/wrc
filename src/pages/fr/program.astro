---
import PageLayout from '../../layouts/PageLayout.astro';
import Tabs from '../../components/ui/Tabs.astro';
import Button from '../../components/ui/Button.astro';
import SectionDivider from '../../components/global/SectionDivider.astro';
import { getLocaleFromUrl, t } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const fieldTripsData = await import('../../content/field-trips/fr.json');
const fieldTrips = fieldTripsData.trips;

const programTabs = [
  { id: 'overview', label: 'Aperçu' },
  { id: 'schedule', label: 'Programme Détaillé' },
  { id: 'activities', label: 'Activités' },
  { id: 'field-trips', label: 'Excursions' },
];

const overviewSchedule = [
  { day: 'Vendredi 18 Avril', events: 'Arrivée et Accréditation, Réception de Bienvenue' },
  { day: 'Samedi 19 Avril', events: 'Cérémonie d\'Ouverture, Sessions Plénières, Soirée Culturelle' },
  { day: 'Dimanche 20 Avril', events: 'Sessions Plénières, Ateliers Simultanés, Conférence de Presse' },
  { day: 'Lundi 21 Avril', events: 'Excursions (Journée Complète)' },
  { day: 'Mardi 22 Avril', events: 'Sessions Plénières, Discussions Ouvertes, Soirée Culturelle' },
  { day: 'Mercredi 23 Avril', events: 'Cérémonie de Clôture, Déclaration d\'Iguazú, Adieux' },
];

const activities = [
  { titleKey: 'about.activities.plenary', descKey: 'about.activities.plenaryDesc', countKey: 'events.activities.plenaryCount', image: 'Plenary Talks.jpg' },
  { titleKey: 'about.activities.workshops', descKey: 'about.activities.workshopsDesc', countKey: 'events.activities.workshopsCount', image: 'Concurrent Workshops.jpg' },
  { titleKey: 'about.activities.discussions', descKey: 'about.activities.discussionsDesc', countKey: 'events.activities.discussionsCount', image: 'Open Discussions.jpg' },
  { titleKey: 'about.activities.cultural', descKey: 'about.activities.culturalDesc', countKey: 'events.activities.culturalCount', image: 'Cultural Nights.jpg' },
  { titleKey: 'about.activities.fieldTrips', descKey: 'about.activities.fieldTripsDesc', countKey: 'events.activities.fieldTripsCount', image: 'Field Trips.jpg' },
];
---

<PageLayout title="Programme du Congrès" description="Explorez le programme complet du 11e Congrès Mondial des Gardes Forestiers de l'IRF — conférences plénières, ateliers, excursions et événements culturels.">
  <!-- Hero -->
  <section class="relative h-[350px] sm:h-[400px]">
    <img src="/images/congress-program/Banner.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative h-full flex items-center">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white">
          Programme du Congrès
        </h1>
        <p class="mt-4 text-xl text-white/80 max-w-2xl">
          Six jours d'apprentissage, de collaboration et de célébration
        </p>
      </div>
    </div>
  </section>

  <!-- Program Tabs -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Tabs tabs={programTabs} defaultTab="overview">
        <!-- Overview Tab -->
        <div id="panel-overview" role="tabpanel">
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Aperçu du Programme
          </h2>
          <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
            <div class="grid grid-cols-[1fr_2fr]">
              <div class="px-6 py-3 bg-wrc-green-50 text-sm font-heading font-bold text-wrc-green-900">Jour</div>
              <div class="px-6 py-3 bg-wrc-green-50 text-sm font-heading font-bold text-wrc-green-900">Événements</div>
              {overviewSchedule.map((row, i) => (
                <>
                  <div class={`px-6 py-4 text-sm font-semibold text-gray-900 ${i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}`} style="border-left: 4px solid #22c55e;">{row.day}</div>
                  <div class={`px-6 py-4 text-sm text-gray-600 ${i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}`}>{row.events}</div>
                </>
              ))}
            </div>
          </div>
          <div class="mt-6 text-center">
            <Button href="#" variant="outline" size="sm">
              Télécharger le Programme Complet (PDF)
            </Button>
          </div>
        </div>

        <!-- Detailed Schedule Tab -->
        <div id="panel-schedule" role="tabpanel" hidden>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Programme Détaillé
          </h2>
          <div class="space-y-6">
            {overviewSchedule.map((day) => (
              <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
                <h3 class="font-heading font-bold text-lg text-wrc-green-900 mb-3">{day.day}</h3>
                <div class="space-y-3">
                  {day.events.split(', ').map((event) => (
                    <div class="flex items-center gap-3 text-gray-600">
                      <div class="w-2 h-2 rounded-full bg-wrc-green-500 shrink-0"></div>
                      <span class="text-sm">{event}</span>
                    </div>
                  ))}
                </div>
                <p class="text-xs text-gray-400 mt-3 italic">Horaires détaillés à annoncer</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Activities Tab: congress activities cards (same as events page) -->
        <div id="panel-activities" role="tabpanel" hidden>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Activités du Congrès
          </h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {activities.map((activity) => (
              <div class="group rounded-xl shadow-md overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative min-h-[200px] aspect-[4/3] sm:aspect-auto sm:min-h-[240px]">
                <img src={`/images/congress-introduction/${encodeURIComponent(activity.image)}`} alt="" class="absolute inset-0 w-full h-full object-cover" />
                <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/85 via-black/50 to-transparent text-white">
                  <h3 class="font-heading font-bold text-base text-white mb-1.5">
                    {t(activity.titleKey, locale)}
                  </h3>
                  <p class="text-xs text-white/90 leading-relaxed mb-1.5">
                    {t(activity.descKey, locale)}
                  </p>
                  <p class="text-xs font-heading font-semibold text-white/80">
                    {t(activity.countKey, locale)}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Field Trips Tab: same cards as events page -->
        <div id="panel-field-trips" role="tabpanel" hidden>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            {t('events.fieldTrips.title', locale)}
          </h2>
          <p class="text-gray-600 mb-8 max-w-3xl">
            {t('events.fieldTrips.description', locale)}
          </p>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {fieldTrips.map((trip) => (
              <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100 hover:shadow-lg transition-shadow">
                <div class="aspect-[16/10] bg-gradient-to-br from-wrc-green-100 to-wrc-blue-100 flex items-center justify-center relative overflow-hidden">
                  {trip.image ? (
                    <img src={`/images/congress-events/${encodeURIComponent(trip.image)}`} alt="" class="absolute inset-0 w-full h-full object-cover" />
                  ) : (
                    <span class="text-wrc-green-400 font-heading font-bold text-sm">{trip.name}</span>
                  )}
                </div>
                <div class="p-5">
                  <div class="flex items-center gap-2 mb-3">
                    <span class={`text-xs px-2 py-0.5 rounded-full font-semibold ${trip.country === 'Argentina' ? 'bg-wrc-blue-100 text-wrc-blue-700' : 'bg-wrc-green-100 text-wrc-green-700'}`}>
                      {trip.country}
                    </span>
                  </div>
                  <h3 class="font-heading font-bold text-gray-900 mb-2">{trip.name}</h3>
                  <p class="text-sm text-gray-600 leading-relaxed mb-4">{trip.description}</p>
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-gray-500">{t('events.fieldTrips.duration', locale)}: {trip.duration}</span>
                    <span class="font-semibold text-wrc-green-700">{t('events.fieldTrips.entryFee', locale)}: USD ${trip.price}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </Tabs>
    </div>
  </section>
</PageLayout>
