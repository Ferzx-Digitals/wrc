---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import SectionDivider from '../../components/global/SectionDivider.astro';
import { EXTERNAL_LINKS } from '../../utils/constants';

const sessionTypes = [
  {
    title: 'Conférences Plénières',
    description: 'Présentations principales par d\'éminents experts en conservation. Les sessions abordent la main-d\'œuvre inclusive, le bien-être des gardes, la conduite professionnelle et le renforcement des capacités.',
    duration: '20-30 minutes',
    icon: '🎤',
  },
  {
    title: 'Ateliers Simultanés',
    description: 'Ateliers thématiques sur l\'équité et l\'égalité, les peuples autochtones, une seule santé, l\'implication des jeunes, la technologie et plus encore. Sessions interactives et pratiques.',
    duration: '60-90 minutes',
    icon: '🔬',
  },
];

const formFields = [
  'Nom complet',
  'Organisation / Agence',
  'Pays',
  'Région IRF',
  'Adresse e-mail',
  'Titre de la présentation',
  'Préférence de type de session (Plénière / Atelier)',
  'Alignement avec l\'axe thématique',
  'Résumé (300 mots maximum)',
  'Brève biographie',
  'Exigences techniques',
];
---

<PageLayout title="Soumettre une Expression d'Intérêt" description="Soumettez votre expression d'intérêt pour présenter au 11e Congrès Mondial des Gardes Forestiers de l'IRF. Formulaires disponibles en anglais, espagnol et français.">
  <!-- Hero: same banner style as Congress introduction / Events -->
  <section class="relative h-[350px] sm:h-[400px] lg:h-[45vh] xl:h-[50vh] overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <img src="/images/submit/Banner.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/20" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/25 to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-0 flex items-center z-10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white leading-tight drop-shadow-lg">
          Soumettez Votre Intérêt
        </h1>
        <p class="mt-4 text-xl sm:text-2xl text-white/85 font-light max-w-2xl">
          Partagez vos expériences, recherches et connaissances au Congrès Mondial des Gardes Forestiers
        </p>
      </div>
    </div>
  </section>

  <!-- Guidelines -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/28.png" alt="" aria-hidden="true" class="absolute bottom-0 left-0 w-full h-auto pointer-events-none" style="opacity: 0.35;" />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-heading font-bold text-wrc-green-900 mb-6">
          Guide pour les Expressions d'Intérêt
        </h2>
        <div class="space-y-4 text-gray-600 leading-relaxed">
          <p>
            Le 11e Congrès Mondial des Gardes Forestiers de l'IRF invite les gardes, les professionnels de la conservation, les chercheurs
            et les leaders communautaires à soumettre des expressions d'intérêt pour présenter au congrès. Nous accueillons
            les présentations alignées avec nos axes thématiques et contribuant à l'avancement de la profession de garde forestier.
          </p>
          <p>
            Les soumissions sont acceptées en <strong>anglais, espagnol et français</strong>. Toutes les expressions
            d'intérêt seront examinées par le Comité du Programme du Congrès. Les conférenciers sélectionnés seront notifiés
            et pourront être éligibles à un soutien financier.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Session Types -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Types de Sessions
      </h2>
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {sessionTypes.map((session) => (
          <div class="bg-white rounded-xl shadow-md p-8 border border-gray-100">
            <span class="text-4xl mb-4 block" aria-hidden="true">{session.icon}</span>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-2">{session.title}</h3>
            <p class="text-gray-600 leading-relaxed mb-4">{session.description}</p>
            <p class="text-sm text-wrc-green-700 font-semibold">Durée : {session.duration}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" class="bg-gray-50" />

  <!-- Form Fields & Thematic Streams -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/29.png" alt="" aria-hidden="true" class="absolute bottom-0 left-0 w-full h-auto opacity-100 pointer-events-none" />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <div>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Ce Dont Vous Aurez Besoin
          </h2>
          <p class="text-gray-600 mb-4">Préparez les informations suivantes avant de commencer votre soumission :</p>
          <ul class="space-y-2">
            {formFields.map((field) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-wrc-green-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-gray-700">{field}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Axes Thématiques
          </h2>
          <p class="text-gray-600 mb-4">Votre soumission doit s'aligner avec l'un de ces thèmes :</p>
          <div class="space-y-3">
            {['Main-d\'œuvre Inclusive et Représentative', 'Bien-être et Conditions de Travail', 'Conduite Professionnelle et Éthique', 'Renforcement des Capacités et Formation', 'Engagement Communautaire et Partenariats'].map((stream, i) => (
              <div class="flex items-center gap-3 bg-wrc-green-50 rounded-lg p-3">
                <span class="w-8 h-8 rounded-full bg-wrc-green-700 text-white flex items-center justify-center text-sm font-bold shrink-0">{i + 1}</span>
                <span class="text-wrc-green-900 font-medium text-sm">{stream}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Submit Forms -->
  <section class="py-16 bg-wrc-green-50">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-heading font-bold text-wrc-green-900 mb-4">
        Soumettez Votre Expression d'Intérêt
      </h2>
      <p class="text-gray-600 mb-8">
        Choisissez votre langue préférée pour accéder au formulaire de soumission via Google Forms.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href={EXTERNAL_LINKS.speakerFormEN} size="lg" variant="outline">
          Formulaire en Anglais
        </Button>
        <Button href={EXTERNAL_LINKS.speakerFormES} size="lg" variant="outline">
          Formulaire en Espagnol
        </Button>
        <Button href={EXTERNAL_LINKS.speakerFormFR} size="lg" variant="primary">
          Formulaire en Français
        </Button>
      </div>
    </div>
  </section>

  <!-- Need Funding? -->
  <section class="py-12 bg-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-3">
        Besoin d'un Soutien Financier ?
      </h2>
      <p class="text-gray-600 mb-6">
        Les délégués et intervenants recherchant un soutien financier pour assister au congrès peuvent soumettre une Expression d'Intérêt pour un financement.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href={EXTERNAL_LINKS.fundingEoiEN} size="lg" variant="outline">
          Apply for Funding (EN)
        </Button>
        <Button href={EXTERNAL_LINKS.fundingEoiES} size="lg" variant="outline">
          Solicitar Financiamiento (ES)
        </Button>
        <Button href={EXTERNAL_LINKS.fundingEoiFR} size="lg" variant="primary">
          Demander un Financement (FR)
        </Button>
      </div>
    </div>
  </section>

  <!-- Deadline Banner -->
  <section class="py-8 bg-wrc-earth-500 text-white text-center">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <p class="text-lg font-heading font-bold">
        Date Limite de Soumission : À Annoncer
      </p>
      <p class="text-sm text-white/80 mt-1">
        Les soumissions anticipées sont encouragées. Les présentateurs sélectionnés seront notifiés par e-mail.
      </p>
    </div>
  </section>
</PageLayout>
