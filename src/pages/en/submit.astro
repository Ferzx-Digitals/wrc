---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import SectionDivider from '../../components/global/SectionDivider.astro';
import { EXTERNAL_LINKS } from '../../utils/constants';

const sessionTypes = [
  {
    title: 'Plenary Talks',
    description: 'Main stage presentations by prominent conservation experts. Sessions address inclusive workforce, welfare of rangers, professional conduct, and capacity building.',
    duration: '20-30 minutes',
    icon: '🎤',
  },
  {
    title: 'Concurrent Workshops',
    description: 'Thematic workshops on equity & equality, indigenous peoples, one health, youth involvement, technology, and more. Interactive, hands-on sessions.',
    duration: '60-90 minutes',
    icon: '🔬',
  },
];

const formFields = [
  'Full name',
  'Organization / Agency',
  'Country',
  'IRF Region',
  'Email address',
  'Presentation title',
  'Session type preference (Plenary / Workshop)',
  'Thematic stream alignment',
  'Abstract (300 words maximum)',
  'Brief biography',
  'Any technical requirements',
];
---

<PageLayout title="Submit Expression of Interest" description="Submit your expression of interest to present at the 11th IRF World Ranger Congress. Forms available in English, Spanish, and French.">
  <!-- Hero: same banner style as Congress introduction / Events -->
  <section class="relative h-[350px] sm:h-[400px] lg:h-[45vh] xl:h-[50vh] overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <img src="/images/submit/Banner.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/20" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/25 to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-0 flex items-center z-10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white leading-tight drop-shadow-lg">
          Submit Your Interest
        </h1>
        <p class="mt-4 text-xl sm:text-2xl text-white/85 font-light max-w-2xl">
          Share your experiences, research, and insights at the World Ranger Congress
        </p>
      </div>
    </div>
  </section>

  <!-- Guidelines -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-heading font-bold text-wrc-green-900 mb-6">
          Expression of Interest Guidelines
        </h2>
        <div class="space-y-4 text-gray-600 leading-relaxed">
          <p>
            The 11th IRF World Ranger Congress invites rangers, conservation professionals, researchers,
            and community leaders to submit expressions of interest to present at the congress. We welcome
            presentations that align with our thematic streams and contribute to advancing the ranger profession.
          </p>
          <p>
            Submissions are accepted in <strong>English, Spanish, and French</strong>. All expressions of
            interest will be reviewed by the Congress Program Committee. Selected speakers will be notified
            and may be eligible for funding support.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Session Types -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Session Types
      </h2>
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {sessionTypes.map((session) => (
          <div class="bg-white rounded-xl shadow-md p-8 border border-gray-100">
            <span class="text-4xl mb-4 block" aria-hidden="true">{session.icon}</span>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-2">{session.title}</h3>
            <p class="text-gray-600 leading-relaxed mb-4">{session.description}</p>
            <p class="text-sm text-wrc-green-700 font-semibold">Duration: {session.duration}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" />

  <!-- Form Fields & Thematic Streams -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <!-- Form Fields -->
        <div>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            What You'll Need
          </h2>
          <p class="text-gray-600 mb-4">Prepare the following information before starting your submission:</p>
          <ul class="space-y-2">
            {formFields.map((field) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-wrc-green-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-gray-700">{field}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Thematic Streams -->
        <div>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Thematic Streams
          </h2>
          <p class="text-gray-600 mb-4">Your submission should align with one of these themes:</p>
          <div class="space-y-3">
            {['Inclusive and Representative Workforce', 'Welfare and Working Conditions', 'Professional Conduct and Ethics', 'Capacity Building and Training', 'Community Engagement and Partnerships'].map((stream, i) => (
              <div class="flex items-center gap-3 bg-wrc-green-50 rounded-lg p-3">
                <span class="w-8 h-8 rounded-full bg-wrc-green-700 text-white flex items-center justify-center text-sm font-bold shrink-0">{i + 1}</span>
                <span class="text-wrc-green-900 font-medium text-sm">{stream}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Submit Forms -->
  <section class="py-16 bg-wrc-green-50">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-heading font-bold text-wrc-green-900 mb-4">
        Submit Your Expression of Interest
      </h2>
      <p class="text-gray-600 mb-8">
        Choose your preferred language to access the submission form via Google Forms.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href={EXTERNAL_LINKS.speakerFormEN} size="lg" variant="primary">
          English Form
        </Button>
        <Button href={EXTERNAL_LINKS.speakerFormES} size="lg" variant="outline">
          Formulario en Espanol
        </Button>
        <Button href={EXTERNAL_LINKS.speakerFormFR} size="lg" variant="outline">
          Formulaire en Francais
        </Button>
      </div>
    </div>
  </section>

  <!-- Deadline Banner -->
  <section class="py-8 bg-wrc-earth-500 text-white text-center">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <p class="text-lg font-heading font-bold">
        Submission Deadline: To Be Announced
      </p>
      <p class="text-sm text-white/80 mt-1">
        Early submissions are encouraged. Selected presenters will be notified by email.
      </p>
    </div>
  </section>
</PageLayout>
