---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import MapEmbed from '../../components/ui/MapEmbed.astro';
import CountdownTimer from '../../components/global/CountdownTimer.astro';
import SectionDivider from '../../components/global/SectionDivider.astro';
import { CONTACT_EMAIL, VENUE, EXTERNAL_LINKS } from '../../utils/constants';

const contactFormSubmitUrl = EXTERNAL_LINKS.contactFormSubmitUrl;
const contactFormEntryIds = EXTERNAL_LINKS.contactFormEntryIds;
import { getLocaleFromUrl } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const contactCards = [
  {
    title: 'General Inquiries',
    description: 'Questions about the congress, registration, or logistics.',
    email: CONTACT_EMAIL,
    icon: '📧',
  },
  {
    title: 'Sponsorship',
    description: 'Interested in sponsoring the congress? Get the sponsorship prospectus.',
    email: CONTACT_EMAIL,
    icon: '🤝',
    prospectusUrl: EXTERNAL_LINKS.sponsorshipProspectusEN,
  },
  {
    title: 'Press & Media',
    description: 'Media inquiries, press accreditation, and interview requests.',
    email: CONTACT_EMAIL,
    icon: '📰',
  },
];

---

<PageLayout title="Contact Us" description="Get in touch with the 11th IRF World Ranger Congress organizing team. Ask questions, request sponsorship info, or send media inquiries.">
  <!-- Hero -->
  <section class="relative h-[350px] sm:h-[400px] bg-gradient-to-r from-wrc-green-900/90 to-wrc-green-800/70">
    <div class="absolute inset-0 opacity-10">
      <div class="w-full h-full bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2040%2040%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M20%2020.5V18H0v-2h20v-2l-3-3%203-3v-2H0V4h20V1.5L23.5%205%2020%208.5z%22%20fill%3D%22%23fff%22%20fill-opacity%3D%220.2%22%20fill-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E')]"></div>
    </div>
    <div class="relative h-full flex items-center">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white">
          Contact Us
        </h1>
        <p class="mt-4 text-xl text-white/80 max-w-2xl">
          We'd love to hear from you. Get in touch with our team.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Form + Info -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Contact Form: custom UI, submits to Google Forms -->
        <div>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Send Us a Message
          </h2>
          <div id="contact-form-status" class="mb-4 hidden rounded-lg p-4" role="alert" aria-live="polite"></div>
          <form id="contact-form" class="space-y-5">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-wrc-green-500 focus:border-wrc-green-500 transition-colors"
                placeholder="Your full name"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-wrc-green-500 focus:border-wrc-green-500 transition-colors"
                placeholder="your@email.com"
              />
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
              <select
                id="subject"
                name="subject"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-wrc-green-500 focus:border-wrc-green-500 transition-colors"
              >
                <option value="General Inquiry">General Inquiry</option>
                <option value="Registration">Registration</option>
                <option value="Sponsorship">Sponsorship</option>
                <option value="Press & Media">Press & Media</option>
                <option value="Volunteering">Volunteering</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-wrc-green-500 focus:border-wrc-green-500 transition-colors resize-y"
                placeholder="How can we help you?"
              ></textarea>
            </div>
            <Button type="submit" variant="primary" size="lg" id="contact-form-submit">
              Send Message
            </Button>
          </form>
        </div>

        <!-- Contact Info -->
        <div>
          <h2 class="text-2xl font-heading font-bold text-wrc-green-900 mb-6">
            Get in Touch
          </h2>
          <div class="space-y-4 mb-8">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-wrc-green-100 flex items-center justify-center shrink-0">
                <span aria-hidden="true">📧</span>
              </div>
              <div>
                <p class="text-sm text-gray-500">Email</p>
                <a href={`mailto:${CONTACT_EMAIL}`} class="text-wrc-green-700 font-semibold hover:underline">
                  {CONTACT_EMAIL}
                </a>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-wrc-green-100 flex items-center justify-center shrink-0">
                <span aria-hidden="true">📍</span>
              </div>
              <div>
                <p class="text-sm text-gray-500">Venue</p>
                <p class="text-gray-900 font-semibold">{VENUE.name}</p>
                <p class="text-sm text-gray-600">{VENUE.city}, {VENUE.state}, {VENUE.country}</p>
              </div>
            </div>
          </div>

          <!-- Contact Cards -->
          <div class="space-y-4">
            {contactCards.map((card) => (
              <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
                <div class="flex items-start gap-3">
                  <span class="text-2xl" aria-hidden="true">{card.icon}</span>
                  <div>
                    <h3 class="font-heading font-bold text-gray-900 mb-1">{card.title}</h3>
                    <p class="text-sm text-gray-600 mb-2">{card.description}</p>
                    <div class="flex flex-wrap items-center gap-3">
                      <a href={`mailto:${card.email}`} class="text-sm text-wrc-green-700 font-semibold hover:underline">
                        {card.email}
                      </a>
                      {card.prospectusUrl && (
                        <a href={card.prospectusUrl} target="_blank" rel="noopener" class="text-sm text-wrc-green-700 font-semibold hover:underline">
                          Download Prospectus &rarr;
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" />

  <!-- Map -->
  <section class="py-16 relative overflow-hidden bg-white">
    <div class="absolute inset-0 bg-gradient-to-b from-wrc-green-50/40 via-white to-wrc-green-50/30" aria-hidden="true"></div>

    <!-- LEFT SIDE: Tall tropical trees & foliage -->
    <div class="absolute left-0 top-0 bottom-0 w-40 md:w-64 lg:w-80 pointer-events-none" aria-hidden="true">
      <svg class="absolute left-0 top-0 h-full w-full opacity-[0.06]" viewBox="0 0 200 600" preserveAspectRatio="xMinYMin slice" fill="#14532d">
        <rect x="30" y="120" width="18" height="480" rx="4"/>
        <ellipse cx="39" cy="130" rx="55" ry="40"/>
        <ellipse cx="45" cy="90" rx="42" ry="35"/>
        <ellipse cx="35" cy="55" rx="35" ry="30"/>
        <rect x="90" y="200" width="14" height="400" rx="3"/>
        <ellipse cx="97" cy="210" rx="45" ry="35"/>
        <ellipse cx="100" cy="175" rx="35" ry="28"/>
      </svg>
      <svg class="absolute left-2 bottom-8 w-36 md:w-48 opacity-[0.08]" viewBox="0 0 120 100" fill="none" stroke="#14532d" stroke-width="1.2">
        <path d="M30 95 Q28 70 25 50 Q22 30 30 10"/>
        <path d="M26 80 Q18 76 12 80"/><path d="M25 65 Q15 60 10 64"/>
        <path d="M24 50 Q14 45 8 48"/><path d="M23 35 Q16 30 12 33"/>
        <path d="M27 80 Q35 76 40 80"/><path d="M26 65 Q34 60 40 64"/>
        <path d="M25 50 Q34 45 40 48"/><path d="M24 35 Q32 30 36 33"/>
        <path d="M60 95 Q62 65 65 45 Q68 25 60 8"/>
        <path d="M63 75 Q55 72 50 75"/><path d="M64 60 Q55 56 50 59"/>
        <path d="M65 45 Q57 41 52 44"/>
        <path d="M63 75 Q72 72 78 75"/><path d="M64 60 Q74 56 80 59"/>
        <path d="M65 45 Q74 41 80 44"/>
        <path d="M5 92 Q20 85 35 92" fill="#14532d" opacity="0.3"/>
        <path d="M45 95 Q65 86 85 95" fill="#14532d" opacity="0.2"/>
      </svg>
    </div>

    <!-- RIGHT SIDE: Trees & foliage -->
    <div class="absolute right-0 top-0 bottom-0 w-40 md:w-64 lg:w-80 pointer-events-none" aria-hidden="true">
      <svg class="absolute right-0 top-0 h-full w-full opacity-[0.06]" viewBox="0 0 200 600" preserveAspectRatio="xMaxYMin slice" fill="#14532d">
        <rect x="150" y="100" width="16" height="500" rx="4"/>
        <ellipse cx="158" cy="110" rx="50" ry="38"/>
        <ellipse cx="155" cy="72" rx="38" ry="30"/>
        <rect x="80" y="180" width="14" height="420" rx="3"/>
        <ellipse cx="87" cy="190" rx="42" ry="32"/>
        <ellipse cx="90" cy="158" rx="32" ry="26"/>
      </svg>
      <svg class="absolute right-2 bottom-12 w-32 md:w-44 opacity-[0.07] scale-x-[-1]" viewBox="0 0 100 80" fill="none" stroke="#14532d" stroke-width="1.2">
        <path d="M20 75 Q22 55 25 40 Q28 25 22 12"/>
        <path d="M23 60 Q15 56 10 60"/><path d="M24 48 Q15 43 10 46"/>
        <path d="M25 36 Q17 31 12 34"/><path d="M24 24 Q18 20 14 22"/>
        <path d="M24 60 Q32 56 38 60"/><path d="M25 48 Q34 43 40 46"/>
        <path d="M26 36 Q34 31 40 34"/><path d="M25 24 Q32 20 36 22"/>
      </svg>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-8">
        Find Us
      </h2>
      <div class="max-w-4xl mx-auto">
        <MapEmbed
          src={VENUE.mapEmbed}
          title="Congress Venue Location"
          height="400"
        />
      </div>
    </div>
  </section>

  <!-- Countdown + CTAs -->
  <section class="py-16 bg-gradient-to-r from-wrc-green-800 to-wrc-green-900 text-white text-center">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-heading font-bold mb-6">Congress Starts In</h2>
      <CountdownTimer />
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href={`${prefix}/register`} variant="secondary" size="lg">
          Register Now
        </Button>
        <Button href={`${prefix}/submit`} variant="outline" size="lg" class="border-white text-white hover:bg-white/10">
          Submit Interest
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

<script define:vars={{ contactFormSubmitUrl, contactFormEntryIds }}>
  const form = document.getElementById('contact-form');
  const statusEl = document.getElementById('contact-form-status');
  const submitBtn = document.getElementById('contact-form-submit');
  if (form && statusEl && submitBtn) {
    const showStatus = (message, isError) => {
      statusEl.textContent = message;
      statusEl.className = `mb-4 rounded-lg p-4 ${isError ? 'bg-red-50 text-red-800' : 'bg-green-50 text-green-800'}`;
      statusEl.hidden = false;
    };
    const hideStatus = () => {
      statusEl.hidden = true;
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      hideStatus();
      const name = form.querySelector('#name').value.trim();
      const email = form.querySelector('#email').value.trim();
      const subject = form.querySelector('#subject').value.trim();
      const message = form.querySelector('#message').value.trim();
      const params = new URLSearchParams();
      params.append(contactFormEntryIds.name, name);
      params.append(contactFormEntryIds.email, email);
      params.append(contactFormEntryIds.subject, subject);
      params.append(contactFormEntryIds.message, message);
      try {
        await fetch(contactFormSubmitUrl, {
          method: 'POST',
          mode: 'no-cors',
          body: params,
        });
        showStatus('Message sent successfully! We\'ll get back to you soon.', false);
        form.reset();
        setTimeout(hideStatus, 6000);
      } catch (err) {
        showStatus('Something went wrong. Please try again or email us directly.', true);
        setTimeout(hideStatus, 6000);
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>
