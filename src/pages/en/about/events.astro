---
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import SketchDecorations from '../../../components/easter-eggs/SketchDecorations.astro';
import { getLocaleFromUrl, t } from '../../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const fieldTripsData = await import('../../../content/field-trips/en.json');
const fieldTrips = fieldTripsData.trips;
const attractions = fieldTripsData.attractions;

const schedule = [
  { day: 'Friday 18 April', key: 'events.schedule.arrival', accent: 'wrc-green-200' },
  { day: 'Saturday 19 April', key: 'events.schedule.day1', accent: 'wrc-green-300' },
  { day: 'Sunday 20 April', key: 'events.schedule.day2', accent: 'wrc-green-400' },
  { day: 'Monday 21 April', key: 'events.schedule.day3', accent: 'wrc-earth-300' },
  { day: 'Tuesday 22 April', key: 'events.schedule.day4', accent: 'wrc-green-400' },
  { day: 'Wednesday 23 April', key: 'events.schedule.day5', accent: 'wrc-green-500' },
];

const activities = [
  { titleKey: 'about.activities.plenary', descKey: 'about.activities.plenaryDesc', countKey: 'events.activities.plenaryCount', icon: '🎤', color: 'from-wrc-green-600 to-wrc-green-800', image: 'Plenary Talks.jpg' },
  { titleKey: 'about.activities.workshops', descKey: 'about.activities.workshopsDesc', countKey: 'events.activities.workshopsCount', icon: '🔬', color: 'from-wrc-blue-600 to-wrc-blue-800', image: 'Concurrent Workshops.jpg' },
  { titleKey: 'about.activities.discussions', descKey: 'about.activities.discussionsDesc', countKey: 'events.activities.discussionsCount', icon: '💬', color: 'from-wrc-earth-500 to-wrc-earth-700', image: 'Open Discussions.jpg' },
  { titleKey: 'about.activities.cultural', descKey: 'about.activities.culturalDesc', countKey: 'events.activities.culturalCount', icon: '🎭', color: 'from-emerald-600 to-emerald-800', image: 'Cultural Nights.jpg' },
  { titleKey: 'about.activities.fieldTrips', descKey: 'about.activities.fieldTripsDesc', countKey: 'events.activities.fieldTripsCount', icon: '🌿', color: 'from-wrc-green-700 to-wrc-green-900', image: 'Field Trips.jpg' },
];
---

<PageLayout title={t('events.hero.title', locale)} description="Discover the events and activities at the 11th IRF World Ranger Congress — plenary talks, workshops, field trips, cultural nights, and more.">
  <!-- Hero: same banner style as Congress introduction; explicit height so content can center vertically -->
  <section class="relative h-[350px] sm:h-[400px] lg:h-[45vh] xl:h-[50vh] overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <img src="/images/congress-events/Banner.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/20" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/25 to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-0 flex items-center z-10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white leading-tight drop-shadow-lg">
          {t('events.hero.title', locale)}
        </h1>
        <p class="mt-4 text-xl sm:text-2xl text-white/85 font-light max-w-2xl">
          {t('events.hero.subtitle', locale)}
        </p>
      </div>
    </div>
  </section>

  <!-- Program Overview -->
  <section class="py-16 md:py-20 bg-white relative overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-wrc-green-900 mb-4">
        {t('events.overview.title', locale)}
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mb-12">
        {t('events.overview.description', locale)}
      </p>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {schedule.map((item, i) => (
          <div class="relative bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-6 overflow-hidden">
            <div class={`absolute top-0 left-0 w-1 h-full bg-${item.accent}`}></div>
            <p class="text-xs font-heading font-bold text-wrc-green-600 uppercase tracking-wider mb-1">
              {item.day}
            </p>
            <p class="text-sm text-gray-700 leading-relaxed">
              {t(item.key, locale)}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Activities -->
  <section class="py-16 md:py-20 bg-wrc-green-50/50 relative overflow-hidden nature-texture">
    <SketchDecorations variant="waterfall" color="#14532d" />
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-wrc-green-900 text-center mb-4">
        {t('events.activities.title', locale)}
      </h2>
      <p class="text-center text-gray-600 max-w-2xl mx-auto mb-12">
        {t('about.wrc.p3', locale)}
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {activities.map((activity) => (
          <div class="group rounded-xl shadow-md overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative min-h-[200px] aspect-[4/3] sm:aspect-auto sm:min-h-[240px]">
            <img src={`/images/congress-introduction/${encodeURIComponent(activity.image)}`} alt="" class="absolute inset-0 w-full h-full object-cover" />
            <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/85 via-black/50 to-transparent text-white">
              <h3 class="font-heading font-bold text-base text-white mb-1.5">
                {t(activity.titleKey, locale)}
              </h3>
              <p class="text-xs text-white/90 leading-relaxed mb-1.5">
                {t(activity.descKey, locale)}
              </p>
              <p class="text-xs font-heading font-semibold text-white/80">
                {t(activity.countKey, locale)}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Field Trips -->
  <section class="py-16 md:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-wrc-green-900 mb-4 text-center">
        {t('events.fieldTrips.title', locale)}
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto mb-12 text-center">
        {t('events.fieldTrips.description', locale)}
      </p>

      <div class="max-w-md mx-auto">
        {fieldTrips.map((trip) => (
          <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100 hover:shadow-lg transition-shadow">
            <div class="aspect-[16/10] bg-gradient-to-br from-wrc-green-100 to-wrc-blue-100 flex items-center justify-center relative overflow-hidden">
              {trip.image ? (
                <img src={`/images/congress-events/${encodeURIComponent(trip.image)}`} alt="" class="absolute inset-0 w-full h-full object-cover" />
              ) : (
                <span class="text-wrc-green-400 font-heading font-bold text-sm">{trip.name}</span>
              )}
            </div>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-3">
                <span class={`text-xs px-2 py-0.5 rounded-full font-semibold ${trip.country === 'Argentina' ? 'bg-wrc-blue-100 text-wrc-blue-700' : 'bg-wrc-green-100 text-wrc-green-700'}`}>
                  {trip.country}
                </span>
              </div>
              <h3 class="font-heading font-bold text-gray-900 mb-2">{trip.name}</h3>
              <p class="text-sm text-gray-600 leading-relaxed mb-4">{trip.description}</p>
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-500">{t('events.fieldTrips.duration', locale)}: {trip.duration}</span>
                <span class="font-semibold text-wrc-green-700">{t('events.fieldTrips.entryFee', locale)}: USD ${trip.price}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Other Tourist Attractions -->
      <h3 class="text-3xl md:text-4xl font-heading font-bold text-wrc-green-900 mt-20 mb-4">
        {t('events.attractions.title', locale)}
      </h3>
      <p class="text-lg text-gray-600 max-w-3xl mb-12">
        {t('events.attractions.description', locale)}
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {attractions.map((place) => (
          <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100 hover:shadow-lg transition-shadow">
            <div class="aspect-[16/10] bg-gradient-to-br from-wrc-green-100 to-wrc-blue-100 flex items-center justify-center relative overflow-hidden">
              {place.image ? (
                <img src={`/images/congress-events/${encodeURIComponent(place.image)}`} alt="" class="absolute inset-0 w-full h-full object-cover" />
              ) : (
                <span class="text-wrc-green-400 font-heading font-bold text-sm">{place.name}</span>
              )}
            </div>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-3">
                <span class={`text-xs px-2 py-0.5 rounded-full font-semibold ${place.country === 'Argentina' ? 'bg-wrc-blue-100 text-wrc-blue-700' : 'bg-wrc-green-100 text-wrc-green-700'}`}>
                  {place.country}
                </span>
              </div>
              <h3 class="font-heading font-bold text-gray-900 mb-2">{place.name}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{place.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-wrc-green-800 via-wrc-green-900 to-wrc-blue-900 relative overflow-hidden">
    <div class="absolute inset-0 mist-overlay" aria-hidden="true"></div>
    <SketchDecorations variant="waterfall" color="white" />
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-4 drop-shadow-lg">
        {t('events.cta.title', locale)}
      </h2>
      <p class="text-lg text-white/80 max-w-2xl mx-auto mb-8">
        {t('events.cta.description', locale)}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href={`${prefix}/register`} variant="primary" size="lg">
          {t('common.registerNow', locale)}
        </Button>
        <Button href={`${prefix}/program`} variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">
          {t('events.viewProgram', locale)}
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
