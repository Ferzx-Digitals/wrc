---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import SectionDivider from '../../components/global/SectionDivider.astro';
import { getLocaleFromUrl } from '../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const streams = [
  {
    title: 'Inclusive and Representative Workforce',
    description: 'Promoting diversity, equity, and inclusion within the ranger profession. Addressing gender balance, indigenous representation, and ensuring all voices are heard in conservation.',
    icon: '🌍',
    image: 'inclusive-and-representative-workforce.jpg',
  },
  {
    title: 'Welfare and Working Conditions',
    description: 'Improving safety, mental health support, fair compensation, and working environments for rangers worldwide. Addressing the risks and challenges rangers face daily.',
    icon: '🛡️',
    image: 'welfare-and-working-conditions.jpg',
  },
  {
    title: 'Professional Conduct and Ethics',
    description: 'Establishing and maintaining high professional standards, ethical guidelines, and accountability frameworks for ranger operations globally.',
    icon: '⚖️',
    image: 'professional-conduct-and-ethics.jpg',
  },
  {
    title: 'Capacity Building and Training',
    description: 'Developing skills, knowledge, and capabilities through training programs, mentorship, and professional development opportunities for rangers at all levels.',
    icon: '📚',
    image: 'capacity-building-and-training.jpg',
  },
  {
    title: 'Community Engagement and Partnerships',
    description: 'Building strong relationships between rangers, local communities, indigenous peoples, and conservation organizations to create collaborative approaches to protected area management.',
    icon: '🤝',
    image: 'community-engagement-and-partnerships.jpg',
  },
];

const objectives = [
  {
    title: 'Ranger Recognition & 30x30',
    description: 'Enhance recognition of the ranger profession and align with the global 30x30 Framework to protect 30% of the planet by 2030.',
    color: 'from-wrc-green-700 to-wrc-green-800',
    image: 'ranger-recognition.jpg',
  },
  {
    title: 'Ranger Experiences',
    description: 'Showcase ranger experiences, challenges, and contributions from all seven IRF regions worldwide.',
    color: 'from-wrc-blue-700 to-wrc-blue-800',
    image: 'ranger-experiences.jpg',
  },
  {
    title: 'Ranger Solutions',
    description: 'Develop practical solutions for regional and global conservation challenges through collaboration and knowledge sharing.',
    color: 'from-wrc-earth-600 to-wrc-earth-700',
    image: 'ranger-solutions.jpg',
  },
  {
    title: 'Ranger Declaration',
    description: 'Produce the Iguazu Declaration — a landmark statement emphasizing the role of rangers in nature conservation.',
    color: 'from-emerald-700 to-emerald-800',
    image: 'ranger-declaration.jpg',
  },
];

const topics = [
  { title: 'Indigenous Peoples & Rangers', description: 'Bridging traditional knowledge with modern conservation practices.', icon: '🏔️' },
  { title: 'One Health Approach', description: 'Connecting human, animal, and environmental health through ranger work.', icon: '🩺' },
  { title: 'Youth Involvement', description: 'Engaging the next generation in conservation and the ranger profession.', icon: '🌱' },
  { title: 'Technology & Innovation', description: 'Leveraging modern tools for monitoring, enforcement, and communication.', icon: '📡' },
  { title: 'Climate Resilience', description: 'Adapting ranger strategies to address climate change impacts on protected areas.', icon: '🌡️' },
];
---

<PageLayout title="Congress Theme" description="Explore the theme of the 11th IRF World Ranger Congress: Recognising Rangers — Advancing the profession to safeguard our future.">
  <!-- Hero: same banner style as Congress introduction / Events -->
  <section class="relative h-[350px] sm:h-[400px] lg:h-[45vh] xl:h-[50vh] overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <img src="/images/congress-theme/Banner.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/20" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/25 to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-0 flex items-center z-10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white leading-tight drop-shadow-lg">
          Congress Theme
        </h1>
        <p class="mt-4 text-xl sm:text-2xl text-white/85 font-light max-w-2xl">
          Recognising Rangers: Advancing the profession to safeguard our future
        </p>
      </div>
    </div>
  </section>

  <!-- Theme Description -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <div class="bg-wrc-green-50 rounded-2xl p-8 md:p-10 mb-12">
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-wrc-green-900 mb-4">
            "Recognising Rangers: Advancing the profession to safeguard our future"
          </h2>
          <p class="text-gray-600 leading-relaxed">
            The theme of the 11th IRF World Ranger Congress focuses on improving working conditions,
            providing better equipment and training, and empowering rangers to play their vital role
            in biodiversity protection and building a sustainable future. Rangers protect over 15%
            of the Earth's land surface and 8% of our oceans — yet their contributions are often
            undervalued and their needs overlooked.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Thematic Streams - Zigzag layout -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-wrc-green-900 mb-12">
        Thematic Streams
      </h2>
      <div class="space-y-12">
        {streams.map((stream, i) => (
          <div class={`flex flex-col md:flex-row items-center gap-8 ${i % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
            <div class="w-full md:w-1/2">
              <div class="aspect-[16/10] rounded-xl overflow-hidden bg-wrc-green-100">
                <img src={`/images/congress-theme/${stream.image}`} alt="" class="w-full h-full object-cover" />
              </div>
            </div>
            <div class="w-full md:w-1/2">
              <h3 class="text-xl font-heading font-bold text-wrc-green-900 mb-3">{stream.title}</h3>
              <p class="text-gray-600 leading-relaxed">{stream.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" />

  <!-- Congress Objectives -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Congress Objectives
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {objectives.map((obj) => (
          <div class="group relative rounded-xl overflow-hidden min-h-[200px] flex flex-col justify-end cursor-pointer transition-all duration-300 hover:shadow-xl hover:scale-[1.02]">
            <img src={`/images/congress-theme/${obj.image}`} alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true" />
            <div class={`absolute inset-0 bg-gradient-to-br ${obj.color} opacity-75`} aria-hidden="true"></div>
            <div class="relative z-10 p-6">
              <h3 class="font-heading font-bold text-lg text-white mb-2">{obj.title}</h3>
              <p class="text-sm text-white/80 leading-relaxed opacity-0 group-hover:opacity-100 transition-opacity duration-300 max-h-0 group-hover:max-h-40 overflow-hidden">
                {obj.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- WRC Topics Grid -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Discussion Topics
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {topics.map((topic) => (
          <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <span class="text-3xl mb-3 block" aria-hidden="true">{topic.icon}</span>
            <h3 class="font-heading font-bold text-lg text-gray-900 mb-2">{topic.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{topic.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Submit CTA -->
  <section class="py-16 bg-gradient-to-r from-wrc-green-800 to-wrc-green-900 text-white text-center">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold mb-4">Share Your Experience</h2>
      <p class="text-lg text-white/80 mb-8">
        Submit an expression of interest to present at the 11th IRF World Ranger Congress.
      </p>
      <Button href={`${prefix}/submit`} variant="secondary" size="lg">
        Submit Expression of Interest
      </Button>
    </div>
  </section>
</PageLayout>
