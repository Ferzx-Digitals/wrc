---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import SectionDivider from '../../components/global/SectionDivider.astro';
import CountdownTimer from '../../components/global/CountdownTimer.astro';
import SketchDecorations from '../../components/easter-eggs/SketchDecorations.astro';
import { REGISTRATION_FEE_USD, MAX_CAPACITY, REGION_CAP, HOST_REGION_CAP, CONTACT_EMAIL } from '../../utils/constants';

const registrationIncludes = [
  'Full congress access (5 days)',
  'Welcome pack and materials',
  'Simultaneous translations at plenary sessions',
  'Coffee, tea, and lunch during congress days',
  'Field trip participation',
  'Cultural night events',
  'Certificate of Participation',
];

const cancellationPolicy = [
  { period: 'Up to 6 months before (October 2026)', refund: '80% refund', color: 'text-green-700 bg-green-50' },
  { period: 'Up to 4 months before (December 2026)', refund: '50% refund', color: 'text-yellow-700 bg-yellow-50' },
  { period: 'Within 2 months (February 2027+)', refund: 'No refund', color: 'text-red-700 bg-red-50' },
];

const paymentMethods = [
  {
    title: 'Argentine Delegates',
    method: 'Mercado Pago',
    currency: 'ARS (Argentine Peso)',
    icon: '🇦🇷',
    note: 'Bank transfer also accepted for Argentine and South American delegates',
  },
  {
    title: 'International Delegates',
    method: 'PayPal',
    currency: 'USD (US Dollar)',
    icon: '🌍',
    note: 'We advise avoiding American Express and Mastercard due to high international fees',
  },
];
---

<PageLayout title="Register" description="Register for the 11th IRF World Ranger Congress. $395 USD per person. Registration open from February 2026 to March 2027.">
  <!-- Hero -->
  <section class="relative h-[350px] sm:h-[400px] bg-gradient-to-r from-wrc-green-900/90 to-wrc-earth-700/70">
    <div class="absolute inset-0 opacity-10">
      <div class="w-full h-full bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2040%2040%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M20%2020.5V18H0v-2h20v-2l-3-3%203-3v-2H0V4h20V1.5L23.5%205%2020%208.5z%22%20fill%3D%22%23fff%22%20fill-opacity%3D%220.2%22%20fill-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E')]"></div>
    </div>
    <div class="relative h-full flex items-center">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white">
          Register Now
        </h1>
        <p class="mt-4 text-xl text-white/80 max-w-2xl">
          Secure your place at the 11th IRF World Ranger Congress
        </p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-16 relative overflow-hidden nature-texture bg-gradient-to-b from-wrc-green-50/30 via-wrc-green-50/50 to-gray-50">
    <SketchDecorations variant="tropical" color="#166534" />
    <img src="/images/home/10.png" alt="" aria-hidden="true" class="absolute left-0 top-0 h-72 w-auto opacity-50 pointer-events-none -scale-x-100" />
    <img src="/images/home/14.png" alt="" aria-hidden="true" class="absolute right-0 bottom-0 h-[48rem] w-auto opacity-40 pointer-events-none" />
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-lg mx-auto text-center">
        <div class="bg-white rounded-2xl shadow-xl p-8 border-2 border-wrc-green-200">
          <p class="text-sm text-wrc-green-700 font-semibold uppercase tracking-wide mb-2">Congress Registration</p>
          <div class="mb-4">
            <span class="text-5xl font-heading font-extrabold text-gray-900">${REGISTRATION_FEE_USD}</span>
            <span class="text-gray-500 text-lg ml-1">USD</span>
          </div>
          <p class="text-gray-600 text-sm mb-6">
            Single standard fee for all participants — ensuring fairness and equality
          </p>
          <ul class="text-left space-y-2 mb-8">
            {registrationIncludes.map((item) => (
              <li class="flex items-start gap-3 text-sm">
                <svg class="w-5 h-5 text-wrc-green-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
          <p class="text-xs text-gray-500 mb-6">
            Registration period: 20 February 2026 — 31 March 2027
          </p>
          <!-- EXTERNAL_REGISTER_BUTTON 1/6 - uncomment when registration portal is live -->
          <!--
          <Button href="https://intercloudy.contilatam.com/2269/world-ranger-congress" target="_blank" rel="noopener" variant="primary" size="lg" class="w-full">
            Register Now
          </Button>
          -->
          <button type="button" disabled class="inline-flex items-center justify-center font-heading font-semibold rounded-lg px-8 py-4 text-lg w-full bg-wrc-green-700 text-white opacity-75 cursor-not-allowed">
            Coming Soon...
          </button>
        </div>
      </div>
    </div>
  </section>


  <!-- Payment Methods -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Payment Methods
      </h2>
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {paymentMethods.map((pm) => (
          <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100">
            <span class="text-3xl mb-3 block" aria-hidden="true">{pm.icon}</span>
            <h3 class="font-heading font-bold text-xl text-gray-900 mb-1">{pm.title}</h3>
            <p class="text-wrc-green-700 font-semibold mb-2">{pm.method} ({pm.currency})</p>
            <p class="text-sm text-gray-600">{pm.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" class="bg-gray-50" />

  <!-- Registration Rules -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Important Information
      </h2>
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="bg-wrc-green-50 rounded-xl p-6">
          <h3 class="font-heading font-bold text-wrc-green-900 mb-3">Capacity</h3>
          <ul class="space-y-2 text-sm text-gray-700">
            <li>Maximum {MAX_CAPACITY} attendees total</li>
            <li>{REGION_CAP} delegates per IRF region</li>
            <li>{HOST_REGION_CAP} for host region (Argentina)</li>
          </ul>
        </div>
        <div class="bg-wrc-blue-50 rounded-xl p-6">
          <h3 class="font-heading font-bold text-wrc-blue-900 mb-3">Rules</h3>
          <ul class="space-y-2 text-sm text-gray-700">
            <li>Registration is individual and personal</li>
            <li>Non-transferable to another person</li>
            <li>No group registrations</li>
          </ul>
        </div>
        <div class="bg-wrc-earth-50 rounded-xl p-6">
          <h3 class="font-heading font-bold text-wrc-earth-900 mb-3">Spouses & Partners</h3>
          <ul class="space-y-2 text-sm text-gray-700">
            <li>Welcome to attend the congress</li>
            <li>Same ${REGISTRATION_FEE_USD} registration fee</li>
            <li>Takes a registration spot</li>
            <li>Can book accommodation together</li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- Cancellation Policy -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Cancellation Policy
      </h2>
      <div class="space-y-4">
        {cancellationPolicy.map((tier) => (
          <div class={`rounded-xl p-5 ${tier.color}`}>
            <div class="flex items-center justify-between">
              <span class="font-medium">{tier.period}</span>
              <span class="font-heading font-bold">{tier.refund}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" />

  <!-- Register & Pay Online -->
  <section id="registration-form" class="py-16 relative overflow-hidden">
    <img src="/images/home/10.png" alt="" aria-hidden="true" class="absolute right-0 top-0 h-72 w-auto opacity-50 pointer-events-none" />
    <img src="/images/home/10.png" alt="" aria-hidden="true" class="absolute left-0 bottom-0 h-72 w-auto opacity-50 pointer-events-none -scale-x-100" />
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="bg-white rounded-2xl shadow-lg p-8 md:p-12 border border-gray-100 text-center">
        <h2 class="text-3xl font-heading font-bold text-wrc-green-900 mb-4">
          Register & Pay Online
        </h2>
        <p class="text-gray-600 mb-8 max-w-xl mx-auto">
          Registration and payment are handled through our official registration platform.
          Click the button below to fill out the registration form and complete your payment.
        </p>
        <!-- EXTERNAL_REGISTER_BUTTON 2/6 - uncomment when registration portal is live -->
        <!--
        <Button href="https://intercloudy.contilatam.com/2269/world-ranger-congress" target="_blank" rel="noopener" variant="primary" size="lg">
          Go to Registration Portal
        </Button>
        -->
        <button type="button" disabled class="inline-flex items-center justify-center font-heading font-semibold rounded-lg px-8 py-4 text-lg bg-wrc-green-700 text-white opacity-75 cursor-not-allowed">
          Coming Soon...
        </button>
        <p class="text-sm text-gray-500 mt-6">
          Questions? Contact{' '}
          <a href={`mailto:${CONTACT_EMAIL}`} class="text-wrc-green-700 underline">{CONTACT_EMAIL}</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Countdown -->
  <section class="py-16 bg-gradient-to-r from-wrc-green-800 to-wrc-green-900 text-white text-center">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-heading font-bold mb-6">Congress Starts In</h2>
      <CountdownTimer />
      <p class="mt-6 text-white/70 text-sm">
        Don't wait — spaces are limited to {MAX_CAPACITY} delegates
      </p>
    </div>
  </section>
</PageLayout>
