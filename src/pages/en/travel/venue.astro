---
import PageLayout from '../../../layouts/PageLayout.astro';
import MapEmbed from '../../../components/ui/MapEmbed.astro';
import SectionDivider from '../../../components/global/SectionDivider.astro';
import { VENUE, HOTEL } from '../../../utils/constants';
import { getLocaleFromUrl } from '../../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const accommodationIncludes = [
  'Hotel room (18-24 April 2027)',
  'Breakfast daily',
  'Dinner daily',
  'Evening function access',
  'Transport to and from airport',
  'Welcome pack',
  'Full congress access',
  'Simultaneous translations at plenaries',
  'Coffee and tea service',
  'Lunch during congress days',
  'Field trips',
];

const hotelFeatures = [
  { label: '5-Star Rating', icon: '⭐' },
  { label: '117 Rooms', icon: '🏨' },
  { label: '2 Restaurants', icon: '🍽️' },
  { label: '2 Bars', icon: '🍸' },
  { label: 'Spa & Wellness', icon: '💆' },
  { label: 'Triple Frontier Views', icon: '🌅' },
];
---

<PageLayout title="Venue & Accommodation" description="Learn about the congress venue Centro de Eventos y Convenciones del Iguazu and Hotel Amerian Portal del Iguazu.">
  <!-- Hero -->
  <section class="relative h-[350px] sm:h-[400px] bg-gradient-to-r from-wrc-blue-700/90 to-wrc-green-800/70">
    <div class="absolute inset-0 opacity-10">
      <div class="w-full h-full bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2040%2040%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M20%2020.5V18H0v-2h20v-2l-3-3%203-3v-2H0V4h20V1.5L23.5%205%2020%208.5z%22%20fill%3D%22%23fff%22%20fill-opacity%3D%220.2%22%20fill-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E')]"></div>
    </div>
    <div class="relative h-full flex items-center">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white">
          Venue & Accommodation
        </h1>
        <p class="mt-4 text-xl text-white/80 max-w-2xl">
          World-class facilities at the heart of the Triple Frontier
        </p>
      </div>
    </div>
  </section>

  <!-- Navigation Tabs -->
  <nav class="bg-white border-b border-gray-200 sticky top-16 z-30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex gap-1 overflow-x-auto">
        <a href={`${prefix}/travel`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          Logistics
        </a>
        <a href={`${prefix}/travel/venue`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-wrc-green-700 text-wrc-green-700 whitespace-nowrap">
          Venue & Accommodation
        </a>
        <a href={`${prefix}/travel/faqs`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          Travel FAQs
        </a>
      </div>
    </div>
  </nav>

  <!-- Venue Section -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 items-start">
        <div>
          <h2 class="text-3xl font-heading font-bold text-wrc-green-900 mb-4">
            Congress Venue
          </h2>
          <h3 class="text-xl font-heading font-semibold text-wrc-green-700 mb-4">
            {VENUE.name}
          </h3>
          <div class="space-y-4 text-gray-600 leading-relaxed">
            <p>
              The congress will be held at the Centro de Eventos y Convenciones del Iguazu,
              a modern convention center located in Puerto Iguazu, Misiones, Argentina.
              The venue provides state-of-the-art facilities for plenary sessions, workshops,
              and cultural events.
            </p>
            <p>
              Situated near the stunning Iguazu Falls and the Atlantic Forest, the venue
              offers a unique setting that connects delegates with the natural world they
              work to protect.
            </p>
          </div>
        </div>
        <MapEmbed
          src={VENUE.mapEmbed}
          title="Congress Venue - Centro de Eventos y Convenciones del Iguazu"
          height="350"
        />
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" />

  <!-- Hotel Section -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-4">
        Official Accommodation
      </h2>
      <p class="text-center text-gray-600 mb-10 max-w-2xl mx-auto">
        Congress delegates will stay at the {HOTEL.name}
      </p>

      <!-- Hotel Info Card -->
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden max-w-4xl mx-auto mb-12">
        <div class="grid md:grid-cols-2">
          <!-- Photo Placeholder -->
          <div class="aspect-[4/3] md:aspect-auto bg-gradient-to-br from-wrc-blue-100 to-wrc-green-100 flex items-center justify-center">
            <span class="text-wrc-green-400 font-heading font-bold">Hotel Photo</span>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-heading font-bold text-gray-900 mb-2">{HOTEL.name}</h3>
            <p class="text-wrc-green-700 font-semibold mb-4">{'⭐'.repeat(HOTEL.stars)} {HOTEL.stars}-Star Hotel</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              {HOTEL.address}
            </p>
            <div class="grid grid-cols-2 gap-3">
              {hotelFeatures.map((feature) => (
                <div class="flex items-center gap-2 text-sm">
                  <span aria-hidden="true">{feature.icon}</span>
                  <span class="text-gray-700">{feature.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Additional Hotels Notice -->
      <div class="bg-wrc-earth-50 rounded-xl p-6 border border-wrc-earth-200 max-w-4xl mx-auto">
        <p class="text-wrc-earth-800 text-sm text-center">
          <strong>Note:</strong> Two additional hotel options are being arranged and will be announced soon.
          Check back for updates on alternative accommodation.
        </p>
      </div>
    </div>
  </section>


  <!-- Accommodation Package -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        What's Included
      </h2>
      <div class="max-w-2xl mx-auto">
        <div class="bg-wrc-green-50 rounded-2xl p-8">
          <ul class="space-y-3">
            {accommodationIncludes.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-wrc-green-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <p class="text-center text-gray-500 text-sm mt-6">
          Dates: 18-24 April 2027 (check-in 18 April, check-out 24 April)
        </p>
      </div>
    </div>
  </section>
</PageLayout>
