---
import PageLayout from '../../../layouts/PageLayout.astro';
import Button from '../../../components/ui/Button.astro';
import MapEmbed from '../../../components/ui/MapEmbed.astro';
import SectionDivider from '../../../components/global/SectionDivider.astro';
import { VENUE } from '../../../utils/constants';
import { getLocaleFromUrl } from '../../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const prefix = `/${locale}`;

const featuredHotels = [
  {
    name: 'Hotel Amerian Portal del Iguazu',
    stars: 5,
    rooms: 117,
    address: 'Av. Tres Fronteras 780, Puerto Iguazu',
    features: ['2 Restaurants', '2 Bars', 'Spa & Wellness', 'Triple Frontier Views', 'Congress Venue Hotel'],
    mapUrl: 'https://maps.app.goo.gl/6RD7UotVJshHRrfr8',
  },
  {
    name: 'Iguazu Grand Resort Spa & Casino',
    stars: 5,
    rooms: 122,
    address: 'Ruta 12 Km 1640, Puerto Iguazu',
    features: ['Casino', 'Full Spa', 'Pool & Gardens', 'Golf Course', 'River Views'],
    mapUrl: 'https://maps.app.goo.gl/iguazugrand',
  },
  {
    name: 'Loi Suites Iguazu Hotel',
    stars: 5,
    rooms: 162,
    address: 'Selva Iryapu S/N, Puerto Iguazu',
    features: ['Rainforest Setting', 'Infinity Pool', 'Spa', 'Nature Trails', 'Eco-Luxury'],
    mapUrl: 'https://maps.app.goo.gl/loisuites',
  },
];

const additionalHotels = [
  { name: 'Mercure Iguazu Hotel Iru', stars: 5, rooms: 134, location: 'Ruta 12, Puerto Iguazu' },
  { name: 'Panoramic Grand Iguazu', stars: 4, rooms: 97, location: 'Paraguay 372, Puerto Iguazu' },
  { name: 'Saint George Hotel', stars: 3, rooms: 60, location: 'Av. Cordoba 148, Puerto Iguazu' },
  { name: 'Hotel Jardin de Iguazu', stars: 3, rooms: 60, location: 'Av. Cordoba 441, Puerto Iguazu' },
  { name: 'Jasy Hotel', stars: 2, rooms: 39, location: 'San Lorenzo 154, Puerto Iguazu' },
];

const basicPackageItems = [
  'Iguazu Falls — Argentine Side',
  'Hito Tres Fronteras (Triple Frontier Landmark)',
  'Puerto Iguazu City Tour',
  'Aripuca Park Visit',
];

const paidTours = [
  { name: 'Iguazu Falls — Brazilian Side', price: 45, description: 'Full-day excursion to the Brazilian side of the falls with panoramic views.' },
  { name: 'Bird Park (Parque das Aves)', price: 20, description: 'Walk-through aviary with over 1,400 birds of 150 species.' },
  { name: 'Iguazu Falls + Bird Park Combo', price: 55, description: 'Combined visit to Brazilian falls and Bird Park in one day.' },
  { name: 'Itaipu Dam', price: 45, description: 'Visit the world\'s largest hydroelectric dam on the Brazil-Paraguay border.' },
  { name: 'Moonlight Walk — Iguazu Falls', price: 50, description: 'Guided night walk to see the falls illuminated by moonlight.' },
  { name: 'Wanda Mines', price: 35, description: 'Semi-precious gemstone mines with guided underground tours.' },
];

const taxInfo = [
  {
    title: 'VAT Refund for Tourists',
    description: 'Foreign tourists staying at registered hotels in Argentina can request a VAT (IVA) refund of 21% on accommodation. Ask for the refund form at hotel checkout and process it at the airport before departure.',
    icon: '🧾',
  },
  {
    title: 'Reciprocity Fee',
    description: 'Citizens of certain countries (e.g. Australia, Canada) may need to pay a reciprocity fee before traveling to Argentina. Check the Argentine immigration website for current requirements applicable to your nationality.',
    icon: '📋',
  },
];

const bookingContacts = [
  {
    name: 'Full Service EVT (Official Travel Agency)',
    email: 'fullserviceevt@gmail.com',
    phone: '+54 3757 423721',
    description: 'Official congress travel agency for hotel bookings, tour packages, and transfers.',
  },
  {
    name: 'IRF Congress Office',
    email: 'wrc@internationalrangers.org',
    phone: '',
    description: 'General congress inquiries and registration support.',
  },
];
---

<PageLayout title="Venue & Accommodation" description="Congress venue, hotel options, tour packages, and practical travel information for the 11th World Ranger Congress in Puerto Iguazu.">
  <!-- Hero -->
  <section class="relative h-[350px] sm:h-[400px]">
    <img src="/images/titles/venue.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative h-full flex items-center">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-extrabold text-white">
          Venue & Accommodation
        </h1>
        <p class="mt-4 text-xl text-white/80 max-w-2xl">
          World-class facilities at the heart of the Triple Frontier
        </p>
      </div>
    </div>
  </section>

  <!-- Navigation Tabs -->
  <nav class="bg-white border-b border-gray-200 sticky top-16 z-30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex justify-center gap-1 overflow-x-auto">
        <a href={`${prefix}/travel`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          Logistics
        </a>
        <a href={`${prefix}/travel/venue`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-wrc-green-700 text-wrc-green-700 whitespace-nowrap">
          Venue & Accommodation
        </a>
        <a href={`${prefix}/travel/faqs`} class="px-4 py-3 text-sm font-heading font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap">
          Travel FAQs
        </a>
      </div>
    </div>
  </nav>

  <!-- Venue Section -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 items-start">
        <div>
          <h2 class="text-3xl font-heading font-bold text-wrc-green-900 mb-4">
            Congress Venue
          </h2>
          <h3 class="text-xl font-heading font-semibold text-wrc-green-700 mb-4">
            {VENUE.name}
          </h3>
          <div class="space-y-4 text-gray-600 leading-relaxed">
            <p>
              The congress will be held at the Centro de Eventos y Convenciones del Iguazu,
              a modern convention center located in Puerto Iguazu, Misiones, Argentina.
              The venue provides state-of-the-art facilities for plenary sessions, workshops,
              and cultural events.
            </p>
            <p>
              Situated near the stunning Iguazu Falls and the Atlantic Forest, the venue
              offers a unique setting that connects delegates with the natural world they
              work to protect.
            </p>
          </div>
        </div>
        <MapEmbed
          src={VENUE.mapEmbed}
          title="Congress Venue - Centro de Eventos y Convenciones del Iguazu"
          height="350"
        />
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" />

  <!-- Featured Hotels -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-4">
        Featured Hotels
      </h2>
      <p class="text-center text-gray-600 mb-10 max-w-2xl mx-auto">
        Premium accommodation options near the congress venue
      </p>
      <div class="grid md:grid-cols-3 gap-6">
        {featuredHotels.map((hotel) => (
          <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6 flex flex-col">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-heading font-bold text-lg text-gray-900">{hotel.name}</h3>
            </div>
            <p class="text-wrc-green-700 font-semibold text-sm mb-1">
              {'⭐'.repeat(hotel.stars)} {hotel.stars}-Star
            </p>
            <p class="text-sm text-gray-500 mb-4">{hotel.rooms} rooms · {hotel.address}</p>
            <ul class="space-y-1.5 mb-5 flex-1">
              {hotel.features.map((f) => (
                <li class="flex items-center gap-2 text-sm text-gray-600">
                  <svg class="w-4 h-4 text-wrc-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            <Button href={hotel.mapUrl} variant="outline" size="sm">
              View on Map &rarr;
            </Button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Additional Hotels -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/10.png" alt="" aria-hidden="true" class="absolute right-0 top-0 h-60 w-auto opacity-50 pointer-events-none" />
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Additional Hotel Options
      </h2>
      <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
        <table class="w-full">
          <thead>
            <tr class="bg-wrc-green-50">
              <th class="px-6 py-3 text-left text-sm font-heading font-bold text-wrc-green-900">Hotel</th>
              <th class="px-4 py-3 text-center text-sm font-heading font-bold text-wrc-green-900">Stars</th>
              <th class="px-4 py-3 text-center text-sm font-heading font-bold text-wrc-green-900">Rooms</th>
              <th class="px-6 py-3 text-left text-sm font-heading font-bold text-wrc-green-900 hidden sm:table-cell">Location</th>
            </tr>
          </thead>
          <tbody>
            {additionalHotels.map((hotel, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-6 py-3 text-sm font-semibold text-gray-700">{hotel.name}</td>
                <td class="px-4 py-3 text-sm text-center text-gray-600">{'⭐'.repeat(hotel.stars)}</td>
                <td class="px-4 py-3 text-sm text-center text-gray-600">{hotel.rooms}</td>
                <td class="px-6 py-3 text-sm text-gray-500 hidden sm:table-cell">{hotel.location}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <SectionDivider variant="jungle" />

  <!-- Tour Packages -->
  <section class="relative py-16 bg-gray-50 overflow-hidden">
    <img src="/images/home/25.png" alt="" aria-hidden="true" class="absolute left-0 top-1/3 -translate-y-1/2 h-64 w-auto opacity-30 pointer-events-none" />
    <img src="/images/home/14.png" alt="" aria-hidden="true" class="absolute right-0 bottom-0 h-96 w-auto opacity-50 pointer-events-none" style="transform: scaleY(1.3) scale(1.1);" />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-4">
        Tour Packages
      </h2>
      <p class="text-center text-gray-600 mb-10 max-w-2xl mx-auto">
        Explore Iguazu and surroundings with organized excursions
      </p>

      <!-- Basic Package (Included) -->
      <div class="bg-wrc-green-50 rounded-2xl p-8 border border-wrc-green-200 max-w-3xl mx-auto mb-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="bg-wrc-green-700 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">Included</span>
          <h3 class="font-heading font-bold text-xl text-wrc-green-900">Basic Tour Package</h3>
        </div>
        <p class="text-gray-600 text-sm mb-4">The following excursions are included in your congress registration:</p>
        <ul class="grid sm:grid-cols-2 gap-3">
          {basicPackageItems.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-wrc-green-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-700 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Paid Tours -->
      <h3 class="font-heading font-bold text-xl text-center text-wrc-green-900 mb-6">
        Optional Tours (Additional Cost)
      </h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
        {paidTours.map((tour) => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 relative">
            <span class="absolute top-4 right-4 bg-wrc-earth-100 text-wrc-earth-800 text-xs font-bold px-2 py-1 rounded-full">
              USD ${tour.price}
            </span>
            <h4 class="font-heading font-bold text-gray-900 mb-2 pr-16">{tour.name}</h4>
            <p class="text-sm text-gray-600 leading-relaxed">{tour.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Transfers -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/23.png" alt="" aria-hidden="true" class="absolute -right-20 bottom-4 h-48 w-auto opacity-30 pointer-events-none" />
    <img src="/images/home/24.png" alt="" aria-hidden="true" class="absolute top-4 h-72 w-auto opacity-30 pointer-events-none -scale-x-100" style="left: 3.75rem;" />
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Transfers
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="bg-wrc-green-50 rounded-xl p-6 border border-wrc-green-200 text-center">
          <span class="text-2xl block mb-2" aria-hidden="true">✈️</span>
          <h3 class="font-heading font-bold text-wrc-green-900 mb-2">Airport Transfers</h3>
          <p class="text-sm text-gray-600">Included in your congress registration. Shuttle service between Cataratas del Iguazu Airport (IGR) and congress hotels.</p>
        </div>
        <div class="bg-wrc-blue-50 rounded-xl p-6 border border-wrc-blue-200 text-center">
          <span class="text-2xl block mb-2" aria-hidden="true">🚐</span>
          <h3 class="font-heading font-bold text-wrc-blue-900 mb-2">Brazilian Side Transfers</h3>
          <p class="text-sm text-gray-600">Transfer to Brazilian side of the falls: <strong>USD $25/person</strong> (minimum 10 passengers).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tax Information -->
  <section class="py-16 bg-gray-50">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Tax Information
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {taxInfo.map((info) => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <span class="text-2xl block mb-2" aria-hidden="true">{info.icon}</span>
            <h3 class="font-heading font-bold text-gray-900 mb-2">{info.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{info.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Booking Contacts -->
  <section class="relative py-16 overflow-hidden">
    <img src="/images/home/26.png" alt="" aria-hidden="true" class="absolute right-0 bottom-0 h-60 w-auto opacity-50 pointer-events-none" />
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center text-wrc-green-900 mb-10">
        Booking & Contact
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {bookingContacts.map((contact) => (
          <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6 text-center">
            <h3 class="font-heading font-bold text-gray-900 mb-2">{contact.name}</h3>
            <p class="text-sm text-gray-600 mb-4">{contact.description}</p>
            <div class="space-y-1">
              <a href={`mailto:${contact.email}`} class="block text-sm text-wrc-green-700 font-semibold hover:underline">
                {contact.email}
              </a>
              {contact.phone && (
                <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="block text-sm text-gray-600 font-mono">
                  {contact.phone}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
